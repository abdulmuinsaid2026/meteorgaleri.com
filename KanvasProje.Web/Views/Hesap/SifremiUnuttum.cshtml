@{
    ViewData["Title"] = "Şifremi Unuttum";
    var eposta = ViewBag.Eposta as string ?? string.Empty;
    var basariMesaji = TempData.Peek("Basari") ?? ViewBag.Mesaj;
}

<div class="min-h-[80vh] flex items-center justify-center py-16 px-4 bg-[#F8FAFC]">
    <div class="w-full max-w-md">
        <div class="text-center mb-8">
            <a href="/" class="inline-block">
                <img src="/meteorgaleri-logo.png" alt="Meteor Galeri" class="h-10 md:h-12 mx-auto object-contain" />
            </a>
            <p class="text-xs text-slate-500 mt-3 font-medium">E-posta adresinizi girin, sıfırlama bağlantısı gönderelim</p>
        </div>

        @if (basariMesaji != null)
        {
            <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm px-4 py-3 rounded-xl mb-6 flex items-start gap-2">
                <i class="fas fa-check-circle mt-0.5 text-emerald-600"></i>
                <span>@basariMesaji</span>
            </div>
        }
        @if (ViewBag.Hata != null)
        {
            <div class="bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded-xl mb-6 flex items-start gap-2">
                <i class="fas fa-circle-exclamation mt-0.5 text-red-600"></i>
                <span>@ViewBag.Hata</span>
            </div>
        }

        <div class="bg-white border border-slate-200/80 rounded-2xl p-6 sm:p-8 shadow-sm">
            <h1 class="font-heading text-xl font-bold text-slate-900 mb-6 text-center">Şifremi Unuttum</h1>
            <form asp-action="SifremiUnuttum" method="post" class="space-y-5" data-auth-mail-form>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 tracking-wider mb-2 uppercase">Kayıtlı E-posta</label>
                    <input name="eposta" type="email" value="@eposta" placeholder="ornek@mail.com" required
                           class="w-full border border-slate-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-[#00A4D3] focus:border-[#00A4D3] outline-none bg-white transition-all text-slate-800" />
                </div>
                <button type="submit"
                        class="w-full bg-[#00A4D3] text-white py-3.5 text-xs font-bold tracking-wider uppercase rounded-xl hover:bg-[#0284C7] transition-all shadow-md shadow-sky-500/20 flex items-center justify-center gap-2"
                        data-auth-mail-button>
                    <i class="fas fa-envelope"></i>
                    <span>Bağlantı Gönder</span>
                </button>
            </form>
            <div class="mt-6 text-center">
                <a href="/Hesap/GirisYap" class="text-xs font-semibold text-[#00A4D3] hover:text-[#0284C7] transition-colors tracking-wide flex items-center justify-center gap-1.5">
                    <i class="fas fa-arrow-left text-[10px]"></i> Giriş Ekranına Dön
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('[data-auth-mail-form]').forEach(function(form) {
            form.addEventListener('submit', function() {
                const button = form.querySelector('[data-auth-mail-button]');
                if (!button) return;

                button.disabled = true;
                button.classList.add('opacity-80', 'cursor-wait');
                button.innerHTML = '<i class="fas fa-spinner fa-spin"></i><span>Gönderiliyor...</span>';
            });
        });
    </script>
}
