@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@model string
@{
    var eylem = string.IsNullOrWhiteSpace(Model) ? "Giriş" : Model;
    var googleAktif = !string.IsNullOrWhiteSpace(Configuration["Authentication:Google:ClientId"])
        && !string.IsNullOrWhiteSpace(Configuration["Authentication:Google:ClientSecret"]);
    var facebookAktif = !string.IsNullOrWhiteSpace(Configuration["Authentication:Facebook:AppId"])
        && !string.IsNullOrWhiteSpace(Configuration["Authentication:Facebook:AppSecret"]);
    if (!googleAktif && !facebookAktif)
    {
        return;
    }
    var gridSinifi = googleAktif && facebookAktif ? "sm:grid-cols-2" : "grid-cols-1";
}

<div class="mt-6">
    <div class="relative mb-6">
        <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-slate-200"></div>
        </div>
        <div class="relative flex justify-center">
            <span class="bg-[#F8FAFC] px-4 text-xs text-slate-400 uppercase tracking-widest font-semibold">veya</span>
        </div>
    </div>
    <div class="grid grid-cols-1 @gridSinifi gap-3">
        @if (googleAktif)
        {
            <form asp-action="ExternalLogin" asp-controller="Hesap" method="post" class="block">
                @Html.AntiForgeryToken()
                <input type="hidden" name="provider" value="Google" />
                <button type="submit" class="w-full h-11 border border-slate-300 rounded-xl text-sm text-slate-700 hover:bg-slate-50 hover:border-slate-400 transition-colors flex items-center justify-center gap-2.5 bg-white font-semibold shadow-sm active:scale-[0.98]">
                    <svg class="w-[18px] h-[18px] shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                        <path fill="#FBBC05" d="M5.84 14.1c-.22-.66-.35-1.36-.35-2.1s.13-1.44.35-2.1V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l3.66-2.84z" />
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
                    </svg>
                    <span>Google ile @eylem</span>
                </button>
            </form>
        }
        @if (facebookAktif)
        {
            <form asp-action="ExternalLogin" asp-controller="Hesap" method="post" class="block">
                @Html.AntiForgeryToken()
                <input type="hidden" name="provider" value="Facebook" />
                <button type="submit" class="w-full h-11 border border-transparent rounded-xl text-sm text-white bg-[#1877F2] hover:bg-[#1463cc] transition-colors flex items-center justify-center gap-2.5 font-semibold shadow-sm active:scale-[0.98]">
                    <svg class="w-[18px] h-[18px] shrink-0" viewBox="0 0 24 24" fill="#fff" aria-hidden="true">
                        <path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.09 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.49h-2.8V24C19.62 23.1 24 18.1 24 12.07z" />
                    </svg>
                    <span>Facebook ile @eylem</span>
                </button>
            </form>
        }
    </div>
</div>
