@{
    ViewData["Title"] = "E-posta Onayı Gerekli";
    var hata = TempData.Peek("Hata");
    var basari = TempData.Peek("Basari");
}

<div class="min-h-[80vh] flex items-center justify-center py-16 px-4 bg-[#F8FAFC]">
    <div class="w-full max-w-lg text-center bg-white border border-slate-200/80 rounded-2xl p-8 sm:p-10 shadow-sm">
        <a href="/" class="inline-block mb-6">
            <img src="/meteorgaleri-logo.png" alt="Meteor Galeri" class="h-10 md:h-12 mx-auto object-contain" />
        </a>
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-full @(hata == null ? "bg-sky-50 text-[#00A4D3]" : "bg-red-50 text-red-600") mb-6">
            <i class="fas @(hata == null ? "fa-envelope-open-text" : "fa-triangle-exclamation") text-3xl"></i>
        </div>

        <h1 class="font-heading text-2xl sm:text-3xl font-extrabold text-slate-900 mb-4">E-Posta Onayı</h1>

        @if (basari != null)
        {
            <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm px-4 py-3 rounded-xl mb-6 text-left flex items-start gap-2">
                <i class="fas fa-check-circle mt-0.5 text-emerald-600"></i>
                <span>@basari</span>
            </div>
        }

        @if (hata != null)
        {
            <div class="bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded-xl mb-6 text-left flex items-start gap-2">
                <i class="fas fa-circle-exclamation mt-0.5 text-red-600"></i>
                <span>@hata</span>
            </div>
            <p class="text-sm text-slate-600 mb-8 leading-relaxed">
                Hesabınız oluşturuldu. E-posta gönderimi düzeltilince doğrulama bağlantısını tekrar gönderebiliriz.
            </p>
        }
        else
        {
            <p class="text-sm text-slate-600 mb-8 leading-relaxed">
                Kayıt işleminizi tamamlamak için e-posta adresinize bir onay bağlantısı gönderdik. Lütfen gelen kutunuzu ve spam klasörünü kontrol ederek e-postanızı doğrulayın.
            </p>
        }

        <a href="/Hesap/GirisYap" class="inline-block bg-[#00A4D3] text-white px-8 py-3.5 text-xs font-bold tracking-wider uppercase rounded-xl hover:bg-[#0284C7] transition-all shadow-md shadow-sky-500/20">
            Giriş Ekranına Dön
        </a>
    </div>
</div>
