@model KanvasProje.Web.Models.KayitViewModel
@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="min-h-[80vh] flex items-center justify-center py-16 px-4 bg-[#F8FAFC]">
    <div class="w-full max-w-lg">
        <!-- Logo / Başlık -->
        <div class="text-center mb-8">
            <a href="/" class="inline-block">
                <img src="/meteorgaleri-logo.png" alt="Meteor Galeri" class="h-10 md:h-12 mx-auto object-contain" />
            </a>
            <p class="text-xs text-slate-500 mt-3 font-medium">Yeni hesap oluşturun</p>
        </div>

        <!-- Validation Hataları -->
        <div asp-validation-summary="ModelOnly" class="bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded-xl mb-6 hidden [&:not(:empty)]:block"></div>

        <!-- Form Kartı -->
        <div class="bg-white border border-slate-200 rounded-2xl p-8 shadow-sm">
            <form asp-action="KayitOl" method="post" class="space-y-4">

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="AdSoyad" class="block text-xs font-bold text-slate-800 tracking-wider mb-2 uppercase">Ad Soyad</label>
                        <input asp-for="AdSoyad" placeholder="Adınız Soyadınız" autocomplete="name"
                               class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-[#00A4D3] focus:border-[#00A4D3] outline-none bg-white text-slate-800" />
                        <span asp-validation-for="AdSoyad" class="text-red-600 text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="Sehir" class="block text-xs font-bold text-slate-800 tracking-wider mb-2 uppercase">Şehir</label>
                        <select asp-for="Sehir" class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-[#00A4D3] focus:border-[#00A4D3] outline-none bg-white text-slate-800">
                            <option value="">Şehir seçin</option>
                            <option>Adana</option><option>Adıyaman</option><option>Afyonkarahisar</option>
                            <option>Ağrı</option><option>Aksaray</option><option>Amasya</option>
                            <option>Ankara</option><option>Antalya</option><option>Ardahan</option>
                            <option>Artvin</option><option>Aydın</option><option>Balıkesir</option>
                            <option>Bartın</option><option>Batman</option><option>Bayburt</option>
                            <option>Bilecik</option><option>Bingöl</option><option>Bitlis</option>
                            <option>Bolu</option><option>Burdur</option><option>Bursa</option>
                            <option>Çanakkale</option><option>Çankırı</option><option>Çorum</option>
                            <option>Denizli</option><option>Diyarbakır</option><option>Düzce</option>
                            <option>Edirne</option><option>Elazığ</option><option>Erzincan</option>
                            <option>Erzurum</option><option>Eskişehir</option><option>Gaziantep</option>
                            <option>Giresun</option><option>Gümüşhane</option><option>Hakkari</option>
                            <option>Hatay</option><option>Iğdır</option><option>Isparta</option>
                            <option>İstanbul</option><option>İzmir</option><option>Kahramanmaraş</option>
                            <option>Karabük</option><option>Karaman</option><option>Kars</option>
                            <option>Kastamonu</option><option>Kayseri</option><option>Kırıkkale</option>
                            <option>Kırklareli</option><option>Kırşehir</option><option>Kilis</option>
                            <option>Kocaeli</option><option>Konya</option><option>Kütahya</option>
                            <option>Malatya</option><option>Manisa</option><option>Mardin</option>
                            <option>Mersin</option><option>Muğla</option><option>Muş</option>
                            <option>Nevşehir</option><option>Niğde</option><option>Ordu</option>
                            <option>Osmaniye</option><option>Rize</option><option>Sakarya</option>
                            <option>Samsun</option><option>Siirt</option><option>Sinop</option>
                            <option>Sivas</option><option>Şanlıurfa</option><option>Şırnak</option>
                            <option>Tekirdağ</option><option>Tokat</option><option>Trabzon</option>
                            <option>Tunceli</option><option>Uşak</option><option>Van</option>
                            <option>Yalova</option><option>Yozgat</option><option>Zonguldak</option>
                        </select>
                        <span asp-validation-for="Sehir" class="text-red-600 text-xs mt-1 block"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="Eposta" class="block text-xs font-bold text-slate-800 tracking-wider mb-2 uppercase">E-posta</label>
                    <input asp-for="Eposta" type="email" placeholder="ornek@mail.com" autocomplete="email"
                           class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-[#00A4D3] focus:border-[#00A4D3] outline-none bg-white text-slate-800" />
                    <span asp-validation-for="Eposta" class="text-red-600 text-xs mt-1 block"></span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Sifre" class="block text-xs font-bold text-slate-800 tracking-wider mb-2 uppercase">Şifre</label>
                        <input asp-for="Sifre" type="password" placeholder="En az 6 karakter" autocomplete="new-password"
                               class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-[#00A4D3] focus:border-[#00A4D3] outline-none bg-white text-slate-800" />
                        <span asp-validation-for="Sifre" class="text-red-600 text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="SifreTekrar" class="block text-xs font-bold text-slate-800 tracking-wider mb-2 uppercase">Şifre Tekrar</label>
                        <input asp-for="SifreTekrar" type="password" placeholder="Şifrenizi tekrar girin" autocomplete="new-password"
                               class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-[#00A4D3] focus:border-[#00A4D3] outline-none bg-white text-slate-800" />
                        <span asp-validation-for="SifreTekrar" class="text-red-600 text-xs mt-1 block"></span>
                    </div>
                </div>

                <button type="submit"
                        class="w-full bg-[#00A4D3] hover:bg-[#0284C7] text-white py-3.5 text-xs font-bold tracking-wider uppercase rounded-xl shadow-md hover:shadow-lg transition-all active:scale-[0.98] mt-2">
                    Üyelik Oluştur
                </button>
            </form>
        </div>

        <!-- Sosyal Kayıt Butonları -->
        <div class="mt-6">
            <div class="relative mb-6">
                <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-slate-200"></div>
                </div>
                <div class="relative flex justify-center">
                    <span class="bg-[#F8FAFC] px-4 text-xs text-slate-400 uppercase tracking-widest font-semibold">veya</span>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-2 sm:gap-3">
                <form asp-action="ExternalLogin" method="post" class="block">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="provider" value="Google" />
                    <button type="submit" class="w-full h-11 border border-slate-200 rounded-xl text-xs uppercase tracking-wider text-slate-700 hover:border-[#00A4D3] hover:text-[#00A4D3] transition-colors flex items-center justify-center gap-1 sm:gap-2 bg-white font-semibold shadow-2xs">
                        <i class="fab fa-google text-sm text-[#E30613]"></i><span class="hidden sm:inline">Google ile </span>Kayıt Ol
                    </button>
                </form>
                <form asp-action="ExternalLogin" method="post" class="block">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="provider" value="Facebook" />
                    <button type="submit" class="w-full h-11 border border-slate-200 rounded-xl text-xs uppercase tracking-wider text-slate-700 hover:border-[#00A4D3] hover:text-[#00A4D3] transition-colors flex items-center justify-center gap-1 sm:gap-2 bg-white font-semibold shadow-2xs">
                        <i class="fab fa-facebook-f text-sm text-[#00A4D3]"></i><span class="hidden sm:inline">Facebook ile </span>Kayıt Ol
                    </button>
                </form>
            </div>
        </div>

        <p class="text-center text-sm text-slate-600 mt-6">
            Zaten hesabınız var mı?
            <a href="/Hesap/GirisYap" class="text-[#E30613] hover:underline font-bold">Giriş Yapın</a>
        </p>
    </div>
</div>
