@{
    ViewData["Title"] = "Sipariş Alındı";
}

<div class="container mx-auto px-4 py-16 max-w-2xl">
    <!-- Başarı İkonu -->
    <div class="text-center mb-10">
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-emerald-50 text-emerald-600 mb-6 text-3xl shadow-sm">
            <i class="fas fa-check-circle"></i>
        </div>
        <h1 class="font-heading text-3xl sm:text-4xl font-extrabold text-slate-900 mb-3">Siparişiniz Alındı!</h1>
        <p class="text-sm text-slate-600 max-w-sm mx-auto leading-relaxed">
            Tablonuz atölyemizde özenle hazırlanmaya başlandı. Kargo takip bilgileriniz e-posta ile iletilecektir.
        </p>
    </div>

    <!-- Sipariş Kartı -->
    <div class="bg-white border border-slate-200/80 rounded-2xl overflow-hidden mb-8 shadow-sm">
        <div class="bg-slate-50 px-6 py-4 flex items-center justify-between border-b border-slate-100">
            <div>
                <p class="text-xs uppercase tracking-wider text-slate-400 font-bold mb-0.5">Sipariş Numarası</p>
                <p class="font-mono text-2xl text-slate-900 font-extrabold">#@ViewBag.SiparisNo</p>
            </div>
            <span class="inline-flex items-center gap-1.5 text-xs bg-emerald-50 text-emerald-700 border border-emerald-200 px-3 py-1.5 rounded-full font-semibold">
                <i class="fas fa-circle-check text-[10px]"></i> Onaylandı
            </span>
        </div>
        <div class="px-6 py-5 grid grid-cols-2 gap-4 text-sm">
            <div>
                <p class="text-xs text-slate-400 uppercase tracking-wider font-semibold mb-1">İşlem Zamanı</p>
                <p class="font-semibold text-slate-800">@DateTime.Now.ToString("dd MMMM yyyy HH:mm")</p>
            </div>
            <div>
                <p class="text-xs text-slate-400 uppercase tracking-wider font-semibold mb-1">Onay E-postası</p>
                <p class="font-semibold text-emerald-600 flex items-center gap-1.5">
                    <i class="fas fa-envelope-circle-check text-xs"></i> Gönderildi
                </p>
            </div>
        </div>
    </div>

    <!-- Süreç Adımları -->
    <div class="grid grid-cols-3 gap-4 mb-10">
        <div class="text-center bg-white border border-slate-200/80 rounded-2xl p-4 shadow-sm">
            <div class="w-10 h-10 rounded-full bg-[#00A4D3] text-white flex items-center justify-center text-sm font-bold mx-auto mb-3 shadow-md shadow-sky-500/20">1</div>
            <h4 class="font-bold text-slate-900 text-sm mb-1">Hazırlanıyor</h4>
            <p class="text-xs text-slate-500 leading-relaxed">1–2 iş günü içinde atölyede basılıp paketleniyor</p>
        </div>
        <div class="text-center bg-white border border-slate-200/80 rounded-2xl p-4 shadow-sm">
            <div class="w-10 h-10 rounded-full bg-slate-100 text-slate-600 flex items-center justify-center text-sm font-bold mx-auto mb-3">2</div>
            <h4 class="font-bold text-slate-900 text-sm mb-1">Kargoya Verildi</h4>
            <p class="text-xs text-slate-500 leading-relaxed">Takip numarası SMS & e-posta ile iletilir</p>
        </div>
        <div class="text-center bg-white border border-slate-200/80 rounded-2xl p-4 shadow-sm">
            <div class="w-10 h-10 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center text-sm font-bold mx-auto mb-3">3</div>
            <h4 class="font-bold text-slate-900 text-sm mb-1">Teslimat</h4>
            <p class="text-xs text-slate-500 leading-relaxed">Korumalı kutuda güvenle kapınıza ulaşır</p>
        </div>
    </div>

    <!-- Butonlar -->
    <div class="flex flex-col sm:flex-row gap-4">
        <a href="/Profil/Siparislerim"
           class="flex-1 bg-[#00A4D3] text-white text-center text-xs font-bold tracking-wider uppercase py-3.5 rounded-xl hover:bg-[#0284C7] transition-all shadow-md shadow-sky-500/20 flex items-center justify-center gap-2">
            <i class="fas fa-box text-xs"></i> Siparişimi Takip Et
        </a>
        <a href="/Urun"
           class="flex-1 border border-slate-300 text-slate-700 hover:bg-slate-50 text-center text-xs font-bold tracking-wider uppercase py-3.5 rounded-xl transition-colors flex items-center justify-center gap-2">
            <i class="fas fa-bag-shopping text-xs"></i> Alışverişe Devam Et
        </a>
    </div>

    <!-- Destek Bağlantıları -->
    <div class="text-center mt-10 pt-6 border-t border-slate-200">
        <p class="text-xs text-slate-500 mb-3">Siparişinizle ilgili sorularınız mı var?</p>
        <div class="flex justify-center gap-6">
            <a href="/Kurumsal/Iletisim" class="text-xs font-semibold text-[#00A4D3] hover:text-[#0284C7] transition-colors flex items-center gap-1.5">
                <i class="fas fa-headset"></i> Bize Ulaşın
            </a>
            <a href="/" class="text-xs font-semibold text-[#00A4D3] hover:text-[#0284C7] transition-colors flex items-center gap-1.5">
                <i class="fas fa-house"></i> Ana Sayfaya Dön
            </a>
        </div>
    </div>
</div>
