@model KanvasProje.Core.Varliklar.Siparis
@using KanvasProje.Core.Varliklar
@{
    ViewData["Title"] = "Güvenli Ödeme";

    decimal araToplam = ViewBag.AraToplam ?? 0;
    decimal indirim = ViewBag.IndirimTutari ?? 0;
    decimal genelToplam = ViewBag.ToplamTutar ?? 0;
    string? kuponKodu = ViewBag.KuponKodu as string;
    var sepetItems = ViewBag.SepetItems as List<KanvasProje.Core.Varliklar.SepetItem> ?? new List<KanvasProje.Core.Varliklar.SepetItem>();

    var kayitliAdresler = ViewBag.KayitliAdresler as List<KanvasProje.Core.Varliklar.Adres>;
    bool girisYapmis = User.Identity?.IsAuthenticated == true;
    var sehirler = new[]
    {
        "Adana", "Adıyaman", "Afyonkarahisar", "Ağrı", "Aksaray", "Amasya", "Ankara", "Antalya", "Ardahan", "Artvin",
        "Aydın", "Balıkesir", "Bartın", "Batman", "Bayburt", "Bilecik", "Bingöl", "Bitlis", "Bolu", "Burdur",
        "Bursa", "Çanakkale", "Çankırı", "Çorum", "Denizli", "Diyarbakır", "Düzce", "Edirne", "Elazığ", "Erzincan",
        "Erzurum", "Eskişehir", "Gaziantep", "Giresun", "Gümüşhane", "Hakkari", "Hatay", "Iğdır", "Isparta", "İstanbul",
        "İzmir", "Kahramanmaraş", "Karabük", "Karaman", "Kars", "Kastamonu", "Kayseri", "Kırıkkale", "Kırklareli", "Kırşehir",
        "Kilis", "Kocaeli", "Konya", "Kütahya", "Malatya", "Manisa", "Mardin", "Mersin", "Muğla", "Muş",
        "Nevşehir", "Niğde", "Ordu", "Osmaniye", "Rize", "Sakarya", "Samsun", "Siirt", "Sinop", "Sivas",
        "Şanlıurfa", "Şırnak", "Tekirdağ", "Tokat", "Trabzon", "Tunceli", "Uşak", "Van", "Yalova", "Yozgat",
        "Zonguldak"
    };
}

<!-- Breadcrumb -->
<div class="bg-[#F8FAFC] border-b border-slate-200 py-4">
    <div class="container mx-auto px-4 flex items-center justify-center gap-4 text-xs tracking-wider uppercase">
        <a href="/Sepet" class="text-slate-500 hover:text-[#00A4D3] transition-colors flex items-center gap-2 font-medium">
            <span class="w-5 h-5 rounded-full bg-slate-200 text-slate-700 flex items-center justify-center font-bold text-[10px]">1</span> Sepet
        </a>
        <span class="text-slate-300">/</span>
        <span class="text-slate-900 font-bold flex items-center gap-2">
            <span class="w-5 h-5 rounded-full bg-[#00A4D3] text-white flex items-center justify-center font-bold text-[10px]">2</span> Ödeme & Teslimat
        </span>
    </div>
</div>

<div class="container mx-auto px-4 py-10 md:py-14">
    <div class="text-center mb-10 md:mb-12">
        <h1 class="font-serif text-3xl md:text-5xl font-bold text-slate-900 mb-3">Güvenli Ödeme</h1>
        <p class="text-sm text-slate-500 max-w-xl mx-auto">Teslimat bilgilerinizi kontrol edin ve siparişinizi güvenle tamamlayın.</p>
    </div>

    <div class="flex flex-col lg:flex-row gap-10 lg:gap-14 max-w-6xl mx-auto">
        <!-- Sol Form Alanı -->
        <div class="lg:w-2/3 space-y-10">
            
            @if (kayitliAdresler != null && kayitliAdresler.Any())
            {
                <section>
                    <h2 class="font-serif text-2xl font-bold text-slate-900 mb-6 flex items-center gap-3 border-b border-slate-200 pb-4">
                        <i class="fas fa-address-book text-[#00A4D3]"></i> Kayıtlı Adresleriniz
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        @foreach (var adres in kayitliAdresler)
                        {
                            <label class="relative border border-slate-200 rounded-xl p-5 cursor-pointer transition-all hover:border-[#00A4D3] has-[:checked]:border-[#00A4D3] has-[:checked]:bg-sky-50 group block shadow-2xs">
                                <input type="radio" name="kayitliAdresSecimi" class="absolute opacity-0 w-0 h-0 peer" onclick="selectAddress('@adres.AdSoyad', '@adres.Telefon', '@adres.Sehir', '@adres.Ilce', '@adres.AcikAdres')">
                                <div class="flex items-start gap-3">
                                    <span class="address-radio w-5 h-5 rounded-full border-2 border-[#00A4D3] flex items-center justify-center bg-white transition-all duration-200 shrink-0 mt-0.5">
                                        <span class="address-radio-inner w-2.5 h-2.5 rounded-full bg-[#00A4D3] opacity-0 scale-0 transition-all duration-200"></span>
                                    </span>
                                    <div class="flex-1">
                                        <div class="text-sm font-bold text-slate-900 mb-1.5 uppercase tracking-wide">@adres.Baslik</div>
                                        <div class="text-sm text-slate-700 mb-0.5 font-medium">@adres.AdSoyad</div>
                                        <div class="text-xs text-slate-500 mb-1">@adres.Telefon</div>
                                        <div class="text-xs font-semibold text-slate-700 mb-2">@adres.Sehir / @adres.Ilce</div>
                                        <div class="text-xs text-slate-500 leading-relaxed line-clamp-2">@adres.AcikAdres</div>
                                    </div>
                                </div>
                            </label>
                        }
                    </div>
                </section>
            }

            <section>
                <h2 class="font-serif text-2xl font-bold text-slate-900 mb-6 flex items-center gap-3 border-b border-slate-200 pb-4">
                    <i class="fas fa-truck text-[#00A4D3]"></i> Teslimat Bilgileri
                </h2>

                @if (ViewBag.FormHata != null || !ViewData.ModelState.IsValid)
                {
                    <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
                        <div class="font-semibold">@((string?)ViewBag.FormHata ?? "Lütfen form bilgilerini kontrol edin.")</div>
                        <div asp-validation-summary="All" class="mt-2"></div>
                    </div>
                }

                <form asp-action="Odeme" method="post" id="odemeForm">
                    @if (girisYapmis)
                    {
                        <input type="hidden" asp-for="Eposta" />
                    }

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-6">
                        <div class="md:col-span-2">
                            <label class="block text-xs uppercase tracking-wider text-slate-900 font-bold mb-2" for="MusteriAdSoyad">Ad Soyad</label>
                            <input asp-for="MusteriAdSoyad" id="MusteriAdSoyad" class="w-full bg-transparent border-0 border-b-2 border-slate-200 px-0 py-2.5 focus:ring-0 focus:border-[#00A4D3] text-slate-900 font-medium transition-colors" placeholder="Adınız ve soyadınız" required>
                        </div>

                        <div>
                            <label class="block text-xs uppercase tracking-wider text-slate-900 font-bold mb-2" for="Eposta">E-posta</label>
                            @if (girisYapmis)
                            {
                                <input value="@Model.Eposta" class="w-full bg-transparent border-0 border-b-2 border-slate-200 px-0 py-2.5 text-slate-500 cursor-not-allowed font-medium" readonly>
                                <div class="mt-1.5 text-[10px] uppercase tracking-wider text-[#00A4D3] font-semibold">Kayıtlı e-posta adresiniz kullanılacak.</div>
                            }
                            else
                            {
                                <input asp-for="Eposta" id="Eposta" type="email" class="w-full bg-transparent border-0 border-b-2 border-slate-200 px-0 py-2.5 focus:ring-0 focus:border-[#00A4D3] text-slate-900 font-medium transition-colors" placeholder="ornek@mail.com" required>
                            }
                        </div>

                        <div>
                            <label class="block text-xs uppercase tracking-wider text-slate-900 font-bold mb-2" for="Telefon">Telefon</label>
                            <input asp-for="Telefon" id="Telefon" class="w-full bg-transparent border-0 border-b-2 border-slate-200 px-0 py-2.5 focus:ring-0 focus:border-[#00A4D3] text-slate-900 font-medium transition-colors" placeholder="5XX XXX XX XX" maxlength="13" required>
                        </div>

                        <div>
                            <label class="block text-xs uppercase tracking-wider text-slate-900 font-bold mb-2" for="Sehir">Şehir</label>
                            <select asp-for="Sehir" id="Sehir" class="w-full bg-transparent border-0 border-b-2 border-slate-200 px-0 py-2.5 focus:ring-0 focus:border-[#00A4D3] text-slate-900 font-medium transition-colors" required>
                                <option value="">Şehir seçiniz</option>
                                @foreach (var sehir in sehirler)
                                {
                                    <option value="@sehir">@sehir</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="block text-xs uppercase tracking-wider text-slate-900 font-bold mb-2" for="Ilce">İlçe</label>
                            <input asp-for="Ilce" id="Ilce" class="w-full bg-transparent border-0 border-b-2 border-slate-200 px-0 py-2.5 focus:ring-0 focus:border-[#00A4D3] text-slate-900 font-medium transition-colors" placeholder="İlçe adı" required>
                        </div>

                        <div class="md:col-span-2">
                            <label class="block text-xs uppercase tracking-wider text-slate-900 font-bold mb-2" for="AcikAdres">Açık Adres</label>
                            <textarea asp-for="AcikAdres" id="AcikAdres" class="w-full bg-transparent border-0 border-b-2 border-slate-200 px-0 py-2.5 focus:ring-0 focus:border-[#00A4D3] text-slate-900 font-medium transition-colors resize-none h-24" placeholder="Mahalle, sokak, bina ve daire numarası" required></textarea>
                        </div>

                        @if (girisYapmis)
                        {
                            <div class="md:col-span-2 mt-2 bg-[#F8FAFC] border border-slate-200 p-4 rounded-xl">
                                <label class="flex items-center gap-3 cursor-pointer group">
                                    <input type="checkbox" id="AdresiKaydet" name="AdresiKaydet" value="true" class="w-4 h-4 text-[#00A4D3] border-slate-300 rounded focus:ring-[#00A4D3]">
                                    <span class="text-sm font-semibold text-slate-800 transition-colors">Bu adresi sonraki siparişlerim için kaydet</span>
                                </label>
                                
                                <div id="adresBaslikWrapper" class="mt-4 hidden transition-all duration-300">
                                    <label class="block text-xs uppercase tracking-wider text-slate-900 font-bold mb-2" for="YeniAdresBasligi">Adres Başlığı</label>
                                    <input type="text" id="YeniAdresBasligi" name="YeniAdresBasligi" class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-xs focus:ring-1 focus:ring-[#00A4D3] text-slate-900 font-medium transition-colors" placeholder="Örn: Evim, Ofisim">
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Kargo Firması Seçimi -->
                    <div class="mt-10">
                        <h2 class="font-serif text-2xl font-bold text-slate-900 mb-6 flex items-center gap-3 border-b border-slate-200 pb-4">
                            <i class="fas fa-truck-fast text-[#00A4D3]"></i> Kargo Firması Seçiniz
                        </h2>
                        
                        @{
                            var kargoFirmalari = ViewBag.KargoFirmalari as List<KargoFirmasi> ?? new List<KargoFirmasi>();
                            var ucretsizKargoLimiti = (decimal)(ViewBag.UcretsizKargoLimiti ?? 500);
                            var isFreeShipping = (araToplam - indirim) >= ucretsizKargoLimiti;
                        }

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            @foreach (var kargo in kargoFirmalari)
                            {
                                var kargoFiyat = isFreeShipping ? 0 : kargo.Fiyat;
                                var isChecked = Model.KargoFirmasiId > 0 ? (kargo.Id == Model.KargoFirmasiId) : kargo.VarsayilanMi;
                                var checkedAttr = isChecked ? "checked" : null;
                                
                                <label class="group relative cursor-pointer border border-slate-200 rounded-xl p-4 bg-white flex items-center justify-between gap-4 transition-all hover:border-[#00A4D3] has-[:checked]:border-[#00A4D3] has-[:checked]:bg-sky-50 shadow-2xs">
                                    <div class="flex items-center gap-3">
                                        <input type="radio" name="KargoFirmasiId" value="@kargo.Id" class="kargo-radio w-4 h-4 text-[#00A4D3] border-slate-300 focus:ring-[#00A4D3]" checked="@checkedAttr" data-price="@kargoFiyat" data-name="@kargo.Ad" />
                                        <div>
                                            <div class="text-sm font-bold text-slate-900">@kargo.Ad</div>
                                            <div class="text-[11px] text-slate-500">@kargo.Telefon</div>
                                        </div>
                                    </div>
                                    <div class="text-right">
                                        @if (kargoFiyat == 0)
                                        {
                                            <span class="text-xs font-bold text-emerald-600 uppercase">Ücretsiz</span>
                                        }
                                        else
                                        {
                                            <span class="text-sm font-bold text-slate-900">₺@kargoFiyat.ToString("N2")</span>
                                        }
                                    </div>
                                </label>
                            }
                        </div>
                    </div>

                    <div class="mt-10">
                        <h2 class="font-serif text-2xl font-bold text-slate-900 mb-6 flex items-center gap-3 border-b border-slate-200 pb-4">
                            <i class="fas fa-credit-card text-[#00A4D3]"></i> Ödeme Yöntemi
                        </h2>
                        
                        <div class="border border-slate-200 rounded-2xl p-6 bg-white relative overflow-hidden shadow-2xs">
                            <div class="absolute top-0 right-0 bg-[#00A4D3] text-white text-[10px] uppercase tracking-wider px-3 py-1 font-bold rounded-bl-xl">256-Bit SSL</div>
                            
                            <div class="flex items-center gap-4 mb-4">
                                <i class="fas fa-shield-alt text-[#00A4D3] text-3xl"></i>
                                <div>
                                    <h6 class="text-base font-bold text-slate-900">Güvenli Ödeme & Sipariş Onayı</h6>
                                    <p class="text-xs text-slate-500">Siparişiniz atölyemizde özenle hazırlanarak tarafınıza sevk edilecektir.</p>
                                </div>
                            </div>

                            <p class="text-sm text-slate-600 mb-6 border-t border-slate-200 pt-4 leading-relaxed">
                                Siparişi Tamamla butonuna tıkladığınızda siparişiniz oluşturulur. Sipariş durumunuz ve kargo takip bilgileriniz SMS ve E-posta ile bildirilecektir.
                            </p>

                            <label class="flex items-start gap-3 cursor-pointer group mt-4 bg-[#F8FAFC] p-4 rounded-xl border border-slate-200">
                                <input type="checkbox" id="terms" required class="w-4 h-4 mt-0.5 text-[#00A4D3] border-slate-300 rounded focus:ring-[#00A4D3]">
                                <span class="text-xs sm:text-sm leading-relaxed text-slate-600">
                                    <a href="/Kurumsal/Gizlilik" class="text-[#00A4D3] font-semibold hover:underline">Gizlilik Politikası</a> ve 
                                    <a href="/Kurumsal/KullaniciSozlesmesi" class="text-[#00A4D3] font-semibold hover:underline">Kullanıcı Sözleşmesi</a> şartlarını okudum, onaylıyorum.
                                </span>
                            </label>
                        </div>
                    </div>

                    <button type="submit" class="w-full mt-8 bg-[#E30613] hover:bg-[#DC2626] text-white text-sm font-bold tracking-wider uppercase py-4 rounded-xl shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-3 active:scale-[0.98]">
                        <i class="fas fa-check"></i> Siparişi Tamamla — <span id="checkoutBtnTotal">@genelToplam.ToString("N2")</span> TL
                    </button>
                </form>
            </section>
        </div>

        <!-- Sağ Sipariş Özeti -->
        <div class="lg:w-1/3">
            <div class="sticky top-28 bg-white border border-slate-200 rounded-2xl p-6 lg:p-7 shadow-sm">
                <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6 pb-4 border-b border-slate-200">Sipariş Özeti</h3>
                
                @if (sepetItems.Any())
                {
                    <div class="mb-6 space-y-3 border-b border-slate-200 pb-5 max-h-72 overflow-y-auto custom-scrollbar pr-1">
                        @foreach (var item in sepetItems)
                        {
                            <div class="flex gap-3">
                                <div class="h-14 w-14 shrink-0 overflow-hidden rounded-xl bg-[#F8FAFC] border border-slate-200">
                                    <img src="@item.UrunResimUrl" alt="@item.UrunBaslik" class="h-full w-full object-cover" loading="lazy" decoding="async" />
                                </div>
                                <div class="min-w-0 flex-1">
                                    <div class="line-clamp-2 text-xs font-bold text-slate-800">@item.UrunBaslik</div>
                                    @if (!string.IsNullOrWhiteSpace(item.SecenekAdi))
                                    {
                                        <div class="mt-0.5 text-[11px] leading-snug text-slate-500">@item.SecenekAdi</div>
                                    }
                                    <div class="mt-1 flex justify-between gap-2 text-xs text-slate-600 font-medium">
                                        <span>x @item.Adet</span>
                                        <span class="font-bold text-slate-900">@item.Toplam.ToString("N2") TL</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="space-y-3 mb-6 text-sm">
                    <div class="flex justify-between text-slate-600">
                        <span>Ara Toplam</span>
                        <span>@araToplam.ToString("N2") TL</span>
                    </div>

                    @if (indirim > 0)
                    {
                        <div class="flex justify-between text-emerald-600 font-semibold">
                            <span>İndirim (@kuponKodu)</span>
                            <span>-@indirim.ToString("N2") TL</span>
                        </div>
                    }

                    <div class="flex justify-between text-slate-600">
                        <span>Kargo Ücreti</span>
                        <span id="checkoutKargoUcreti" class="text-slate-900 font-bold">@((ViewBag.GosterilecekKargoBedeli == 0) ? "Ücretsiz" : $"₺{((decimal)ViewBag.GosterilecekKargoBedeli).ToString("N2")}")</span>
                    </div>
                </div>

                <div class="flex justify-between items-end border-t border-slate-200 pt-5 mb-6">
                    <span class="text-sm text-slate-500 uppercase tracking-wider font-semibold">Genel Toplam</span>
                    <span id="checkoutGenelToplam" class="text-3xl font-black text-[#E30613] tracking-tight">@genelToplam.ToString("N2") <span class="text-sm font-bold text-slate-500">TL</span></span>
                </div>

                <div class="space-y-3 pt-5 border-t border-slate-200">
                    <!-- Güvenli Ödeme & SSL -->
                    <div class="flex items-start gap-3 bg-[#F8FAFC] p-3 rounded-xl border border-slate-200">
                        <div class="w-8 h-8 rounded-full bg-sky-100 flex items-center justify-center shrink-0 text-[#00A4D3]">
                            <i class="fas fa-shield-halved text-sm"></i>
                        </div>
                        <div>
                            <p class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-0.5">
                                256-Bit SSL Koruması
                            </p>
                            <p class="text-[11px] text-slate-500 leading-relaxed">Kart ve kimlik bilgileriniz banka standartlarında şifrelenir ve korunur.</p>
                        </div>
                    </div>

                    <!-- Hasarsız Teslimat Garantisi -->
                    <div class="flex items-start gap-3 bg-[#F8FAFC] p-3 rounded-xl border border-slate-200">
                        <div class="w-8 h-8 rounded-full bg-amber-100 flex items-center justify-center shrink-0 text-amber-600">
                            <i class="fas fa-box-open text-sm"></i>
                        </div>
                        <div>
                            <p class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-0.5">
                                Hasarsız Teslimat Garantisi
                            </p>
                            <p class="text-[11px] text-slate-500 leading-relaxed">Özel korumalı sandıklarda paketlenir; kargoda hasar olursa yenisi ücretsiz gönderilir.</p>
                        </div>
                    </div>

                    <!-- 14 Gün İade -->
                    <div class="flex items-start gap-3 bg-[#F8FAFC] p-3 rounded-xl border border-slate-200">
                        <div class="w-8 h-8 rounded-full bg-sky-100 flex items-center justify-center shrink-0 text-[#00A4D3]">
                            <i class="fas fa-arrow-rotate-left text-sm"></i>
                        </div>
                        <div>
                            <p class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-0.5">14 Gün Kolay İade</p>
                            <p class="text-[11px] text-slate-500 leading-relaxed">Yasal 14 gün içinde koşulsuz kolay iade ve değişim hakkı.</p>
                        </div>
                    </div>

                    <!-- Kart ve Ödeme Logoları -->
                    <div class="pt-3 flex items-center justify-center gap-4 text-slate-400 text-lg">
                        <i class="fab fa-cc-visa hover:text-slate-700 transition-colors" title="Visa"></i>
                        <i class="fab fa-cc-mastercard hover:text-slate-700 transition-colors" title="Mastercard"></i>
                        <i class="fab fa-cc-amex hover:text-slate-700 transition-colors" title="American Express"></i>
                        <span class="text-[10px] font-bold text-[#00A4D3] border border-[#00A4D3] rounded px-1.5 py-0.5 uppercase tracking-wider">TROY</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
    </div>
</div>

<script>
    function selectAddress(ad, tel, sehir, ilce, acikAdres) {
        document.getElementById("MusteriAdSoyad").value = ad;
        document.getElementById("Telefon").value = tel;
        document.getElementById("Sehir").value = sehir;
        document.getElementById("Ilce").value = ilce;
        document.getElementById("AcikAdres").value = acikAdres;

        if (window.showToast) {
            window.showToast('Adres bilgileri forma aktarıldı.', 'success');
        }
    }

    const adresKaydetCheckbox = document.getElementById('AdresiKaydet');
    if (adresKaydetCheckbox) {
        adresKaydetCheckbox.addEventListener('change', function () {
            const target = document.getElementById('adresBaslikWrapper');
            if (!target) return;

            if (this.checked) {
                target.classList.remove('hidden');
            } else {
                target.classList.add('hidden');
            }
        });
    }

    const telefonInput = document.getElementById('Telefon');
    if (telefonInput) {
        telefonInput.addEventListener('input', function (e) {
            let value = e.target.value.replace(/\D/g, '');

            if (value.startsWith('0')) {
                value = value.substring(1);
            }

            if (value.length > 10) {
                value = value.substring(0, 10);
            }

            if (value.length > 6) {
                value = value.replace(/(\d{3})(\d{3})(\d{2})(\d{2})/, '$1 $2 $3 $4');
            } else if (value.length > 3) {
                value = value.replace(/(\d{3})(\d{3})/, '$1 $2');
            }

            e.target.value = value;
        });
    }

    // Form submission validation UI
    const form = document.getElementById('odemeForm');
    form.addEventListener('submit', function(e) {
        if (!form.checkValidity()) {
            e.preventDefault();
            if (window.showToast) {
                window.showToast('Lütfen tüm zorunlu alanları eksiksiz doldurun.', 'error');
            }
        }
    });

    // Address radio button visual update
    document.querySelectorAll('input[name="kayitliAdresSecimi"]').forEach(function(radio) {
        radio.addEventListener('change', function() {
            document.querySelectorAll('.address-radio-inner').forEach(function(inner) {
                inner.classList.remove('opacity-100', 'scale-100');
                inner.classList.add('opacity-0', 'scale-0');
            });
            var container = this.closest('label').querySelector('.address-radio-inner');
            if (container) {
                container.classList.remove('opacity-0', 'scale-0');
                container.classList.add('opacity-100', 'scale-100');
            }
        });
    });

    document.addEventListener("DOMContentLoaded", function () {
        const kargoRadios = document.querySelectorAll(".kargo-radio");
        const kargoDisplay = document.getElementById("checkoutKargoUcreti");
        const totalDisplay = document.getElementById("checkoutGenelToplam");
        const btnTotalDisplay = document.getElementById("checkoutBtnTotal");

        const subtotal = parseFloat("@((araToplam - indirim).ToString(System.Globalization.CultureInfo.InvariantCulture))");

        function updateCheckoutTotals() {
            const selectedRadio = document.querySelector(".kargo-radio:checked");
            if (!selectedRadio) return;

            const kargoPrice = parseFloat(selectedRadio.getAttribute("data-price")) || 0;
            const genelToplamVal = subtotal + kargoPrice;

            if (kargoDisplay) {
                if (kargoPrice === 0) {
                    kargoDisplay.textContent = "Ücretsiz";
                    kargoDisplay.className = "text-green-600 font-bold uppercase";
                } else {
                    kargoDisplay.textContent = "₺" + kargoPrice.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                    kargoDisplay.className = "text-slate-800 font-semibold";
                }
            }

            if (totalDisplay) {
                totalDisplay.innerHTML = genelToplamVal.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' <span class="text-lg font-normal text-[#333333]">TL</span>';
            }

            if (btnTotalDisplay) {
                btnTotalDisplay.textContent = genelToplamVal.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }
        }

        kargoRadios.forEach(radio => {
            radio.addEventListener("change", updateCheckoutTotals);
        });

        updateCheckoutTotals();
    });
</script>
