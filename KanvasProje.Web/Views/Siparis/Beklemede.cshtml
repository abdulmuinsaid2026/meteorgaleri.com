@{
    ViewData["Title"] = "Siparişiniz Alındı";
    var siparisNo = ViewBag.SiparisNo as string ?? string.Empty;
}

<section class="min-h-[70vh] bg-[#F8FAFC] py-16">
    <div class="container mx-auto px-4">
        <div class="max-w-2xl mx-auto bg-white rounded-3xl shadow-sm border border-slate-200/80 overflow-hidden">
            <div class="p-8 md:p-12 text-center">
                <div class="w-20 h-20 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center mx-auto mb-6 shadow-sm">
                    <i class="fas fa-clock text-3xl"></i>
                </div>

                <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-amber-50 text-amber-700 border border-amber-200 text-xs font-bold uppercase tracking-wider mb-4">
                    <i class="fas fa-circle-info"></i>
                    Ödeme / Onay Bekleniyor
                </span>

                <h1 class="text-3xl md:text-4xl font-heading font-extrabold text-slate-900 mb-4 tracking-tight">Siparişiniz Alındı</h1>
                <p class="text-slate-600 text-base mb-8 max-w-lg mx-auto leading-relaxed">
                    Siparişiniz başarıyla oluşturuldu. Ödeme ve onay süreci tamamlandığında kayıtlı iletişim bilgileriniz üzerinden sizi bilgilendireceğiz.
                </p>

                @if (!string.IsNullOrWhiteSpace(siparisNo))
                {
                    <div class="bg-slate-50 border border-slate-200/80 rounded-2xl p-5 mb-8">
                        <div class="text-xs uppercase tracking-wider text-slate-400 font-bold mb-1">Sipariş No</div>
                        <div class="text-2xl font-extrabold text-slate-900 font-mono">@siparisNo</div>
                    </div>
                }

                <div class="grid gap-3 sm:grid-cols-2">
                    <a href="/Urun" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-[#00A4D3] text-white text-xs font-bold uppercase tracking-wider hover:bg-[#0284C7] shadow-md shadow-sky-500/20 transition-all">
                        <i class="fas fa-arrow-left"></i>
                        Alışverişe Devam Et
                    </a>
                    <a href="/Kurumsal/Iletisim" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl border border-slate-200 bg-white text-slate-700 text-xs font-bold uppercase tracking-wider hover:bg-slate-50 transition-all">
                        <i class="fas fa-headset"></i>
                        İletişime Geç
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
