@{
    ViewData["Title"] = "İyzico ile Güvenli Ödeme - Meteor Galeri";
    var checkoutFormContent = ViewBag.CheckoutFormContent as string;
    var siparisNo = ViewBag.SiparisNo as string;
    var toplamTutar = ViewBag.ToplamTutar is decimal t ? t : 0m;
    var hata = ViewBag.Hata as string;
}

<!-- Breadcrumb -->
<div class="bg-slate-50 border-b border-slate-200 py-3.5">
    <div class="container mx-auto px-4 flex items-center justify-center gap-4 text-xs font-bold tracking-wider uppercase">
        <a href="/Sepet" class="text-slate-500 hover:text-[#00A4D3] transition-colors flex items-center gap-2">
            <span class="w-5 h-5 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center font-bold text-[11px]">1</span> Sepet
        </a>
        <span class="text-slate-300">/</span>
        <a href="/Siparis/Odeme" class="text-slate-500 hover:text-[#00A4D3] transition-colors flex items-center gap-2">
            <span class="w-5 h-5 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center font-bold text-[11px]">2</span> Teslimat
        </a>
        <span class="text-slate-300">/</span>
        <span class="text-[#00A4D3] font-bold flex items-center gap-2">
            <span class="w-5 h-5 rounded-full bg-[#00A4D3] text-white flex items-center justify-center font-bold text-[11px]">3</span> Ödeme
        </span>
    </div>
</div>

<div class="container mx-auto px-4 py-8 md:py-12">
    <div class="text-center mb-8">
        <h1 class="font-heading text-3xl md:text-4xl text-slate-900 mb-2 font-extrabold tracking-tight">Güvenli Kart ile Ödeme</h1>
        <p class="text-sm text-slate-600 max-w-xl mx-auto leading-relaxed">
            Siparişiniz oluşturuldu. 256-Bit SSL ve İyzico güvencesiyle taksitli veya tek çekim ödemenizi tamamlayabilirsiniz.
        </p>
    </div>

    @if (!string.IsNullOrEmpty(hata))
    {
        <div class="max-w-2xl mx-auto mb-8 rounded-2xl border border-red-200 bg-red-50 p-6 text-sm text-red-700 shadow-sm">
            <div class="font-bold mb-1 flex items-center gap-2">
                <i class="fas fa-circle-exclamation text-red-600"></i> Ödeme Başlatılamadı
            </div>
            <p class="text-xs text-red-800 leading-relaxed font-mono">@hata</p>
            <div class="mt-4 flex gap-4">
                <a href="/Siparis/Odeme" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl bg-[#00A4D3] text-white text-xs font-bold uppercase tracking-wider hover:bg-[#0284C7] shadow-md shadow-sky-500/20 transition-all">
                    <i class="fas fa-arrow-left"></i> Bilgileri Güncelle & Tekrar Dene
                </a>
                <a href="/Kurumsal/Iletisim" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl border border-slate-200 bg-white text-slate-700 text-xs font-bold uppercase tracking-wider hover:bg-slate-50 transition-colors">
                    Destek Al
                </a>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(checkoutFormContent))
    {
        <!-- Sipariş Özeti Kartı -->
        <div class="max-w-3xl mx-auto mb-6 bg-white border border-slate-200/80 rounded-2xl p-5 shadow-sm">
            <div class="flex flex-wrap items-center justify-between gap-4">
                <div>
                    <span class="text-xs uppercase tracking-wider text-slate-400 font-bold">Sipariş Referansı</span>
                    <div class="text-lg font-bold text-slate-900 font-mono mt-0.5">#@siparisNo</div>
                </div>
                <div class="text-right">
                    <span class="text-xs uppercase tracking-wider text-slate-400 font-bold">Ödenecek Tutar</span>
                    <div class="text-2xl font-extrabold text-[#E30613] mt-0.5">@toplamTutar.ToString("N2") TL</div>
                </div>
            </div>
        </div>

        <!-- İyzico Responsive Checkout Form Container -->
        <div class="max-w-3xl mx-auto bg-white border border-slate-200/80 rounded-2xl overflow-hidden shadow-sm">
            <div class="bg-slate-900 text-white text-xs tracking-wider uppercase px-6 py-3.5 flex items-center gap-3">
                <i class="fas fa-lock text-[#00A4D3]"></i>
                <span class="font-semibold">256-Bit SSL & 3D Secure Korumalı Ödeme</span>
                <span class="ml-auto flex items-center gap-2 text-white/90">
                    <i class="fab fa-cc-visa text-base"></i>
                    <i class="fab fa-cc-mastercard text-base"></i>
                    <i class="fab fa-cc-troy text-base"></i>
                </span>
            </div>
            
            <div class="p-4 md:p-8 min-h-[500px]">
                <div id="iyzipay-checkout-form" class="responsive"></div>
                @Html.Raw(checkoutFormContent)
            </div>

            <div class="bg-slate-50 px-6 py-4 border-t border-slate-100 text-center">
                <p class="text-xs text-slate-500">
                    <i class="fas fa-shield-alt text-[#00A4D3] me-1"></i>
                    Kart bilgileriniz Meteor Galeri sunucularında asla saklanmaz. Ödeme doğrudan BDDK lisanslı İyzico altyapısı üzerinden gerçekleşir.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="max-w-2xl mx-auto text-center py-16">
            <div class="animate-spin w-10 h-10 border-4 border-slate-200 border-t-[#00A4D3] rounded-full mx-auto mb-4"></div>
            <p class="text-slate-600 font-medium text-sm">Güvenli İyzico ödeme sayfası yükleniyor...</p>
        </div>
    }
</div>
