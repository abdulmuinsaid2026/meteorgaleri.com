@{
    ViewData["Title"] = "Ödeme Başarısız - Meteor Galeri";
}

<div class="min-h-[70vh] flex items-center justify-center py-16 px-4 bg-[#F8FAFC]">
    <div class="w-full max-w-lg text-center">
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-red-100 text-red-600 mb-6 shadow-sm">
            <i class="fas fa-times text-4xl"></i>
        </div>
        <h1 class="font-heading text-3xl md:text-4xl font-extrabold text-slate-900 mb-4 tracking-tight">Ödeme Başarısız</h1>

        @if (ViewBag.Hata != null)
        {
            <div class="bg-red-50 border border-red-200 text-red-700 text-sm px-6 py-4 rounded-2xl mb-8 shadow-sm text-left">
                <p class="font-bold flex items-center gap-2">
                    <i class="fas fa-circle-exclamation text-red-500"></i> Hata Detayı:
                </p>
                <p class="mt-1 font-mono text-xs leading-relaxed text-red-800">@ViewBag.Hata</p>
            </div>
        }
        else
        {
            <p class="text-sm text-slate-600 mb-8 leading-relaxed">
                Ödeme işleminiz sırasında bir sorun oluştu ve siparişiniz tamamlanamadı.
                Kredi kartı bilgilerinizde, limitinizde veya 3D Secure onay kodunda bir sorun olabilir.
                Lütfen tekrar deneyin veya farklı bir kart kullanın.
            </p>
        }

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="/Sepet" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#00A4D3] text-white px-8 py-3.5 text-xs font-bold tracking-wider uppercase rounded-xl hover:bg-[#0284C7] shadow-md shadow-sky-500/20 transition-all">
                <i class="fas fa-shopping-cart"></i> Sepete Dön ve Tekrar Dene
            </a>
            <a href="/Kurumsal/Iletisim" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white border border-slate-200 text-slate-700 px-8 py-3.5 text-xs font-bold tracking-wider uppercase rounded-xl hover:bg-slate-50 transition-all">
                <i class="fas fa-headset"></i> Destek Al
            </a>
        </div>

        <div class="mt-8 bg-white border border-slate-200/80 rounded-2xl p-5 shadow-sm text-left">
            <p class="text-xs text-slate-600 flex items-start gap-3">
                <i class="fas fa-info-circle text-[#00A4D3] mt-0.5 flex-shrink-0"></i>
                <span>
                    Ödemeniz tamamlanamadıysa bankanızla iletişime geçebilir veya
                    <a href="/Kurumsal/Iletisim" class="text-[#00A4D3] underline font-semibold hover:text-[#0284C7]">bize ulaşarak</a>
                    destek alabilirsiniz.
                </span>
            </p>
        </div>
    </div>
</div>
