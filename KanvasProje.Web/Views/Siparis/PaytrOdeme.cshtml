@{
    ViewData["Title"] = "PayTR ile Güvenli Ödeme - Meteor Galeri";
    var token = ViewBag.PaytrToken as string;
    var siparisNo = ViewBag.SiparisNo as string;
    var toplamTutar = ViewBag.ToplamTutar is decimal t ? t : 0m;
    var hata = ViewBag.Hata as string;
}

<!-- Breadcrumb -->
<div class="bg-slate-50 border-b border-slate-200 py-3.5">
    <div class="container mx-auto px-4 flex items-center justify-center gap-4 text-xs font-bold tracking-wider uppercase">
        <a href="/Sepet" class="text-slate-500 hover:text-[#00A4D3] transition-colors flex items-center gap-2">
            <span class="w-5 h-5 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center font-bold text-[11px]">1</span> Sepet
        </a>
        <span class="text-slate-300">/</span>
        <a href="/Siparis/Odeme" class="text-slate-500 hover:text-[#00A4D3] transition-colors flex items-center gap-2">
            <span class="w-5 h-5 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center font-bold text-[11px]">2</span> Teslimat
        </a>
        <span class="text-slate-300">/</span>
        <span class="text-[#00A4D3] font-bold flex items-center gap-2">
            <span class="w-5 h-5 rounded-full bg-[#00A4D3] text-white flex items-center justify-center font-bold text-[11px]">3</span> Ödeme
        </span>
    </div>
</div>

<div class="container mx-auto px-4 py-10 md:py-14">
    <div class="text-center mb-10">
        <h1 class="font-heading text-3xl md:text-4xl font-extrabold text-slate-900 mb-3 tracking-tight">Güvenli Ödeme</h1>
        <p class="text-sm text-slate-600 max-w-2xl mx-auto leading-relaxed">
            Siparişiniz oluşturuldu. Aşağıdaki güvenli ödeme formunu kullanarak kartınızla ödemenizi tamamlayabilirsiniz.
        </p>
    </div>

    @if (!string.IsNullOrEmpty(hata))
    {
        <div class="max-w-2xl mx-auto mb-8 rounded-2xl border border-red-200 bg-red-50 p-6 text-sm text-red-700 shadow-sm">
            <div class="font-bold mb-1 flex items-center gap-2">
                <i class="fas fa-circle-exclamation text-red-500"></i> Ödeme başlatılamadı
            </div>
            <p class="text-xs text-red-800 leading-relaxed font-mono">@hata</p>
            <a href="/Siparis/Odeme" class="inline-flex items-center gap-1.5 mt-4 text-xs font-bold uppercase tracking-wider text-[#00A4D3] hover:text-[#0284C7] underline">
                <i class="fas fa-redo"></i> Tekrar dene
            </a>
        </div>
    }
    else if (!string.IsNullOrEmpty(token))
    {
        <!-- Sipariş Özeti -->
        <div class="max-w-3xl mx-auto mb-6 bg-white border border-slate-200/80 rounded-2xl p-6 shadow-sm">
            <div class="flex flex-wrap items-center justify-between gap-4">
                <div>
                    <span class="text-xs uppercase tracking-wider text-slate-400 font-bold">Sipariş No</span>
                    <div class="text-lg font-bold text-slate-900 font-mono mt-0.5">#@siparisNo</div>
                </div>
                <div class="text-right">
                    <span class="text-xs uppercase tracking-wider text-slate-400 font-bold">Toplam Tutar</span>
                    <div class="text-2xl font-extrabold text-[#E30613] mt-0.5">@toplamTutar.ToString("N2") TL</div>
                </div>
            </div>
        </div>

        <!-- PayTR Güvenli Ödeme Iframe -->
        <div class="max-w-3xl mx-auto bg-white border border-slate-200/80 rounded-2xl overflow-hidden shadow-sm">
            <div class="bg-slate-900 text-white text-xs tracking-wider uppercase px-6 py-3.5 flex items-center gap-3">
                <i class="fas fa-lock text-[#00A4D3]"></i>
                <span class="font-semibold">256-Bit SSL Güvenli Ödeme</span>
                <span class="ml-auto flex items-center gap-2 text-white/90">
                    <i class="fab fa-cc-visa text-base"></i>
                    <i class="fab fa-cc-mastercard text-base"></i>
                    <i class="fab fa-cc-troy text-base"></i>
                </span>
            </div>
            <div class="p-4 md:p-8">
                @* iframeResizer: PayTR'ın ödeme iframe'inin otomatik boyutlanması için gereklidir *@
                <script src="https://www.paytr.com/js/iframeResizer.min.js"></script>
                <iframe src="https://www.paytr.com/odeme/guvenli/@token"
                        id="paytriframe"
                        frameborder="0"
                        scrolling="no"
                        style="width: 100%; min-height: 640px;"
                        class="paytr-iframe">
                </iframe>
                <script>iFrameResize({}, '#paytriframe');</script>

                <div class="mt-6 pt-4 border-t border-slate-100 text-center">
                    <p class="text-xs text-slate-500">
                        <i class="fas fa-shield-alt text-[#00A4D3] mr-1"></i>
                        Ödemeniz PayTR tarafından 256-Bit SSL ile korunmaktadır. Kart bilgileriniz mağazamız sunucularında asla saklanmaz.
                    </p>
                </div>
            </div>
        </div>

        <!-- İşlem Beklerken Uyarı -->
        <div class="max-w-3xl mx-auto mt-6 bg-sky-50/60 border border-sky-100 rounded-2xl p-4 text-center">
            <p class="text-xs text-slate-600">
                <i class="fas fa-info-circle text-[#00A4D3] mr-1"></i>
                Ödeme işleminiz tamamlandıktan sonra onay sayfasına otomatik yönlendirileceksiniz.
                Herhangi bir sorun olursa
                <a href="/Kurumsal/Iletisim" class="text-[#00A4D3] underline font-semibold hover:text-[#0284C7]">iletişime</a>
                geçebilirsiniz.
            </p>
        </div>
    }
    else
    {
        <div class="max-w-2xl mx-auto text-center py-16">
            <div class="animate-spin w-10 h-10 border-4 border-slate-200 border-t-[#00A4D3] rounded-full mx-auto mb-4"></div>
            <p class="text-slate-600 font-medium text-sm">Ödeme sayfası hazırlanıyor...</p>
            <meta http-equiv="refresh" content="3">
        </div>
    }
</div>

<style>
    .paytr-iframe {
        transition: opacity 0.3s ease;
    }
    .paytr-iframe.loading {
        opacity: 0.5;
    }
</style>

<script>
    // Iframe yüklenirken gösterge
    document.addEventListener('DOMContentLoaded', function() {
        var iframe = document.getElementById('paytriframe');
        if (iframe) {
            iframe.classList.add('loading');
            iframe.addEventListener('load', function() {
                this.classList.remove('loading');
            });
        }
    });
</script>
