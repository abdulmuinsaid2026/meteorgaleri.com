@model List<KanvasProje.Core.Varliklar.SepetItem>

@{
    ViewData["Title"] = "Sepetim";
    decimal sepetToplami = Model.Sum(x => x.Toplam);
    decimal indirimTutari = (decimal)(ViewBag.IndirimTutari ?? 0);
    decimal ucretsizKargoLimiti = (decimal)(ViewBag.UcretsizKargoLimiti ?? 500);
    decimal kargoBedeli = (decimal)(ViewBag.GosterilecekKargoBedeli ?? 0);
    decimal genelToplam = (decimal)(ViewBag.GenelToplam ?? (sepetToplami - indirimTutari));
}

@functions {
    private static string FormatCartOptionLabel(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var sections = value
            .Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .ToList();

        if (!sections.Any())
        {
            return string.Empty;
        }

        var firstParts = sections[0]
            .Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(x => !IsGenericCartOption(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        var cleanSections = new List<string>();

        if (firstParts.Any())
        {
            cleanSections.Add(string.Join(" / ", firstParts));
        }

        cleanSections.AddRange(sections
            .Skip(1)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase));

        return string.Join(" | ", cleanSections);
    }

    private static bool IsGenericCartOption(string value)
    {
        var normalized = value.Trim().ToLowerInvariant();
        return normalized is "standart" or "standard" or "varsayilan" or "varsayılan";
    }
}

<!-- Breadcrumb -->
<div class="bg-[#F8FAFC] border-b border-slate-200 py-3.5">
    <div class="container mx-auto px-4 flex items-center gap-2 text-xs text-slate-500">
        <a href="/" class="hover:text-[#00A4D3] transition-colors">Ana Sayfa</a>
        <span>/</span>
        <span class="text-slate-900 font-semibold">Sepetim</span>
    </div>
</div>

<div class="container mx-auto px-4 py-10">
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <h1 class="font-serif text-3xl font-bold text-slate-900 mb-1">Sepetim</h1>
            <p class="text-xs text-slate-500">@Model.Count ürün sepette</p>
        </div>
        @if (Model.Any())
        {
            <form method="post" action="/Sepet/Temizle" onsubmit="return confirm('Sepetinizdeki tüm ürünler kaldırılacak. Devam etmek istiyor musunuz?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-xl border border-red-200 bg-white px-4 py-2 text-xs font-bold uppercase tracking-wider text-red-600 transition-colors hover:border-red-300 hover:bg-red-50">
                    <i class="fas fa-trash-alt text-[11px]"></i>
                    Sepeti Boşalt
                </button>
            </form>
        }
    </div>

    @if (TempData["SepetBasari"] != null)
    {
        <div class="mb-6 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
            @TempData["SepetBasari"]
        </div>
    }
    @if (TempData["SepetHata"] != null)
    {
        <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            @TempData["SepetHata"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-24">
            <i class="fas fa-shopping-bag fa-4x text-slate-300 mb-6"></i>
            <h3 class="font-serif text-2xl font-bold text-slate-900 mb-3">Sepetiniz boş</h3>
            <p class="text-sm text-slate-500 mb-8 max-w-sm mx-auto">
                Koleksiyonumuzu keşfedin ve yaşam alanlarınıza özel bir dokunuş ekleyin.
            </p>
            <a href="/Urun" class="inline-block bg-[#E30613] hover:bg-[#DC2626] text-white px-8 py-3.5 text-xs font-bold tracking-widest uppercase rounded-xl shadow-md transition-colors">
                Alışverişe Başla
            </a>
        </div>
    }
    else
    {
        <div class="flex flex-col lg:flex-row gap-8">
            <!-- Ürün Listesi -->
            <div class="flex-1 space-y-4">
                @foreach (var item in Model)
                {
                    var optionLabel = FormatCartOptionLabel(item.SecenekAdi);

                    <article class="bg-white border border-slate-200 rounded-xl p-4 flex gap-4 relative shadow-2xs">
                        <!-- Sil Butonu -->
                        <form method="post" action="/Sepet/Sil" class="absolute right-3 top-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="sepetItemId" value="@item.Id" />
                            <button type="submit" class="w-8 h-8 flex items-center justify-center text-slate-400 hover:text-red-500 transition-colors rounded-full hover:bg-red-50" title="Ürünü kaldır">
                                <i class="fas fa-times text-xs"></i>
                            </button>
                        </form>

                        <!-- Ürün Görseli -->
                        <a href="/Urun/Detay/@item.UrunId" class="flex-shrink-0 w-24 h-24 bg-[#F8FAFC] border border-slate-200 rounded-xl overflow-hidden block">
                            <img src="@item.UrunResimUrl" class="w-full h-full object-cover" alt="@item.UrunBaslik" loading="lazy" decoding="async" />
                        </a>

                        <!-- Ürün Bilgisi -->
                        <div class="flex-1 min-w-0 pr-6">
                            <a href="/Urun/Detay/@item.UrunId" class="font-bold text-sm text-slate-900 hover:text-[#00A4D3] transition-colors line-clamp-2 block mb-1">
                                @item.UrunBaslik
                            </a>
                            @if (!string.IsNullOrWhiteSpace(optionLabel))
                            {
                                <span class="text-xs font-semibold text-[#00A4D3] bg-sky-50 border border-sky-200 px-2.5 py-0.5 rounded-full inline-block">@optionLabel</span>
                            }

                            <div class="mt-3">
                                <form method="post" action="/Sepet/NotGuncelle" class="flex flex-col gap-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="sepetItemId" value="@item.Id" />
                                    <label class="text-[10px] uppercase tracking-wider text-slate-400 font-bold">Not / Özel İstek</label>
                                    <textarea name="musteriNotu"
                                             rows="2"
                                             maxlength="500"
                                             placeholder="Özel ölçü, renk tercihi, yazı isteği..."
                                             class="w-full border border-slate-200 rounded-xl px-3 py-2 text-xs text-slate-900 bg-[#F8FAFC] focus:ring-2 focus:ring-[#00A4D3] focus:border-[#00A4D3] focus:outline-none resize-none placeholder:text-slate-400">@item.MusteriNotu</textarea>
                                    @if (!string.IsNullOrWhiteSpace(item.MusteriNotu))
                                    {
                                        <div class="rounded-xl border border-sky-200 bg-sky-50 px-2.5 py-1 text-[10px] text-slate-700">
                                            Kaydedilen not: @item.MusteriNotu
                                        </div>
                                    }
                                    <div class="flex items-center justify-between">
                                        <span class="text-[9px] text-slate-400">En fazla 500 karakter</span>
                                        <button type="submit" class="text-[10px] text-[#00A4D3] hover:text-[#0284C7] transition-colors font-bold">
                                            <i class="fas fa-save mr-1"></i>Kaydet
                                        </button>
                                    </div>
                                </form>
                            </div>

                            <div class="flex items-center justify-between mt-3">
                                <!-- Adet Kontrol -->
                                <div class="flex items-center border border-slate-200 rounded-xl overflow-hidden bg-white shadow-2xs">
                                    @if (item.Adet > 1)
                                    {
                                        <form method="post" action="/Sepet/AdetGuncelle">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="sepetItemId" value="@item.Id" />
                                            <input type="hidden" name="yeniAdet" value="@(item.Adet - 1)" />
                                            <button type="submit" class="w-8 h-8 flex items-center justify-center text-slate-600 hover:bg-slate-100 transition-colors text-xs font-bold">
                                                <i class="fas fa-minus"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" action="/Sepet/Sil">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="sepetItemId" value="@item.Id" />
                                            <button type="submit" class="w-8 h-8 flex items-center justify-center text-red-500 hover:bg-red-50 transition-colors text-xs">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    }
                                    <span class="w-8 h-8 flex items-center justify-center text-sm font-bold text-slate-900 border-x border-slate-200">@item.Adet</span>
                                    <form method="post" action="/Sepet/AdetGuncelle">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="sepetItemId" value="@item.Id" />
                                        <input type="hidden" name="yeniAdet" value="@(item.Adet + 1)" />
                                        <button type="submit" class="w-8 h-8 flex items-center justify-center text-slate-600 hover:bg-slate-100 transition-colors text-xs font-bold">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    </form>
                                </div>
                                <!-- Fiyat -->
                                <span class="font-extrabold text-[#E30613] text-base">₺@item.Toplam.ToString("N2")</span>
                            </div>
                        </div>
                    </article>
                }

                @* Tamamlayıcı Ürünler (Cross-Selling) *@
                @if (ViewBag.TamamlayiciUrunler != null && ((List<KanvasProje.Core.Varliklar.Urun>)ViewBag.TamamlayiciUrunler).Any())
                {
                    var tamamlayiciList = (List<KanvasProje.Core.Varliklar.Urun>)ViewBag.TamamlayiciUrunler;
                    <div class="pt-8 mt-12 border-t border-slate-200">
                        <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Sepetinize Özel Seçimler</h3>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                            @foreach (var urun in tamamlayiciList)
                            {
                                var defaultSecenek = urun.UrunSecenek?
                                    .OrderByDescending(x => x.VarsayilanMi)
                                    .ThenBy(x => x.Sira)
                                    .FirstOrDefault(x => x.SatinAlinabilirMi)
                                    ?? urun.UrunSecenek?.FirstOrDefault();
                                    
                                var gorsel = !string.IsNullOrWhiteSpace(urun.AnaGorselUrl)
                                    ? urun.AnaGorselUrl
                                    : urun.UrunResimleri?.OrderBy(r => r.Sira).FirstOrDefault()?.ResimYolu;
                                    
                                var urunUrl = "/Urun/Detay/" + (string.IsNullOrEmpty(urun.Slug) ? (KanvasProje.Core.Helpers.SlugHelper.GenerateSlug(urun.Baslik) + "-" + urun.Id) : urun.Slug + "-" + urun.Id);

                                <div class="bg-white border border-slate-200 rounded-xl p-3 flex flex-col justify-between group shadow-2xs">
                                    <div>
                                        <a href="@urunUrl" class="block relative aspect-square overflow-hidden bg-[#F8FAFC] rounded-lg mb-3 flex items-center justify-center p-2">
                                            @if (!string.IsNullOrWhiteSpace(gorsel))
                                            {
                                                <img src="@gorsel" alt="@urun.Baslik" class="max-h-full max-w-full object-contain transition-transform duration-500 group-hover:scale-105" loading="lazy" decoding="async" />
                                            }
                                            else
                                            {
                                                <div class="flex h-full w-full items-center justify-center text-slate-300">
                                                    <i class="fas fa-image fa-2x"></i>
                                                </div>
                                            }
                                        </a>
                                        <a href="@urunUrl" class="block">
                                            <h4 class="text-xs font-bold tracking-wide text-slate-800 hover:text-[#00A4D3] transition-colors line-clamp-2 mb-1 min-h-[32px]">@urun.Baslik</h4>
                                        </a>
                                        <p class="text-xs font-extrabold text-[#E30613] mb-3">@urun.EtkinFiyat.ToString("N0") TL</p>
                                    </div>

                                    @if (defaultSecenek != null)
                                    {
                                        <button type="button" onclick="quickAddToCart(@urun.Id, @defaultSecenek.Id)" class="w-full bg-sky-50 text-[#00A4D3] text-[10px] uppercase tracking-wider py-2 rounded-xl hover:bg-[#00A4D3] hover:text-white transition-colors font-bold">
                                            Sepete Ekle
                                        </button>
                                    }
                                    else
                                    {
                                        <a href="@urunUrl" class="w-full bg-sky-50 text-[#00A4D3] text-center text-[10px] uppercase tracking-wider py-2 rounded-xl hover:bg-[#00A4D3] hover:text-white transition-colors font-bold">
                                            İncele
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <script>
                function quickAddToCart(urunId, secenekId) {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                    const params = new URLSearchParams();
                    params.append('UrunId', urunId);
                    if (secenekId) params.append('SecenekId', secenekId);
                    params.append('Adet', '1');
                    
                    fetch('/Sepet/Ekle?' + params.toString(), {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            if (window.showToast) {
                                window.showToast('Ürün başarıyla eklendi.', 'success');
                            }
                            setTimeout(() => {
                                window.location.reload();
                            }, 800);
                        } else {
                            if (window.showToast) {
                                window.showToast(data.message || 'Ürün eklenemedi.', 'error');
                            } else {
                                alert(data.message || 'Ürün eklenemedi.');
                            }
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        if (window.showToast) {
                            window.showToast('Bağlantı hatası oluştu.', 'error');
                        } else {
                            alert('Bağlantı hatası');
                        }
                    });
                }
            </script>

            <!-- Sipariş Özeti -->
            <aside class="lg:w-80 flex-shrink-0">
                <div class="bg-white border border-slate-200 rounded-2xl p-6 sticky top-28 shadow-sm">
                    <h2 class="font-serif text-lg font-bold text-slate-900 mb-5 pb-3 border-b border-slate-200">Sipariş Özeti</h2>

                    @if (kargoBedeli > 0)
                    {
                        var kalan = ucretsizKargoLimiti - (sepetToplami - indirimTutari);
                        if (kalan > 0)
                        {
                            <div class="mb-4 bg-sky-50 border border-sky-200 rounded-xl p-3 text-xs text-[#00A4D3]">
                                <i class="fas fa-truck me-1"></i>Ücretsiz kargo için sepetinize <strong>₺@kalan.ToString("N2")</strong> değerinde ürün daha ekleyin!
                            </div>
                        }
                    }

                    <div class="space-y-3 text-sm mb-5">
                        <div class="flex justify-between text-slate-600">
                            <span>Ara Toplam</span>
                            <span>₺@sepetToplami.ToString("N2")</span>
                        </div>
                        @if (indirimTutari > 0)
                        {
                            <div class="flex justify-between text-emerald-600 font-semibold">
                                <span><i class="fas fa-tag mr-1 text-xs"></i>İndirim</span>
                                <span>-₺@indirimTutari.ToString("N2")</span>
                            </div>
                        }
                        <div class="flex justify-between text-slate-600">
                            <span>Kargo</span>
                            @if (kargoBedeli == 0)
                            {
                                <span class="text-emerald-600 font-bold">Ücretsiz</span>
                            }
                            else
                            {
                                <span class="text-slate-900 font-bold">₺@kargoBedeli.ToString("N2")</span>
                            }
                        </div>

                        <!-- Kargo Firması Seçimi -->
                        @if (ViewBag.KargoFirmalari != null && ((List<KanvasProje.Core.Varliklar.KargoFirmasi>)ViewBag.KargoFirmalari).Any())
                        {
                            var kargoList = (List<KanvasProje.Core.Varliklar.KargoFirmasi>)ViewBag.KargoFirmalari;
                            <div class="py-2 border-t border-dashed border-slate-200">
                                <form id="kargoSecimForm" method="post" action="/Sepet/SecilenKargoGuncelle" class="flex flex-col gap-1">
                                    @Html.AntiForgeryToken()
                                    <label class="text-[10px] uppercase tracking-wider text-slate-400 font-bold">Kargo Firması Seçin</label>
                                    <select name="kargoId" onchange="this.form.submit()" class="w-full border border-slate-200 rounded-xl px-2.5 py-1.5 text-xs text-slate-800 bg-[#F8FAFC] focus:ring-2 focus:ring-[#00A4D3] focus:outline-none">
                                        @foreach (var kargo in kargoList)
                                        {
                                            bool isSelected = kargo.Id == ViewBag.SecilenKargoId;
                                            decimal kUcreti = (sepetToplami - indirimTutari) >= ucretsizKargoLimiti ? 0 : kargo.Fiyat;
                                            string ucretMetni = kUcreti == 0 ? "Ücretsiz" : $"₺{kUcreti:N2}";
                                            <option value="@kargo.Id" selected="@isSelected">
                                                @kargo.Ad (@ucretMetni)
                                            </option>
                                        }
                                    </select>
                                </form>
                            </div>
                        }

                        <div class="flex justify-between text-slate-900 font-bold text-base pt-3 border-t border-slate-200">
                            <span>Toplam</span>
                            <span class="text-xl font-black text-[#E30613]">₺@genelToplam.ToString("N2")</span>
                        </div>
                    </div>

                    <!-- Kupon -->
                    @if (ViewBag.KuponKodu != null)
                    {
                        <div class="flex items-center justify-between bg-emerald-50 border border-emerald-200 rounded-xl px-3 py-2 mb-4 text-sm text-emerald-700 font-semibold">
                            <span><i class="fas fa-check-circle mr-1"></i>@ViewBag.KuponKodu</span>
                            <form method="post" action="/Sepet/KuponKaldir">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="text-red-400 hover:text-red-600"><i class="fas fa-times"></i></button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <form action="/Sepet/KuponUygula" method="post" class="flex mb-4">
                            @Html.AntiForgeryToken()
                            <input type="text" name="kuponKodu" placeholder="İndirim kodu" required
                                   class="flex-1 border border-slate-200 border-r-0 rounded-l-xl px-3 py-2 text-xs focus:ring-1 focus:ring-[#00A4D3] outline-none bg-[#F8FAFC]" />
                            <button type="submit" class="bg-sky-50 border border-slate-200 rounded-r-xl px-4 py-2 text-xs hover:bg-sky-100 transition-colors text-[#00A4D3] font-bold">
                                Uygula
                            </button>
                        </form>
                    }

                    <a asp-controller="Siparis" asp-action="Odeme"
                       class="w-full bg-[#E30613] hover:bg-[#DC2626] text-white text-center text-xs tracking-wider uppercase py-4 rounded-xl block transition-all font-bold shadow-md hover:shadow-lg active:scale-[0.98]">
                        <i class="fas fa-lock mr-2 text-[10px]"></i>Ödemeye Geç
                    </a>
                    <p class="text-center text-[10px] text-slate-400 mt-3">
                        <i class="fas fa-shield-alt mr-1 text-[#00A4D3]"></i>256-bit SSL ile güvenli ödeme
                    </p>
                </div>
            </aside>
        </div>

        <!-- Mobil Ödeme Çubuğu -->
        <div class="fixed bottom-16 md:bottom-0 left-0 right-0 z-30 lg:hidden bg-white border-t border-slate-200 px-4 py-3 flex items-center justify-between shadow-lg">
            <div>
                <div class="text-[10px] text-slate-400 uppercase tracking-wider font-semibold">Toplam</div>
                <div class="font-extrabold text-[#E30613] text-lg">₺@genelToplam.ToString("N2")</div>
            </div>
            <a asp-controller="Siparis" asp-action="Odeme"
               class="bg-[#E30613] hover:bg-[#DC2626] text-white text-xs font-bold tracking-wider uppercase px-6 py-3 rounded-xl shadow-md transition-colors">
                <i class="fas fa-lock mr-1 text-[10px]"></i>Ödemeye Geç
            </a>
        </div>
    }
</div>
