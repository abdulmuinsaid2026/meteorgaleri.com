@model ErrorViewModel
@{
    ViewData["Title"] = "Bir Hata Oluştu";
}

<div class="min-h-[75vh] flex items-center justify-center py-16 px-4 bg-[#F8FAFC]">
    <div class="w-full max-w-xl text-center bg-white border border-slate-200/80 rounded-3xl p-8 sm:p-12 shadow-sm">
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-red-50 text-[#E30613] mb-6 text-3xl">
            <i class="fas fa-triangle-exclamation"></i>
        </div>
        <h1 class="font-heading text-2xl md:text-3xl font-extrabold text-slate-900 mb-3">Beklenmeyen Bir Hata Oluştu</h1>
        <p class="text-sm text-slate-600 mb-6 leading-relaxed max-w-md mx-auto">
            İşleminiz sırasında geçici bir sorun meydana geldi. Lütfen sayfayı yenileyin veya birkaç dakika sonra tekrar deneyin.
        </p>

        @if (Model?.ShowRequestId == true)
        {
            <p class="text-xs text-slate-400 mb-6 font-mono">
                İstek No: @Model.RequestId
            </p>
        }

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="/" class="w-full sm:w-auto bg-[#00A4D3] text-white px-8 py-3.5 text-xs font-bold tracking-wider uppercase rounded-xl hover:bg-[#0284C7] transition-all shadow-md shadow-sky-500/20">
                Ana Sayfaya Dön
            </a>
            <a href="/Kurumsal/Iletisim" class="w-full sm:w-auto bg-white border border-slate-300 text-slate-800 px-8 py-3.5 text-xs font-bold tracking-wider uppercase rounded-xl hover:bg-slate-50 transition-all">
                Bize Ulaşın
            </a>
        </div>
    </div>
</div>
