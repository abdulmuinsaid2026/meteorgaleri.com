@model KanvasProje.Core.Varliklar.Urun
@inject KanvasProje.Service.Services.ISiteSettingsService SiteSettingsService

@{
    if (Model == null) return;

    var siteSettings = SiteSettingsService.GetSettings();
    var currencySymbol = string.IsNullOrWhiteSpace(siteSettings.ParaBirimi) ? "TL" : siteSettings.ParaBirimi;
    
    var gorsel = !string.IsNullOrWhiteSpace(Model.AnaGorselUrl)
        ? Model.AnaGorselUrl
        : Model.UrunResimleri?.OrderBy(r => r.Sira).FirstOrDefault()?.ResimYolu;

    var productUrl = "/Urun/Detay/" + (string.IsNullOrEmpty(Model.Slug)
        ? (KanvasProje.Core.Helpers.SlugHelper.GenerateSlug(Model.Baslik) + "-" + Model.Id)
        : Model.Slug + "-" + Model.Id);

    var indirimliMi = Model.IndirimVarMi && Model.Fiyat > Model.EtkinFiyat;
    var indirimYuzdesi = indirimliMi ? (int)Math.Round((1.0 - ((double)Model.EtkinFiyat / (double)Model.Fiyat)) * 100) : 0;

    var katSlug = Model.Kategori?.Slug?.ToLowerInvariant() ?? "";
    var katAd = Model.Kategori?.Ad?.ToLowerInvariant() ?? "";
    var baslik = Model.Baslik?.ToLowerInvariant() ?? "";
    
    string fallbackGorsel;
    if (katSlug.Contains("ayna") || katAd.Contains("ayna") || baslik.Contains("ayna"))
    {
        var aynaPool = new[] { "/img/categories/ayna.jpg", "/img/products/kisiye-ozel-instagram-tasarimli-duvar-aynasi-isimli-ve-fotografli-ayna-1.webp" };
        fallbackGorsel = aynaPool[Math.Abs(Model.Id) % aynaPool.Length];
    }
    else if (katSlug.Contains("kesme") || katAd.Contains("kesme") || baslik.Contains("kesme") || baslik.Contains("tahta"))
    {
        var kesmePool = new[] {
            "/img/products/renkli-kokteyl-ve-tropikal-desenli-temperli-cam-kesme-tahtasi-20x30-cm-hijyenik-ve-dayanikli-1.webp",
            "/img/products/renkli-tropikal-meyve-desenli-temperli-cam-kesme-tahtasi-20x30-cm-hijyenik-ve-modern-mutfak-aksesuari-1.webp",
            "/img/products/gri-mermer-desenli-temperli-cam-kesme-tahtasi-20x30-cm-hijyenik-ve-dayanikli-mutfak-aksesuari-1.webp",
            "/img/products/pastel-mavi-bej-desenli-temperli-cam-kesme-tahtasi-20x30-cm-hijyenik-ve-sik-mutfak-aksesuari-1.webp",
            "/img/categories/cam-kesme-tahtasi.jpg"
        };
        fallbackGorsel = kesmePool[Math.Abs(Model.Id) % kesmePool.Length];
    }
    else if (katSlug.Contains("duvar") || katAd.Contains("duvar") || baslik.Contains("duvar kağıdı"))
    {
        fallbackGorsel = "/img/categories/duvar-kagidi.jpg";
    }
    else
    {
        var tabloPool = new[] {
            "/img/categories/cam-tablo.jpg",
            "/img/products/urgup-ucan-balon--1.webp",
            "/img/products/kabe--1.webp",
            "/img/products/altin-detayli-kugu-yatay-temperli-cam-tablo-luks-floral-duvar-sanati-modern-salon-dekoru-1.webp",
            "/img/products/cicekler-arasinda-tavus-kusu-temperli-cam-tablo-zarif-ve-luks-cam-duvar-sanati-1.webp",
            "/img/products/altin-gunesli-yasam-agaci-temperli-cam-tablo-modern-ve-anlamli-cam-duvar-sanati-1.webp",
            "/img/products/kis-manzarali-beyaz-cicekler-temperli-cam-tablo-zarif-ve-huzur-veren-cam-duvar-sanati-1.webp",
            "/img/banner/slider-1.webp",
            "/img/banner/slider-2.webp",
            "/img/banner/slider-3.webp"
        };
        fallbackGorsel = tabloPool[Math.Abs(Model.Id) % tabloPool.Length];
    }

    var goruntulenecekGorsel = !string.IsNullOrWhiteSpace(gorsel) ? gorsel : fallbackGorsel;
}

<article class="group relative flex flex-col h-full bg-white rounded-2xl border border-[#EAE3D2] p-2.5 sm:p-3 hover:border-[#01ADD3]/60 hover:shadow-[0_12px_32px_rgba(27,42,74,0.08)] hover:-translate-y-1 transition-all duration-300">
    <!-- Görsel Çerçevesi -->
    <div class="relative w-full aspect-square rounded-xl overflow-hidden bg-gradient-to-b from-[#FAF8F5] to-[#F3EEE5] flex items-center justify-center p-3 mb-2.5 border border-[#F0E8DC] shadow-[inset_0_1px_4px_rgba(0,0,0,0.02)]">
        <a href="@productUrl" class="block w-full h-full flex items-center justify-center">
            <img src="@goruntulenecekGorsel" 
                 alt="@Model.Baslik" 
                 class="max-h-full max-w-full object-contain filter drop-shadow-sm group-hover:scale-108 transition-transform duration-700 ease-out select-none" 
                 loading="lazy" 
                 decoding="async"
                 onerror="this.onerror=null; this.src='@fallbackGorsel';" />
        </a>

        <!-- Rozetler (Badges) -->
        <div class="absolute top-2 left-2 flex flex-col gap-1 z-10 pointer-events-none">
            @if (Model.YeniUrunMu)
            {
                <span class="bg-[#01ADD3] text-white text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full shadow-xs">Yeni</span>
            }
            @if (indirimliMi && indirimYuzdesi > 0)
            {
                <span class="bg-[#E7151E] text-white text-[9px] font-bold tracking-wide px-2 py-0.5 rounded-full shadow-xs">-%@indirimYuzdesi</span>
            }
        </div>

        <!-- Favori Butonu -->
        <button type="button" 
                onclick="window.toggleFavori(this, @Model.Id)" 
                class="absolute top-2 right-2 w-8 h-8 rounded-full bg-white/95 hover:bg-[#01ADD3] text-[#1B2A4A] hover:text-white backdrop-blur-md shadow-xs border border-[#EAE3D2] flex items-center justify-center transition-all duration-200 hover:scale-110 active:scale-90 z-20 cursor-pointer" 
                title="Favorilere Ekle">
            <i class="far fa-heart text-xs"></i>
        </button>

        <!-- Hover İncele Aksiyonu (Desktop) -->
        <a href="@productUrl" 
           class="absolute inset-x-2.5 bottom-2.5 opacity-0 group-hover:opacity-100 translate-y-2 group-hover:translate-y-0 transition-all duration-300 hidden sm:flex items-center justify-center py-2 bg-[#1B2A4A]/90 hover:bg-[#01ADD3] text-white text-[11px] font-semibold tracking-wider uppercase rounded-lg backdrop-blur-sm shadow-md">
            <span>İncele</span>
            <i class="fas fa-arrow-right ml-1.5 text-[9px]"></i>
        </a>
    </div>

    <!-- Metin ve Fiyat Alanı -->
    <div class="flex flex-col flex-grow justify-between px-0.5">
        <div>
            <h3 class="font-serif text-[11.5px] sm:text-xs md:text-sm font-semibold text-[#1B2A4A] leading-[1.35] line-clamp-3 sm:line-clamp-2 min-h-[2.85rem] sm:min-h-[2.4rem] mb-2 group-hover:text-[#01ADD3] transition-colors" title="@Model.Baslik">
                <a href="@productUrl" title="@Model.Baslik">@Model.Baslik</a>
            </h3>
        </div>
        <div class="pt-2 border-t border-[#F5E6C8]/60 flex items-baseline justify-between gap-1">
            <div class="flex items-baseline gap-1.5 flex-wrap">
                <span class="text-sm sm:text-base font-bold text-[#1B2A4A]">@Model.EtkinFiyat.ToString("N0") @currencySymbol</span>
                @if (indirimliMi)
                {
                    <span class="text-[11px] text-[#8c827a] line-through font-normal">@Model.Fiyat.ToString("N0") @currencySymbol</span>
                }
            </div>
            <span class="text-[9px] font-medium text-emerald-800 bg-emerald-50 border border-emerald-200/60 px-1.5 py-0.5 rounded-full whitespace-nowrap">
                Ücretsiz Kargo
            </span>
        </div>
    </div>
</article>
