@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using KanvasProje.Core.Helpers
@using KanvasProje.Core.Varliklar
@using KanvasProje.Web.Extensions
@using KanvasProje.Web.Models
@using System.Globalization
@using System.Text
@inject SignInManager<KanvasProje.Core.Varliklar.AppUser> SignInManager
@inject UserManager<KanvasProje.Core.Varliklar.AppUser> UserManager
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject KanvasProje.Core.Interfaces.ISepetService SepetService
@inject KanvasProje.Data.KanvasDbContext DbContext
@inject KanvasProje.Service.Services.ISiteSettingsService SiteSettingsService

@{
    var userId = UserManager.GetUserId(User);
    var sessionId = HttpContextAccessor.HttpContext?.Session.Id ?? string.Empty;
    var sepetCount = await SepetService.GetSepetUrunSayisiAsync(userId, sessionId);
    var siteSettings = SiteSettingsService.GetSettings();
    var brandName = string.IsNullOrWhiteSpace(siteSettings.MarkaAdi) ? siteSettings.SiteAdi : siteSettings.MarkaAdi;
    var pageTitle = ViewData["Title"]?.ToString();
    var seoTitle = ViewData["SeoTitle"]?.ToString();
    var layoutTitle = !string.IsNullOrWhiteSpace(seoTitle)
        ? seoTitle
        : (string.IsNullOrWhiteSpace(pageTitle) ? brandName : $"{pageTitle} - {brandName}");
    var metaDescription = ViewData["MetaDescription"]?.ToString();
    if (string.IsNullOrWhiteSpace(metaDescription))
    {
        metaDescription = string.IsNullOrWhiteSpace(siteSettings.MetaDescription)
            ? (string.IsNullOrWhiteSpace(siteSettings.SiteAciklamasi) ? "Profesyonel premium dekorasyon ürünleri." : siteSettings.SiteAciklamasi)
            : siteSettings.MetaDescription;
    }
    var metaKeywords = ViewData["MetaKeywords"]?.ToString();
    var logoUrl = string.IsNullOrWhiteSpace(siteSettings.SiteLogoUrl) ? "/logo_svg.svg" : siteSettings.SiteLogoUrl;
var touchIconUrl = "/favicon.svg";
    var faviconUrl = string.IsNullOrWhiteSpace(siteSettings.FaviconUrl) ? "/favicon.svg" : siteSettings.FaviconUrl;
    var siteUrl = SiteSettingsService.BuildAbsoluteUrl(string.Empty);
    var viewOgImage = ViewData["OgImage"]?.ToString();
    var ogImage = !string.IsNullOrWhiteSpace(viewOgImage)
        ? SiteSettingsService.BuildAbsoluteUrl(viewOgImage)
        : (string.IsNullOrWhiteSpace(siteSettings.VarsayilanSosyalPaylasimGorseliUrl)
            ? SiteSettingsService.BuildAbsoluteUrl(logoUrl)
            : SiteSettingsService.BuildAbsoluteUrl(siteSettings.VarsayilanSosyalPaylasimGorseliUrl));
    var currentPath = HttpContextAccessor.HttpContext?.Request.Path.Value ?? "/";
    var currentQuery = HttpContextAccessor.HttpContext?.Request.QueryString.Value ?? string.Empty;
    var currentUrl = SiteSettingsService.BuildAbsoluteUrl($"{currentPath}{currentQuery}");
    var canonicalUrl = ViewData["CanonicalUrl"]?.ToString();
    canonicalUrl = string.IsNullOrWhiteSpace(canonicalUrl)
        ? currentUrl
        : SiteSettingsService.BuildAbsoluteUrl(canonicalUrl);
    var ogType = string.IsNullOrWhiteSpace(ViewData["OgType"]?.ToString()) ? "website" : ViewData["OgType"]!.ToString();
    var topBarPrimary = string.IsNullOrWhiteSpace(siteSettings.UstBarMesaji)
        ? $"{siteSettings.UcretsizKargoLimiti:N0} {siteSettings.ParaBirimi} ÜZERİ ÜCRETSİZ KARGO"
        : siteSettings.UstBarMesaji.ToUpper();
    var trustMessages = new List<string>
    {
        topBarPrimary,
        "GÜVENLİ ÖDEME",
        "KREDİ KARTI İLE ÖDEME",
        "HIZLI ÜRETİM",
        "ÖZENLİ PAKETLEME",
        "TÜRKİYE GENELİ KARGO",
        $"{siteSettings.IadeHakkiGun} GÜN KOLAY İADE",
        "ÜRETİCİ FİRMA GÜVENCESİ"
    };

    if (!string.IsNullOrWhiteSpace(siteSettings.KampanyaMesaji))
    {
        trustMessages.Insert(1, siteSettings.KampanyaMesaji.ToUpper());
    }

    if (!string.IsNullOrWhiteSpace(siteSettings.WhatsappNumarasi))
    {
        trustMessages.Add("WHATSAPP DESTEK");
    }

    trustMessages = trustMessages
        .Where(message => !string.IsNullOrWhiteSpace(message))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();

    var tumKategoriler = await DbContext.Kategoriler
        .Where(k => k.AktifMi && !k.SilindiMi)
        .OrderBy(k => k.Sira)
        .ThenBy(k => k.Ad)
        .ToListAsync();

    string NormalizeCategoryKey(string? value)
    {
        var normalized = (value ?? string.Empty)
            .Trim()
            .ToLowerInvariant()
            .Replace("ı", "i")
            .Replace("İ", "i")
            .Replace("&", "and")
            .Normalize(NormalizationForm.FormD);

        var builder = new StringBuilder(normalized.Length);
        foreach (var character in normalized)
        {
            if (CharUnicodeInfo.GetUnicodeCategory(character) != UnicodeCategory.NonSpacingMark)
            {
                builder.Append(character);
            }
        }

        return builder.ToString().Normalize(NormalizationForm.FormC);
    }

    string GetCategoryMenuImage(Kategori category)
    {
        var configured = !string.IsNullOrWhiteSpace(category.GorselUrl) ? category.GorselUrl : category.BannerUrl;
        if (!string.IsNullOrWhiteSpace(configured))
        {
            var keyForOverride = NormalizeCategoryKey(category.Ad);
            if (keyForOverride != "ataturk kosesi")
            {
                return configured;
            }
        }

        return NormalizeCategoryKey(category.Ad) switch
        {
            "ataturk kosesi" or "ataturk ve turkiye" => "/img/products/7-parcali-kanvas-tablo-tarihi-liderler-mustafa-kemal-ataturk-portre-serisi-ana.webp",
            "islami sanat and hat" or "dini ve hat sanati" => "/img/products/35-besmele-lila-allah-ve-muhammed-yazili-kanvas-tablo-ana.webp",
            "osmanli ve tugra" => "/img/products/5-parca-tugra-allah-muhammed-kanvas-tablo-ana.webp",
            "dunya klasikleri" or "klasik eserler" => "/img/products/ademin-yaratilisi-the-creation-of-adam-kanvas-tablosu-ana.webp",
            "modern and soyut" or "soyut ve sanatsal" or "farkli tasarimlar" => "/img/products/3-parcali-renkli-gokkusagi-kanvas-tablo-ana.webp",
            "sehir manzaralari" or "sehir ve mimari" => "/img/products/i-stanbul-bogazici-koprusu-kanvas-tablosu-ana.webp",
            "parcali tablolar" or "panoramik tablolar" => "/img/products/5-parcali-manzarali-sisli-orman-kanvas-tablo-ana.webp",
            "manzara temali" => "/img/products/5-parcali-manzarali-sisli-orman-kanvas-tablo-ana.webp",
            "hayvanlar alemi" => "/img/products/2-beyaz-kurt-ve-ay-manzarali-5-parca-kanvas-tablo-ana.webp",
            "araba ve araclar" => "/img/products/bmw-e30-araba-5-parca-kanvas-tablo-ana.webp",
            "cocuk odasi" => "/img/products/cocuk-odasi-i-cin-dekoratif-zebra-ve-fil-resimli-kanvas-tablo-ana.webp",
            "nu sanat" or "kadin temali" => "/img/products/3-lu-afrikali-kadin-kanvas-tablo-ana.webp",
            "unluler ve sinema" => "/img/products/gitar-ve-sehir-sliuetli-kanvas-tablo-ana.webp",
            "yiyecek ve icecek" => "/img/products/cicekli-vintage-fincan-ve-kahve-temali-5-parcali-kanvas-tablo-ana.webp",
            "ask ve romantizm" => "/img/products/acik-pembe-renkli-romantik-guller-kanvas-tablo-ana.webp",
            "taraftar kosesi" => "/img/products_yeni/dalgalanan-turk-bayragi-5-parca-kanvas-t-bc6a.jpg",
            "adalet ve hukuk" => "/img/products/adalet-ve-hukuk-resimli-kanvas-tablo-ana.webp",
            "cicekli ve dekoratif" => "/img/products/3-parca-orkide-cicekli-kanvas-tablo-ana.webp",
            _ => configured ?? "/img/banner/slider-1.webp"
        };
    }
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@layoutTitle</title>
<link rel="icon" href="@faviconUrl" type="image/svg+xml">
    <link rel="apple-touch-icon" sizes="180x180" href="@touchIconUrl">
    <link rel="canonical" href="@canonicalUrl">
    <meta name="description" content="@metaDescription">
    @if (!string.IsNullOrWhiteSpace(metaKeywords))
    {
        <meta name="keywords" content="@metaKeywords">
    }
    <meta property="og:site_name" content="@brandName">
    <meta property="og:title" content="@layoutTitle">
    <meta property="og:description" content="@metaDescription">
    <meta property="og:type" content="@ogType">
    <meta property="og:url" content="@canonicalUrl">
    <meta property="og:image" content="@ogImage">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="@layoutTitle">
    <meta name="twitter:description" content="@metaDescription">
    <meta name="twitter:image" content="@ogImage">
    <meta name="google-site-verification" content="lp3CR7os7YE1Ow3TF8fJXcGIMjuxQHEq_GVJW2IsvvM" />

    <script>
        (function() {
            var origWarn = console.warn;
            console.warn = function() {
                if (arguments[0] && typeof arguments[0] === 'string' && arguments[0].indexOf('cdn.tailwindcss.com') !== -1) return;
                origWarn.apply(console, arguments);
            };
        })();
    </script>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link rel="stylesheet" href="~/css/storefront.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com" rel="preconnect"/>
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Source+Sans+3:wght@300;400;600&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style data-purpose="custom-fonts">
        body { font-family: 'Source Sans 3', 'Source Sans Pro', system-ui, sans-serif; color: #2E2721; padding: 0 !important; margin: 0 !important; background: #FAF8F5 !important; font-size: 14px; line-height: 1.6; }
        h1, h2, h3, h4, h5, h6, .font-serif { font-family: 'Playfair Display', Georgia, serif; }
        .text-xxs { font-size: 0.65rem; }
        nav a, button, .tracking-widest { letter-spacing: 0.1em; }
    </style>
    <style data-purpose="custom-utilities">
        .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .custom-scrollbar::-webkit-scrollbar { display: none; }
        .custom-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .trust-ticker-track { width: max-content; animation: trustTicker 34s linear infinite; }
        .trust-ticker:hover .trust-ticker-track { animation-play-state: paused; }
        @@keyframes trustTicker {
            from { transform: translateX(0); }
            to { transform: translateX(-50%); }
        }
@@media (prefers-reduced-motion: reduce) {
            .trust-ticker-track { animation: none; transform: translateX(0); }
        }
        
        /* Cart bounce animation */
        @@keyframes cartBounce {
            0% { transform: scale(1); }
            50% { transform: scale(1.5); }
            100% { transform: scale(1); }
        }
        .bounce-animation {
            animation: cartBounce 0.4s ease-out;
        }
        
        @@media (max-width: 767px) {
            /* Mobil alt navigasyon barı (mobile-bottom-nav) görünür ise WhatsApp butonunu yukarı kaydır */
            body:has(.mobile-bottom-nav:not([style*="display: none"])) .whatsapp-btn,
            body.has-bottom-nav .whatsapp-btn {
                bottom: 80px !important;
            }
        }
        
        /* Kategori menü geçişlerindeki titremenin/kapanmanın gecikme süresi ile önlenmesi */
        [data-category-dropdown] {
            transition: opacity 0.25s ease, visibility 0.25s ease !important;
            transition-delay: 0.15s !important;
        }
        .group:hover [data-category-dropdown] {
            transition-delay: 0s !important;
        }
    </style>
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-[#FAF8F5] overflow-x-hidden antialiased flex flex-col min-h-screen">
    <form id="globalAntiForgeryForm" class="hidden">
        @Html.AntiForgeryToken()
    </form>

<!-- BEGIN: AnnouncementBar -->
    @if (siteSettings.UstBarEtkin)
    {
        var tickerSpeed = siteSettings.UstBarHizi > 0 ? siteSettings.UstBarHizi : 34;
        <div class="trust-ticker relative z-50 overflow-hidden bg-[#241E1A] py-2 text-[11px] font-light tracking-[0.18em] text-[#FAF8F5] border-b border-[#3D332A]">
            <div class="trust-ticker-track flex items-center" style="animation-duration: @tickerSpeed.ToString("0", System.Globalization.CultureInfo.InvariantCulture)s;">
                @for (var repeat = 0; repeat < 2; repeat++)
                {
                    foreach (var message in trustMessages)
                    {
                        <span class="mx-6 flex shrink-0 items-center gap-2 whitespace-nowrap">
                            <i class="fas fa-gem text-[9px] text-[#C9A84C]"></i>
                            @message
                        </span>
                    }
                }
            </div>
        </div>
    }
    <!-- END: AnnouncementBar -->

<!-- BEGIN: MainHeader -->
    <header class="sticky top-0 z-[100] shadow-md">
        <!-- Top Main Bar (Espresso Bronze with Champagne Gold Accent Line) -->
        <div class="bg-[#2E2721] text-[#FAF8F5] border-b-2 border-[#C9A84C]">
            <div class="w-full max-w-[1440px] mx-auto px-4 sm:px-6 py-3 flex items-center justify-between relative">
                
                <!-- Mobile Left: Hamburger + Search Toggle -->
                <div class="flex md:hidden items-center gap-3 text-[#FAF8F5]">
                    <button aria-label="Menüyü aç" onclick="window.toggleMobileNav(true)" class="p-1.5 hover:text-[#C9A84C] transition-colors" id="mobileMenuBtn">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                    </button>
                    <button type="button" aria-label="Arama" onclick="window.toggleSearchBar()" class="p-1.5 hover:text-[#C9A84C] transition-colors" id="mobileSearchBtn">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                    </button>
                </div>

                <!-- Logo -->
                <a class="inline-flex flex-col items-center leading-none group text-center py-1" href="/" aria-label="@brandName" id="siteLogo">
                    <span class="font-serif text-2xl sm:text-[26px] md:text-[28px] tracking-[0.24em] text-[#FAF8F5] uppercase font-medium group-hover:text-[#E8D08D] transition-colors">METEOR GALERİ</span>
                    <span class="text-[8.5px] uppercase tracking-[0.42em] text-[#C9A84C] font-light mt-0.5">ART & WALL DECOR</span>
                </a>

                <!-- Desktop Search Bar (Centered Pill) -->
                <div class="hidden md:flex flex-1 max-w-[360px] lg:max-w-[440px] mx-6 lg:mx-8">
                    <form action="/Urun" method="get" class="relative w-full">
                        <input type="text" name="s" id="desktopSearchInput" placeholder="Tablo, eser veya koleksiyon ara..." autocomplete="off"
                               class="w-full bg-[#3D352E]/90 hover:bg-[#483E34] focus:bg-[#FAF8F5] text-sm text-[#FAF8F5] focus:text-[#2E2721] placeholder-[#A69B8F] focus:placeholder-[#8C8276] rounded-full px-4 pr-10 py-2 border border-[#4F443A] focus:border-[#C9A84C] focus:outline-none focus:ring-1 focus:ring-[#C9A84C] transition-all shadow-inner" />
                        <button type="submit" aria-label="Ara" class="absolute right-3.5 top-1/2 -translate-y-1/2 text-[#C9A84C] hover:text-white transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                        </button>
                    </form>
                    <!-- Fallback elements for legacy script compatibility -->
                    <div id="desktopSearchBar" class="hidden"></div>
                    <button type="button" id="desktopSearchBtn" class="hidden" aria-label="Arama"></button>
                    <button type="button" id="desktopSearchCloseBtn" class="hidden" aria-label="Kapat"></button>
                </div>

                <!-- Desktop / Mobile Icons (Right Side) -->
                <div class="flex items-center gap-3.5 sm:gap-5 text-[#FAF8F5]">
                    <!-- Account -->
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <a href="/Profil" aria-label="Hesabım" title="Hesabım" class="hover:text-[#C9A84C] transition-colors flex items-center gap-1.5">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                            <span class="hidden xl:inline text-[11px] uppercase tracking-wider font-light">Hesabım</span>
                        </a>
                    }
                    else
                    {
                        <a href="/Hesap/GirisYap" aria-label="Giriş Yap" title="Giriş Yap" class="hover:text-[#C9A84C] transition-colors flex items-center gap-1.5">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                            <span class="hidden xl:inline text-[11px] uppercase tracking-wider font-light">Giriş Yap</span>
                        </a>
                    }

                    <!-- Favoriler -->
                    <a href="/Favori" aria-label="Favoriler" title="Favoriler" class="hover:text-[#C9A84C] transition-colors relative">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" /></svg>
                    </a>

                    <!-- Sepet -->
                    <a href="/Sepet" aria-label="Sepet" class="hover:text-[#C9A84C] transition-colors relative flex items-center gap-2">
                        <div class="relative">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                            <span id="cartItemCount" class="absolute -top-1.5 -right-2 bg-[#C9A84C] text-[#2E2721] text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center shadow-xs">@sepetCount</span>
                        </div>
                        <span class="hidden xl:inline text-[11px] uppercase tracking-wider font-medium">Sepetim</span>
                    </a>
                </div>

            </div>
        </div>

        <!-- Sub-Nav Bar (Warm Sand / Ivory Category Bar) -->
        <div class="bg-[#FAF7F2] border-b border-[#E8E1D5] hidden md:block">
            <div class="w-full max-w-[1440px] mx-auto px-4 sm:px-6">
                <nav data-desktop-nav>
                    <ul class="flex justify-center items-center space-x-6 lg:space-x-8 text-[12px] tracking-[0.18em] text-[#2E2721] font-medium uppercase py-2.5" data-desktop-nav-list>
                        @foreach (var kategori in tumKategoriler.Where(x => x.ParentKategoriId == null).OrderBy(x => x.Sira).ThenBy(x => x.Ad))
                        {
                            var altKategoriler = tumKategoriler.Where(x => x.ParentKategoriId == kategori.Id).OrderBy(x => x.Sira).ToList();
                            var kategoriPreviewGorsel = GetCategoryMenuImage(kategori);
                            var kategoriPreviewMetin = !string.IsNullOrWhiteSpace(kategori.KisaAciklama)
                                ? kategori.KisaAciklama
                                : "Seçili koleksiyondaki ürünleri keşfedin.";
                            
                            <li class="relative group cursor-pointer hover:text-[#C9A84C] transition-colors py-1" data-category-menu-item>
                                <a href="/Urun?k=@kategori.Id" class="flex items-center gap-1.5 whitespace-nowrap">
                                    @kategori.Ad
                                    <i class="fas fa-chevron-down text-[9px] opacity-70 group-hover:rotate-180 transition-transform"></i>
                                </a>
                                
                                <!-- Dropdown Menü -->
                                <div class="absolute left-1/2 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-300 w-[min(820px,calc(100vw-32px))] z-[9999]" style="transform:translateX(-50%) translateZ(1px);isolation:isolate" data-category-dropdown>
                                    <div class="bg-[#FAF7F2] border border-[#DDD5C7] shadow-2xl rounded-sm p-6 ring-1 ring-black/5">
                                        <div class="mb-4 flex items-center justify-between border-b border-[#E8E1D5] pb-3">
                                            <div>
                                                <div class="font-serif text-lg normal-case tracking-normal text-[#2E2721]">@kategori.Ad</div>
                                                <div class="mt-1 text-[11px] font-light normal-case tracking-normal text-[#736B63]">@(altKategoriler.Any() ? "Alt kategoriler" : "Kategori detayı")</div>
                                            </div>
                                            <a href="/Urun?k=@kategori.Id" class="text-[11px] font-medium tracking-widest text-[#C9A84C] hover:text-[#2E2721] transition-colors">TÜMÜNÜ GÖR</a>
                                        </div>

                                        @if (altKategoriler.Any())
                                        {
                                            <div class="grid gap-6 lg:grid-cols-[1.35fr_0.65fr]">
                                                <div class="grid grid-cols-2 gap-x-5 gap-y-1 sm:grid-cols-3">
                                                    @foreach (var alt in altKategoriler)
                                                    {
                                                        var altGorsel = GetCategoryMenuImage(alt);
                                                        var altPreviewMetin = !string.IsNullOrWhiteSpace(alt.KisaAciklama)
                                                            ? alt.KisaAciklama
                                                            : (!string.IsNullOrWhiteSpace(alt.SeoDescription) ? alt.SeoDescription : "Bu koleksiyondaki öne çıkan tasarımları inceleyin.");
