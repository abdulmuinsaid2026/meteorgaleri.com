@model KanvasProje.Core.Varliklar.AppUser
@{
    ViewData["Title"] = "Hesabım";
    var firstLetter = !string.IsNullOrEmpty(Model.AdSoyad) ? Model.AdSoyad.Substring(0, 1).ToUpperInvariant() : "U";
}

<!-- Breadcrumb -->
<div class="bg-slate-50 border-b border-slate-200 py-3">
    <div class="container mx-auto px-4 flex items-center gap-2 text-xs text-slate-500">
        <a href="/" class="hover:text-[#00A4D3] transition-colors">Ana Sayfa</a>
        <span>/</span>
        <span class="text-slate-800 font-semibold">Hesabım</span>
    </div>
</div>

<div class="container mx-auto px-4 py-10">
    <div class="flex flex-col lg:flex-row gap-8">

        <!-- Yan Menü -->
        <aside class="lg:w-60 flex-shrink-0">
            <div class="bg-white border border-slate-200/80 rounded-2xl overflow-hidden shadow-sm">
                <!-- Avatar -->
                <div class="bg-slate-900 p-6 text-center">
                    <div class="w-16 h-16 rounded-full bg-[#00A4D3] flex items-center justify-center text-white font-heading font-extrabold text-2xl mx-auto mb-3 shadow-md">
                        @firstLetter
                    </div>
                    <p class="text-white text-sm font-bold">@Model.AdSoyad</p>
                    <p class="text-slate-400 text-xs mt-0.5 truncate">@Model.Email</p>
                </div>
                <!-- Menü -->
                <nav class="p-3 space-y-1">
                    <a href="/Profil" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm text-[#00A4D3] bg-sky-50 font-bold">
                        <i class="fas fa-user w-4"></i> Hesabım
                    </a>
                    <a href="/Profil/Siparislerim" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm text-slate-600 hover:bg-slate-50 hover:text-[#00A4D3] transition-colors font-medium">
                        <i class="fas fa-box w-4"></i> Siparişlerim
                    </a>
                    <a href="/Profil/Adreslerim" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm text-slate-600 hover:bg-slate-50 hover:text-[#00A4D3] transition-colors font-medium">
                        <i class="fas fa-location-dot w-4"></i> Adreslerim
                    </a>
                    <a href="/Favori" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm text-slate-600 hover:bg-slate-50 hover:text-[#00A4D3] transition-colors font-medium">
                        <i class="fas fa-heart w-4"></i> Favorilerim
                    </a>
                    <hr class="border-slate-100 my-2" />
                    <form action="/Hesap/CikisYap" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm text-red-600 hover:bg-red-50 transition-colors text-left font-medium">
                            <i class="fas fa-right-from-bracket w-4"></i> Çıkış Yap
                        </button>
                    </form>
                </nav>
            </div>
        </aside>

        <!-- Ana İçerik -->
        <main class="flex-1 space-y-6">
            <!-- Hoş Geldin Kartı -->
            <div class="bg-white border border-slate-200/80 rounded-2xl p-6 shadow-sm">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <h1 class="font-heading text-2xl font-extrabold text-slate-900 mb-1">Merhaba, @Model.AdSoyad</h1>
                        <p class="text-xs text-slate-500">Meteor Galeri hesabınıza hoş geldiniz.</p>
                    </div>
                    <div class="flex gap-3">
                        <a href="/Profil/Siparislerim" class="border border-slate-300 text-slate-700 text-xs font-bold tracking-wider uppercase px-4 py-2.5 rounded-xl hover:bg-slate-50 transition-colors">
                            Siparişler
                        </a>
                        <a href="/Profil/Adreslerim" class="bg-[#00A4D3] text-white text-xs font-bold tracking-wider uppercase px-4 py-2.5 rounded-xl hover:bg-[#0284C7] transition-all shadow-md shadow-sky-500/20">
                            Adresler
                        </a>
                    </div>
                </div>
            </div>

            <!-- İstatistikler -->
            <div class="grid grid-cols-2 gap-4">
                <div class="bg-white border border-slate-200/80 rounded-2xl p-6 text-center shadow-sm">
                    <div class="font-heading text-4xl font-extrabold text-[#00A4D3] mb-1">@ViewBag.SiparisSayisi</div>
                    <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Toplam Sipariş</div>
                </div>
                <div class="bg-white border border-slate-200/80 rounded-2xl p-6 text-center shadow-sm">
                    <div class="font-heading text-3xl font-extrabold text-slate-900 mb-1">@ViewBag.ToplamHarcama <span class="text-lg">₺</span></div>
                    <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Toplam Harcama</div>
                </div>
            </div>

            <!-- Hesap Bilgileri -->
            <div class="bg-white border border-slate-200/80 rounded-2xl p-6 shadow-sm">
                <h2 class="font-heading text-lg font-bold text-slate-900 mb-5 pb-3 border-b border-slate-100">Hesap Bilgileri</h2>
                <div class="space-y-4">
                    <div class="flex items-center gap-4 py-3 border-b border-slate-100">
                        <div class="w-10 h-10 rounded-xl bg-sky-50 text-[#00A4D3] flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-user text-sm"></i>
                        </div>
                        <div>
                            <div class="text-[11px] text-slate-400 font-semibold uppercase tracking-wider mb-0.5">Ad Soyad</div>
                            <div class="text-sm font-semibold text-slate-900">@Model.AdSoyad</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-4 py-3 border-b border-slate-100">
                        <div class="w-10 h-10 rounded-xl bg-sky-50 text-[#00A4D3] flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-envelope text-sm"></i>
                        </div>
                        <div>
                            <div class="text-[11px] text-slate-400 font-semibold uppercase tracking-wider mb-0.5">E-posta</div>
                            <div class="text-sm font-semibold text-slate-900">@Model.Email</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-4 py-3 border-b border-slate-100">
                        <div class="w-10 h-10 rounded-xl bg-sky-50 text-[#00A4D3] flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-location-dot text-sm"></i>
                        </div>
                        <div>
                            <div class="text-[11px] text-slate-400 font-semibold uppercase tracking-wider mb-0.5">Şehir</div>
                            <div class="text-sm font-semibold text-slate-900">@(!string.IsNullOrEmpty(Model.Sehir) ? Model.Sehir : "Belirtilmedi")</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-4 py-3">
                        <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-shield-halved text-sm"></i>
                        </div>
                        <div>
                            <div class="text-[11px] text-slate-400 font-semibold uppercase tracking-wider mb-0.5">Durum</div>
                            <span class="inline-flex items-center gap-1.5 text-xs bg-emerald-50 text-emerald-700 border border-emerald-200 px-3 py-1 rounded-full font-semibold">
                                <i class="fas fa-circle text-[6px]"></i> Aktif Üye
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
