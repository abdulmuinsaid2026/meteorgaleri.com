@model List<KanvasProje.Core.Varliklar.Adres>
@{
    ViewData["Title"] = "Adreslerim";
    var sehirler = new[] {
        "Adana","Adıyaman","Afyonkarahisar","Ağrı","Aksaray","Amasya","Ankara","Antalya","Ardahan","Artvin",
        "Aydın","Balıkesir","Bartın","Batman","Bayburt","Bilecik","Bingöl","Bitlis","Bolu","Burdur",
        "Bursa","Çanakkale","Çankırı","Çorum","Denizli","Diyarbakır","Düzce","Edirne","Elazığ","Erzincan",
        "Erzurum","Eskişehir","Gaziantep","Giresun","Gümüşhane","Hakkari","Hatay","Iğdır","Isparta","İstanbul",
        "İzmir","Kahramanmaraş","Karabük","Karaman","Kars","Kastamonu","Kayseri","Kırıkkale","Kırklareli","Kırşehir",
        "Kilis","Kocaeli","Konya","Kütahya","Malatya","Manisa","Mardin","Mersin","Muğla","Muş",
        "Nevşehir","Niğde","Ordu","Osmaniye","Rize","Sakarya","Samsun","Siirt","Sinop","Sivas",
        "Şanlıurfa","Şırnak","Tekirdağ","Tokat","Trabzon","Tunceli","Uşak","Van","Yalova","Yozgat","Zonguldak"
    };
}

<!-- Breadcrumb -->
<div class="bg-slate-50 border-b border-slate-200 py-3">
    <div class="container mx-auto px-4 flex items-center gap-2 text-xs text-slate-500">
        <a href="/" class="hover:text-[#00A4D3] transition-colors">Ana Sayfa</a>
        <span>/</span>
        <a href="/Profil" class="hover:text-[#00A4D3] transition-colors">Hesabım</a>
        <span>/</span>
        <span class="text-slate-800 font-semibold">Adreslerim</span>
    </div>
</div>

<div class="container mx-auto px-4 py-10">
    <div class="flex flex-col lg:flex-row gap-8">

        <!-- Yan Menü -->
        <aside class="lg:w-60 flex-shrink-0">
            <div class="bg-white border border-slate-200/80 rounded-2xl overflow-hidden shadow-sm">
                <div class="bg-slate-900 p-5 text-center">
                    <p class="text-white text-sm font-bold">Hesabım</p>
                </div>
                <nav class="p-3 space-y-1">
                    <a href="/Profil" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm text-slate-600 hover:bg-slate-50 hover:text-[#00A4D3] transition-colors font-medium">
                        <i class="fas fa-user w-4"></i> Genel Bakış
                    </a>
                    <a href="/Profil/Siparislerim" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm text-slate-600 hover:bg-slate-50 hover:text-[#00A4D3] transition-colors font-medium">
                        <i class="fas fa-box w-4"></i> Siparişlerim
                    </a>
                    <a href="/Profil/Adreslerim" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm text-[#00A4D3] bg-sky-50 font-bold">
                        <i class="fas fa-location-dot w-4"></i> Adreslerim
                    </a>
                    <a href="/Favori" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm text-slate-600 hover:bg-slate-50 hover:text-[#00A4D3] transition-colors font-medium">
                        <i class="fas fa-heart w-4"></i> Favorilerim
                    </a>
                    <hr class="border-slate-100 my-2" />
                    <form action="/Hesap/CikisYap" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm text-red-600 hover:bg-red-50 transition-colors text-left font-medium">
                            <i class="fas fa-right-from-bracket w-4"></i> Çıkış Yap
                        </button>
                    </form>
                </nav>
            </div>
        </aside>

        <!-- Ana İçerik -->
        <main class="flex-1 min-w-0">
            <div class="flex items-center justify-between mb-8">
                <div>
                    <h1 class="font-heading text-2xl sm:text-3xl font-extrabold text-slate-900">Adreslerim</h1>
                    <p class="text-xs text-slate-500 mt-1">Teslimat adreslerinizi kolayca yönetin</p>
                </div>
                <button type="button" id="adresEkleBtn"
                        class="bg-[#00A4D3] text-white text-xs font-bold tracking-wider uppercase px-4 py-2.5 rounded-xl hover:bg-[#0284C7] transition-all shadow-md shadow-sky-500/20">
                    <i class="fas fa-plus mr-1.5"></i> Yeni Adres
                </button>
            </div>

            @if (TempData["Mesaj"] != null)
            {
                <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm px-4 py-3 rounded-xl mb-6 flex items-center gap-2">
                    <i class="fas fa-circle-check text-emerald-600"></i>
                    @TempData["Mesaj"]
                </div>
            }

            @if (!Model.Any())
            {
                <div class="text-center py-20 bg-white border border-slate-200 rounded-2xl shadow-sm max-w-lg mx-auto p-8">
                    <div class="w-20 h-20 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-4 text-slate-300 text-3xl">
                        <i class="fas fa-location-dot"></i>
                    </div>
                    <h3 class="font-heading text-xl font-bold text-slate-900 mb-2">Kayıtlı adresiniz bulunmuyor</h3>
                    <p class="text-sm text-slate-500 mb-6 max-w-sm mx-auto">Siparişlerinizi hızlandırmak için adresinizi hemen kaydedebilirsiniz.</p>
                    <button type="button" id="adresEkleBtnEmpty"
                            class="inline-block bg-[#00A4D3] text-white px-8 py-3.5 text-xs font-bold tracking-wider uppercase rounded-xl hover:bg-[#0284C7] transition-all shadow-md shadow-sky-500/20">
                        <i class="fas fa-plus mr-1.5"></i> Adres Ekle
                    </button>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    @foreach (var item in Model)
                    {
                        <div class="bg-white border border-slate-200/90 rounded-2xl p-5 hover:border-slate-300 transition-all shadow-sm">
                            <div class="flex items-start justify-between mb-3">
                                <div>
                                    <span class="text-[11px] uppercase tracking-wider text-[#00A4D3] font-bold">@item.Baslik</span>
                                    <h3 class="font-bold text-slate-900 mt-0.5">@item.Sehir / @item.Ilce</h3>
                                </div>
                                <form action="/Profil/AdresSil" method="post" onsubmit="return confirm('Bu adresi silmek istediğinize emin misiniz?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="w-8 h-8 flex items-center justify-center text-slate-400 hover:text-red-500 transition-colors rounded-full hover:bg-red-50" title="Adresi sil">
                                        <i class="fas fa-trash text-xs"></i>
                                    </button>
                                </form>
                            </div>
                            <div class="space-y-2 text-sm">
                                <div class="flex items-center gap-2 text-slate-600">
                                    <i class="fas fa-user w-4 text-[#00A4D3] text-xs"></i>
                                    <span class="font-medium text-slate-800">@item.AdSoyad</span>
                                </div>
                                <div class="flex items-center gap-2 text-slate-600">
                                    <i class="fas fa-phone w-4 text-[#00A4D3] text-xs"></i>
                                    <span>@item.Telefon</span>
                                </div>
                                <div class="flex items-start gap-2 text-slate-600">
                                    <i class="fas fa-location-dot w-4 text-[#00A4D3] text-xs mt-0.5"></i>
                                    <span class="leading-relaxed">@item.AcikAdres</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </main>
    </div>
</div>

<!-- Adres Ekleme Modal -->
<div id="adresModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm p-4">
    <div class="bg-white rounded-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto shadow-2xl">
        <div class="flex items-center justify-between p-6 border-b border-slate-100">
            <h2 class="font-heading text-xl font-bold text-slate-900">Yeni Adres Ekle</h2>
            <button id="modalKapat" class="w-8 h-8 flex items-center justify-center text-slate-400 hover:text-slate-700 transition-colors rounded-full hover:bg-slate-100">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <form action="/Profil/AdresEkle" method="post" class="p-6">
            @Html.AntiForgeryToken()
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 tracking-wider uppercase mb-2">Adres Başlığı</label>
                    <input type="text" name="Baslik" required placeholder="Ev, Ofis, vb."
                           class="w-full border border-slate-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-[#00A4D3] focus:border-[#00A4D3] outline-none bg-white transition-all text-slate-800" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 tracking-wider uppercase mb-2">Ad Soyad</label>
                    <input type="text" name="AdSoyad" required placeholder="Teslim alacak kişi"
                           class="w-full border border-slate-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-[#00A4D3] focus:border-[#00A4D3] outline-none bg-white transition-all text-slate-800" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 tracking-wider uppercase mb-2">Telefon</label>
                    <input type="text" name="Telefon" required placeholder="0555 123 45 67"
                           class="w-full border border-slate-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-[#00A4D3] focus:border-[#00A4D3] outline-none bg-white transition-all text-slate-800" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 tracking-wider uppercase mb-2">İlçe</label>
                    <input type="text" name="Ilce" required placeholder="İlçe bilgisi"
                           class="w-full border border-slate-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-[#00A4D3] focus:border-[#00A4D3] outline-none bg-white transition-all text-slate-800" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 tracking-wider uppercase mb-2">Şehir</label>
                    <select name="Sehir" required
                            class="w-full border border-slate-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-[#00A4D3] focus:border-[#00A4D3] outline-none bg-white transition-all text-slate-800">
                        <option value="">Şehir seçin</option>
                        @foreach (var sehir in sehirler)
                        {
                            <option value="@sehir">@sehir</option>
                        }
                    </select>
                </div>
                <div class="sm:col-span-2">
                    <label class="block text-xs font-semibold text-slate-700 tracking-wider uppercase mb-2">Açık Adres</label>
                    <textarea name="AcikAdres" required rows="3" placeholder="Mahalle, sokak, bina ve daire bilgileri"
                              class="w-full border border-slate-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-[#00A4D3] focus:border-[#00A4D3] outline-none resize-none bg-white transition-all text-slate-800"></textarea>
                </div>
            </div>
            <div class="flex justify-end gap-3 mt-6">
                <button type="button" id="modalKapat2"
                        class="border border-slate-300 text-slate-700 text-xs font-bold tracking-wider uppercase px-5 py-3 rounded-xl hover:bg-slate-50 transition-colors">
                    Vazgeç
                </button>
                <button type="submit"
                        class="bg-[#00A4D3] text-white text-xs font-bold tracking-wider uppercase px-6 py-3 rounded-xl hover:bg-[#0284C7] transition-all shadow-md shadow-sky-500/20">
                    Adresi Kaydet
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    const modal = document.getElementById('adresModal');
    const openBtns = [document.getElementById('adresEkleBtn'), document.getElementById('adresEkleBtnEmpty')];
    const closeBtns = [document.getElementById('modalKapat'), document.getElementById('modalKapat2')];

    openBtns.forEach(btn => btn && btn.addEventListener('click', () => {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }));
    closeBtns.forEach(btn => btn && btn.addEventListener('click', () => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }));
    modal.addEventListener('click', (e) => {
        if (e.target === modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
    });
</script>
