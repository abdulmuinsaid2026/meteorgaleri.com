@model IEnumerable<KanvasProje.Core.Varliklar.Siparis>
@{
    ViewData["Title"] = "Siparişlerim";
}

@{
    string DurumAdi(int durum) => durum switch
    {
        8 => "Paketleniyor",
        0 => "Sipariş Alındı",
        1 => "Hazırlanıyor",
        2 => "Kargolandı",
        3 => "Teslim Edildi",
        5 => "İade Talebi",
        6 => "İade Onaylandı",
        7 => "İade Tamamlandı",
        _ => "İptal Edildi"
    };
    string DurumIkon(int durum) => durum switch
    {
        8 => "fas fa-box",
        0 => "fas fa-clock",
        1 => "fas fa-box-open",
        2 => "fas fa-truck-fast",
        3 => "fas fa-circle-check",
        5 => "fas fa-rotate-left",
        6 => "fas fa-clipboard-check",
        7 => "fas fa-coins",
        _ => "fas fa-circle-xmark"
    };
    string DurumRenk(int durum) => durum switch
    {
        8 => "bg-amber-50 text-amber-700 border-amber-200",
        3 or 7 => "bg-green-50 text-green-700 border-green-200",
        2 => "bg-blue-50 text-blue-700 border-blue-200",
        1 => "bg-amber-50 text-amber-700 border-amber-200",
        4 => "bg-red-50 text-red-700 border-red-200",
        _ => "bg-gray-50 text-gray-600 border-gray-200"
    };
}

<!-- Breadcrumb -->
<div class="bg-slate-50 border-b border-slate-200 py-3">
    <div class="container mx-auto px-4 flex items-center gap-2 text-xs text-slate-500">
        <a href="/" class="hover:text-[#00A4D3] transition-colors">Ana Sayfa</a>
        <span>/</span>
        <a href="/Profil" class="hover:text-[#00A4D3] transition-colors">Hesabım</a>
        <span>/</span>
        <span class="text-slate-800 font-semibold">Siparişlerim</span>
    </div>
</div>

<div class="container mx-auto px-4 py-10">
    <div class="flex flex-col lg:flex-row gap-8">

        <!-- Yan Menü -->
        <aside class="lg:w-60 flex-shrink-0">
            <div class="bg-white border border-slate-200/80 rounded-2xl overflow-hidden shadow-sm">
                <div class="bg-slate-900 p-5 text-center">
                    <p class="text-white text-sm font-bold">Hesabım</p>
                </div>
                <nav class="p-3 space-y-1">
                    <a href="/Profil" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm text-slate-600 hover:bg-slate-50 hover:text-[#00A4D3] transition-colors font-medium">
                        <i class="fas fa-user w-4"></i> Genel Bakış
                    </a>
                    <a href="/Profil/Siparislerim" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm text-[#00A4D3] bg-sky-50 font-bold">
                        <i class="fas fa-box w-4"></i> Siparişlerim
                    </a>
                    <a href="/Profil/Adreslerim" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm text-slate-600 hover:bg-slate-50 hover:text-[#00A4D3] transition-colors font-medium">
                        <i class="fas fa-location-dot w-4"></i> Adreslerim
                    </a>
                    <a href="/Favori" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm text-slate-600 hover:bg-slate-50 hover:text-[#00A4D3] transition-colors font-medium">
                        <i class="fas fa-heart w-4"></i> Favorilerim
                    </a>
                    <hr class="border-slate-100 my-2" />
                    <form action="/Hesap/CikisYap" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm text-red-600 hover:bg-red-50 transition-colors text-left font-medium">
                            <i class="fas fa-right-from-bracket w-4"></i> Çıkış Yap
                        </button>
                    </form>
                </nav>
            </div>
        </aside>

        <!-- Ana İçerik -->
        <main class="flex-1 min-w-0">
            <div class="flex items-center justify-between mb-8">
                <div>
                    <h1 class="font-heading text-2xl sm:text-3xl font-extrabold text-slate-900">Siparişlerim</h1>
                    <p class="text-xs text-slate-500 mt-1">Toplam @Model.Count() sipariş</p>
                </div>
                <a href="/Urun" class="border border-slate-300 text-slate-700 text-xs font-bold tracking-wider uppercase px-4 py-2.5 rounded-xl hover:bg-slate-50 transition-colors">
                    Alışverişe Dön
                </a>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-20 bg-white border border-slate-200 rounded-2xl shadow-sm max-w-lg mx-auto p-8">
                    <div class="w-20 h-20 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-4 text-slate-300 text-3xl">
                        <i class="fas fa-basket-shopping"></i>
                    </div>
                    <h3 class="font-heading text-xl font-bold text-slate-900 mb-2">Henüz siparişiniz bulunmuyor</h3>
                    <p class="text-sm text-slate-500 mb-6 max-w-sm mx-auto">Tablo koleksiyonlarımızı inceleyerek ilk siparişinizi kolayca oluşturabilirsiniz.</p>
                    <a href="/Urun" class="inline-block bg-[#00A4D3] text-white px-8 py-3.5 text-xs font-bold tracking-wider uppercase rounded-xl hover:bg-[#0284C7] transition-all shadow-md shadow-sky-500/20">
                        Tabloları İncele
                    </a>
                </div>
            }
            else
            {
                <div class="space-y-4">
                    @foreach (var item in Model.OrderByDescending(x => x.OlusturulmaTarihi))
                    {
                        <div class="bg-white border border-slate-200/90 rounded-2xl p-5 hover:border-slate-300 transition-all shadow-sm">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                                <div class="flex items-center gap-4">
                                    <div class="w-11 h-11 rounded-xl bg-sky-50 text-[#00A4D3] flex items-center justify-center flex-shrink-0">
                                        <i class="@DurumIkon(item.Durum) text-base"></i>
                                    </div>
                                    <div>
                                        <div class="flex items-center gap-2 flex-wrap">
                                            <span class="font-bold text-slate-900 text-sm">#@item.Id</span>
                                            <span class="border text-xs px-2.5 py-0.5 rounded-full font-semibold @DurumRenk(item.Durum)">
                                                @DurumAdi(item.Durum)
                                            </span>
                                            @if (item.FaturaYuklendiMi)
                                            {
                                                <a href="/Siparis/FaturaIndir?id=@item.Id" target="_blank" class="text-xs bg-emerald-50 text-emerald-700 border border-emerald-200 px-2.5 py-0.5 rounded-full hover:bg-emerald-100 transition-colors font-medium" title="Faturayı İndir">
                                                    <i class="fas fa-file-pdf mr-1"></i>Fatura
                                                </a>
                                            }
                                        </div>
                                        <div class="text-xs text-slate-400 mt-1">
                                            @item.OlusturulmaTarihi.ToTurkeyString("dd MMMM yyyy") — @item.OlusturulmaTarihi.ToTurkeyString("HH:mm")
                                        </div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-4 sm:flex-shrink-0">
                                    @if (!string.IsNullOrEmpty(item.KargoTakipNo))
                                    {
                                        <span class="text-xs bg-slate-50 border border-slate-200 text-slate-700 px-2.5 py-1 rounded-lg font-mono">
                                            <i class="fas fa-barcode mr-1 text-[#00A4D3]"></i>@item.KargoTakipNo
                                        </span>
                                    }
                                    <span class="font-extrabold text-[#E30613] text-base">@item.ToplamTutar.ToString("N2") ₺</span>
                                    <a href="/Profil/SiparisDetay/@item.Id"
                                       class="text-xs border border-slate-200 px-3.5 py-2 rounded-xl hover:bg-slate-50 text-slate-700 hover:text-[#00A4D3] font-semibold transition-colors whitespace-nowrap">
                                        Detay <i class="fas fa-chevron-right ml-1 text-[10px]"></i>
                                    </a>
                                </div>
                            </div>
                            @if (item.Durum != 4)
                            {
                                var currentProg = KanvasProje.Core.Helpers.SiparisDurumHelper.GetProgressStep(item.Durum);
                                <div class="mt-4 pt-3 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3 text-xs">
                                    <div class="flex items-center gap-1.5 w-48 sm:w-64">
                                        @for (int s = 1; s <= 5; s++)
                                        {
                                            var isDone = s <= currentProg;
                                            <div class="h-1.5 flex-1 rounded-full @(isDone ? "bg-[#00A4D3]" : "bg-slate-200")"></div>
                                        }
                                    </div>
                                    <span class="text-[11px] text-slate-500 font-medium">
                                        <i class="fas fa-clock-rotate-left text-[#00A4D3] me-1"></i>Süreç: <strong class="text-slate-800">@KanvasProje.Core.Helpers.SiparisDurumHelper.GetLabel(item.Durum)</strong>
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </main>
    </div>
</div>
