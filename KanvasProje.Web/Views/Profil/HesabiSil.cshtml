@{
    ViewData["Title"] = "Hesabı Sil";
    var hasPassword = ViewBag.HasPassword as bool? ?? true;
}

<div class="bg-slate-50 border-b border-slate-200 py-3">
    <div class="container mx-auto px-4 flex items-center gap-2 text-xs text-slate-500">
        <a href="/" class="hover:text-[#00A4D3] transition-colors">Ana Sayfa</a>
        <span>/</span>
        <a href="/Profil" class="hover:text-[#00A4D3] transition-colors">Hesabım</a>
        <span>/</span>
        <span class="text-slate-800 font-semibold">Hesabı Sil</span>
    </div>
</div>

<div class="container mx-auto px-4 py-16 max-w-xl text-center">
    <div class="bg-white border border-slate-200/80 rounded-2xl p-8 sm:p-10 shadow-sm">
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-red-50 text-red-600 mb-6 text-3xl">
            <i class="fas fa-triangle-exclamation"></i>
        </div>
        <h1 class="font-heading text-2xl sm:text-3xl font-extrabold text-slate-900 mb-4">Hesabınızı Silmek Üzeresiniz</h1>
        <p class="text-sm text-slate-600 mb-6 leading-relaxed">
            Hesabınızı silerseniz sipariş geçmişiniz, favorileriniz ve tüm kayıtlı adres bilgileriniz kalıcı olarak silinecektir. Bu işlem geri alınamaz.
            Onaylıyor musunuz?
        </p>

        @if (ViewBag.Hata != null)
        {
            <div class="bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded-xl mb-6 flex items-center justify-center gap-2 text-left">
                <i class="fas fa-circle-exclamation text-red-600"></i>
                <span>@ViewBag.Hata</span>
            </div>
        }

        <form asp-action="HesabiSilOnayla" method="post" class="space-y-5 text-left">
            @Html.AntiForgeryToken()

            @if (hasPassword)
            {
                <div>
                    <label for="sifre" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Güvenliğiniz İçin Mevcut Şifrenizi Girin</label>
                    <input id="sifre" type="password" name="sifre" required autocomplete="current-password" placeholder="Mevcut şifreniz"
                           class="w-full border border-slate-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none bg-white text-slate-800" />
                </div>
            }

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
                <button type="submit" class="w-full sm:w-auto bg-[#E30613] text-white px-8 py-3.5 text-xs font-bold tracking-wider uppercase rounded-xl hover:bg-[#DC2626] transition-all shadow-md shadow-red-500/20 flex items-center justify-center gap-2">
                    <i class="fas fa-trash"></i> Evet, Hesabımı Sil
                </button>
                <a href="/Profil" class="w-full sm:w-auto bg-white border border-slate-300 text-slate-700 px-8 py-3.5 text-xs font-bold tracking-wider uppercase rounded-xl hover:bg-slate-50 transition-colors inline-block text-center">
                    Vazgeç
                </a>
            </div>
        </form>
    </div>
</div>
