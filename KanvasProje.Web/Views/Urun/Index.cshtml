@model IEnumerable<KanvasProje.Core.Varliklar.Urun>
@inject KanvasProje.Service.Services.ISiteSettingsService SiteSettingsService
@using KanvasProje.Core.Helpers

@{
    ViewData["Title"] = "Koleksiyonlar";
    var siteSettings = SiteSettingsService.GetSettings();
    var currencySymbol = string.IsNullOrWhiteSpace(siteSettings.ParaBirimi) ? "TL" : siteSettings.ParaBirimi;

    int currentPage = ViewBag.CurrentPage != null ? (int)ViewBag.CurrentPage : 1;
    int totalPages = ViewBag.TotalPages != null ? (int)ViewBag.TotalPages : 1;
    int totalItems = ViewBag.TotalItems != null ? (int)ViewBag.TotalItems : 0;

    int? aktifKategori = ViewBag.KategoriId;
    string aktifArama = ViewBag.Search ?? "";
    string aktifSort = ViewBag.Sort ?? "yeni";
    decimal? aktifMin = ViewBag.Min;
    decimal? aktifMax = ViewBag.Max;
    var ozellikFiltreleri = ViewBag.OzellikFiltreleri as List<KanvasProje.Web.Models.ProductFeatureFilterViewModel> ?? new List<KanvasProje.Web.Models.ProductFeatureFilterViewModel>();
    var seciliOzellikler = ViewBag.SeciliOzellikler as Dictionary<int, string> ?? new Dictionary<int, string>();

    var kategoriler = ViewBag.Kategoriler as List<KanvasProje.Core.Varliklar.Kategori>;
    var kategoriUrunSayilari = ViewBag.KategoriUrunSayilari as Dictionary<int, int> ?? new Dictionary<int, int>();
    int toplamAktifUrunSayisi = ViewBag.ToplamAktifUrunSayisi != null ? (int)ViewBag.ToplamAktifUrunSayisi : totalItems;
    var kategoriIdSet = kategoriler?.Select(x => x.Id).ToHashSet() ?? new HashSet<int>();
    var anaKategoriler = kategoriler?
        .Where(x => !x.SilindiMi && x.AktifMi && (!x.ParentKategoriId.HasValue || !kategoriIdSet.Contains(x.ParentKategoriId.Value)))
        .OrderBy(x => x.Sira)
        .ThenBy(x => x.Ad)
        .ToList() ?? new List<KanvasProje.Core.Varliklar.Kategori>();
    var kategoriLookup = kategoriler?.ToDictionary(x => x.Id) ?? new Dictionary<int, KanvasProje.Core.Varliklar.Kategori>();

    var sortOptions = new Dictionary<string, string>
    {
        { "yeni", "En Yeniler" },
        { "fiyat_artan", "Fiyat: Düşükten Yükseğe" },
        { "fiyat_azalan", "Fiyat: Yüksekten Düşüğe" },
        { "cok_satan", "Çok Satanlar" }
    };

    string aktifKategoriAd = "Tüm Koleksiyonlar";
    if (aktifKategori.HasValue && kategoriler != null)
    {
        var kat = kategoriler.FirstOrDefault(x => x.Id == aktifKategori.Value);
        if (kat != null) aktifKategoriAd = kat.Ad;
    }


    int GetKategoriUrunSayisi(int kategoriId)
        => kategoriUrunSayilari.TryGetValue(kategoriId, out var count) ? count : 0;

    bool AktifKategoriDalindaMi(KanvasProje.Core.Varliklar.Kategori kategori)
    {
        var currentId = aktifKategori;
        while (currentId.HasValue && kategoriLookup.TryGetValue(currentId.Value, out var current))
        {
            if (current.Id == kategori.Id)
            {
                return true;
            }

            currentId = current.ParentKategoriId;
        }

        return false;
    }

    string BuildFilterUrl(string key, string val)
    {
        var values = new List<(string Key, string Value)>();

        void AddQueryValue(string queryKey, string? queryValue)
        {
            if (!string.IsNullOrWhiteSpace(queryValue))
            {
                values.Add((queryKey, queryValue));
            }
        }

        if (aktifKategori.HasValue) AddQueryValue("k", aktifKategori.Value.ToString());
        AddQueryValue("s", aktifArama);
        if (aktifMin.HasValue) AddQueryValue("min", aktifMin.Value.ToString());
        if (aktifMax.HasValue) AddQueryValue("max", aktifMax.Value.ToString());
        if (!string.Equals(key, "sort", StringComparison.OrdinalIgnoreCase)) AddQueryValue("sort", aktifSort);

        AddQueryValue(key, val);

        var parts = values
            .Select(x => $"{System.Uri.EscapeDataString(x.Key)}={System.Uri.EscapeDataString(x.Value)}")
            .ToList();

        return parts.Count == 0 ? "/Urun" : "/Urun?" + string.Join("&", parts);
    }
}

<!-- Breadcrumb -->
<div class="bg-[#F8FAFC] border-b border-slate-200 py-3.5">
    <div class="container mx-auto px-4 flex items-center gap-2 text-xs text-slate-500">
        <a href="/" class="hover:text-[#00A4D3] transition-colors">Ana Sayfa</a>
        <span>/</span>
        <span class="text-slate-900 font-semibold">@aktifKategoriAd</span>
    </div>
</div>

<div class="container mx-auto px-4 py-10">
    <div class="flex gap-8">

        <!-- Sidebar Filtreler -->
        <aside class="hidden lg:block w-60 flex-shrink-0">
            <h3 class="font-serif text-lg font-bold text-slate-900 mb-4 border-b border-slate-200 pb-2">Kategoriler</h3>
            <ul class="space-y-1.5 text-sm mb-8">
                <li>
                    <a href="/Urun" class="flex items-center justify-between rounded-xl px-3 py-2.5 @(!aktifKategori.HasValue ? "bg-[#00A4D3] text-white font-semibold shadow-xs" : "text-slate-700 hover:bg-slate-100 hover:text-[#00A4D3]") transition-all">
                        <span>Tüm Tablolar</span>
                        <span class="text-xs @(!aktifKategori.HasValue ? "text-white/80" : "text-slate-400")">(@toplamAktifUrunSayisi)</span>
                    </a>
                </li>
                @foreach (var anaKategori in anaKategoriler)
                {
                    var altKategoriler = kategoriler?
                        .Where(x => !x.SilindiMi && x.AktifMi && x.ParentKategoriId == anaKategori.Id)
                        .OrderBy(x => x.Sira)
                        .ThenBy(x => x.Ad)
                        .ToList() ?? new List<KanvasProje.Core.Varliklar.Kategori>();
                    var anaAktif = aktifKategori.HasValue && aktifKategori.Value == anaKategori.Id;
                    var grupAcik = anaAktif || AktifKategoriDalindaMi(anaKategori);
                    var anaUrunSayisi = GetKategoriUrunSayisi(anaKategori.Id);

                    <li>
                    @if (altKategoriler.Count == 0)
                    {
                            <a href="/Urun?k=@anaKategori.Id" class="flex items-center justify-between rounded-xl px-3 py-2.5 @(anaAktif ? "bg-sky-50 text-[#00A4D3] font-semibold border border-sky-200" : "text-slate-700 hover:bg-slate-100 hover:text-[#00A4D3]") transition-all">
                                <span>@anaKategori.Ad</span>
                                <span class="text-xs @(anaUrunSayisi == 0 ? "text-slate-400" : "text-slate-400")">(@anaUrunSayisi)</span>
                            </a>
                    }
                    else
                    {
                            <details class="group rounded-xl border border-slate-200 bg-white" open="@grupAcik">
                                <summary class="flex cursor-pointer list-none items-center justify-between gap-2 px-3 py-2 text-slate-800 transition-colors group-open:border-b group-open:border-slate-100 [&::-webkit-details-marker]:hidden">
                                    <span class="font-semibold text-xs uppercase tracking-wider">@anaKategori.Ad</span>
                                    <span class="flex items-center gap-1.5 text-xs text-slate-400">
                                        (@anaUrunSayisi)
                                        <i class="fas fa-chevron-down text-[10px] transition-transform group-open:rotate-180"></i>
                                    </span>
                                </summary>
                                <div class="space-y-1 p-2">
                                    <a href="/Urun?k=@anaKategori.Id" class="flex items-center justify-between rounded-lg px-2.5 py-1.5 text-xs @(anaAktif ? "bg-[#00A4D3] text-white font-semibold" : "text-slate-600 hover:bg-slate-100 hover:text-[#00A4D3]") transition-colors">
                                        <span>Tüm @anaKategori.Ad</span>
                                        <span class="@(anaAktif ? "text-white/80" : "text-slate-400")">(@anaUrunSayisi)</span>
                                    </a>
                                    @foreach (var altKategori in altKategoriler)
                                    {
                                        var altAktif = aktifKategori.HasValue && aktifKategori.Value == altKategori.Id;
                                        var altUrunSayisi = GetKategoriUrunSayisi(altKategori.Id);
                                        <a href="/Urun?k=@altKategori.Id" class="flex items-center justify-between gap-3 rounded-lg px-2.5 py-1.5 text-xs @(altAktif ? "bg-sky-50 text-[#00A4D3] font-semibold border border-sky-200" : "text-slate-600 hover:bg-slate-100 hover:text-[#00A4D3]") transition-colors">
                                            <span class="truncate">@altKategori.Ad</span>
                                            <span class="shrink-0 text-slate-400">(@altUrunSayisi)</span>
                                        </a>
                                    }
                                </div>
                            </details>
                    }
                    </li>
                }
            </ul>

            <!-- Fiyat Filtresi -->
            <h3 class="font-serif text-lg font-bold text-slate-900 mb-4 border-b border-slate-200 pb-2">Fiyat Aralığı</h3>
            <form method="get" action="/Urun" class="space-y-3">
                @if (aktifKategori.HasValue)
                {
                    <input type="hidden" name="k" value="@aktifKategori" />
                }
                @if (!string.IsNullOrWhiteSpace(aktifArama))
                {
                    <input type="hidden" name="s" value="@aktifArama" />
                }
                <input type="hidden" name="sort" value="@aktifSort" />
                <div class="flex gap-2 items-center">
                    <input name="min" type="number" placeholder="Min ₺" value="@aktifMin" class="w-full border border-slate-200 rounded-xl px-3 py-2 text-xs focus:ring-2 focus:ring-[#00A4D3] focus:border-[#00A4D3] bg-white text-slate-800" />
                    <span class="text-slate-400 text-xs">—</span>
                    <input name="max" type="number" placeholder="Max ₺" value="@aktifMax" class="w-full border border-slate-200 rounded-xl px-3 py-2 text-xs focus:ring-2 focus:ring-[#00A4D3] focus:border-[#00A4D3] bg-white text-slate-800" />
                </div>
                <button type="submit" class="w-full bg-[#00A4D3] hover:bg-[#0284C7] text-white text-xs font-bold py-2.5 rounded-xl shadow-xs transition-colors tracking-wider uppercase">
                    Filtrele
                </button>
            </form>
        </aside>

        <!-- Ana İçerik -->
        <main class="flex-1 min-w-0">
            <!-- Başlık + Sıralama -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
                <div>
                    <h1 class="font-serif text-3xl font-bold text-slate-900">@aktifKategoriAd</h1>
                    <p class="text-xs text-slate-500 mt-1">@totalItems tablo listeleniyor</p>
                </div>
                <div class="flex items-center gap-3">
                    @if (!string.IsNullOrWhiteSpace(aktifArama))
                    {
                        <span class="bg-[#00A4D3] text-white text-xs px-3 py-1.5 rounded-full flex items-center gap-1.5 shadow-xs font-medium">
                            "<span>@aktifArama</span>"
                            <a href="/Urun@(aktifKategori.HasValue ? "?k=" + aktifKategori : "")" class="ml-1 opacity-80 hover:opacity-100 font-bold">×</a>
                        </span>
                    }
                    <select id="sortSelect" onchange="window.location.href=this.value" class="border border-slate-200 text-xs rounded-xl px-3.5 py-2.5 focus:ring-2 focus:ring-[#00A4D3] bg-white text-slate-700 shadow-2xs font-medium">
                        @foreach (var opt in sortOptions)
                        {
                            <option value="@BuildFilterUrl("sort", opt.Key)" selected="@(aktifSort == opt.Key)">@opt.Value</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Mobile Kategori Chips -->
            <div class="hidden md:flex lg:hidden flex gap-2 overflow-x-auto pb-3 mb-6 custom-scrollbar">
                <a href="/Urun" class="whitespace-nowrap text-xs border @(!aktifKategori.HasValue ? "bg-[#00A4D3] text-white border-[#00A4D3] font-bold" : "border-slate-200 text-slate-700 bg-white") rounded-full px-3.5 py-1.5 shadow-2xs">Tümü</a>
                @if (kategoriler != null)
                {
                    foreach (var kat in kategoriler.Where(x => !x.SilindiMi && x.AktifMi))
                    {
                        bool isActive = aktifKategori.HasValue && aktifKategori.Value == kat.Id;
                        <a href="/Urun?k=@kat.Id" class="whitespace-nowrap text-xs border @(isActive ? "bg-[#00A4D3] text-white border-[#00A4D3] font-bold" : "border-slate-200 text-slate-700 bg-white") rounded-full px-3.5 py-1.5 shadow-2xs">@kat.Ad</a>
                    }
                }
            </div>

            <!-- Ürün Grid -->
            @if (Model != null && Model.Any())
            {
                <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4 md:gap-6">
                    @foreach (var urun in Model)
                    {
                        <partial name="_UrunKarti" model="urun" />
                    }
                </div>

                <!-- Sayfalama -->
                @if (totalPages > 1)
                {
                    <div class="flex justify-center items-center gap-2 mt-16">
                        @if (currentPage > 1)
                        {
                            <a href="@BuildFilterUrl("page", (currentPage - 1).ToString())" class="w-10 h-10 border border-slate-200 rounded-xl flex items-center justify-center text-slate-700 hover:bg-[#00A4D3] hover:text-white hover:border-[#00A4D3] transition-colors text-xs shadow-2xs">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        }
                        @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                        {
                            <a href="@BuildFilterUrl("page", i.ToString())" class="w-10 h-10 border @(i == currentPage ? "bg-[#00A4D3] text-white border-[#00A4D3] font-bold shadow-xs" : "border-slate-200 text-slate-700 hover:bg-slate-100") rounded-xl flex items-center justify-center text-xs transition-colors">
                                @i
                            </a>
                        }
                        @if (currentPage < totalPages)
                        {
                            <a href="@BuildFilterUrl("page", (currentPage + 1).ToString())" class="w-10 h-10 border border-slate-200 rounded-xl flex items-center justify-center text-slate-700 hover:bg-[#00A4D3] hover:text-white hover:border-[#00A4D3] transition-colors text-xs shadow-2xs">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        }
                    </div>
                }
            }
            else
            {
                <div class="text-center py-24 text-slate-500">
                    <i class="fas fa-search fa-3x mb-6 text-slate-300"></i>
                    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-2">Ürün Bulunamadı</h3>
                    <p class="text-sm mb-6">Farklı bir kategori veya arama terimi deneyebilirsiniz.</p>
                    <a href="/Urun" class="inline-block border-2 border-[#00A4D3] text-[#00A4D3] px-6 py-2.5 text-xs font-bold uppercase tracking-wider hover:bg-[#00A4D3] hover:text-white transition-colors rounded-full">
                        Tüm Tabloları Gör
                    </a>
                </div>
            }
        </main>
    </div>
</div>
