</div>

<div class="container mx-auto px-4 py-10 lg:py-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14">
        
        <!-- Left: Image Gallery -->
        <div class="space-y-4">
            <div id="mainProductImageContainer" class="relative bg-[#F8FAFC] aspect-square rounded-2xl border border-slate-200 shadow-sm overflow-hidden group cursor-zoom-in flex items-center justify-center p-4" onclick="openProductLightbox()">
                <img id="mainProductImage" src="@varsayilanGaleriGorseli" data-default-src="@(varsayilanMedya?.ResimYolu ?? Model.AnaGorselUrl)" data-default-alt="@varsayilanGaleriAltMetni" data-product-name="@Model.Baslik" class="w-full h-full object-contain transition-transform duration-700 ease-out group-hover:scale-[1.8] main-product-image drop-shadow-[0_12px_24px_rgba(0,0,0,0.15)]" alt="@varsayilanGaleriAltMetni" decoding="async" fetchpriority="high" onerror="this.onerror=null; this.src='@fallbackGorsel';">
                
                <button type="button" class="absolute left-4 top-1/2 -translate-y-1/2 bg-white/90 backdrop-blur-sm w-10 h-10 rounded-full shadow-md text-slate-800 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all hover:bg-[#00A4D3] hover:text-white z-10" onclick="navigateGallery('prev', event)">
                    <i class="fas fa-chevron-left"></i>
                </button>
                <button type="button" class="absolute right-4 top-1/2 -translate-y-1/2 bg-white/90 backdrop-blur-sm w-10 h-10 rounded-full shadow-md text-slate-800 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all hover:bg-[#00A4D3] hover:text-white z-10" onclick="navigateGallery('next', event)">
                    <i class="fas fa-chevron-right"></i>
                </button>

                <div class="absolute bottom-4 right-4 bg-white/90 backdrop-blur-sm w-10 h-10 rounded-full shadow-md text-slate-800 flex items-center justify-center z-10">
                    <i class="fas fa-search-plus"></i>
                </div>
            </div>
            
            @if (galeriMedyalari.Any())
            {
                <div class="flex gap-3 overflow-x-auto pb-2 custom-scrollbar">
                    @foreach (var resim in galeriMedyalari)
                    {
                        var altMetin = string.IsNullOrWhiteSpace(resim.AltMetin) ? Model.Baslik : resim.AltMetin;
                        <button type="button" class="thumbnail-item flex-shrink-0 w-20 h-20 md:w-24 md:h-24 rounded-xl border-2 @(string.Equals(resim.ResimYolu, varsayilanGaleriGorseli, StringComparison.OrdinalIgnoreCase) ? "border-[#00A4D3] ring-2 ring-[#00A4D3]/30" : "border-slate-200 hover:border-slate-400") overflow-hidden transition-all bg-[#F8FAFC]" data-image="@resim.ResimYolu" data-alt="@altMetin" onclick="changeProductImage(this.dataset.image, this, this.dataset.alt)">
                            <img src="@resim.EtkinPosterYolu" class="w-full h-full object-cover" alt="@altMetin" loading="lazy" decoding="async" onerror="this.onerror=null; this.src='@fallbackGorsel';">
                        </button>
                    }
                </div>
            }
        </div>

        <!-- Right: Product Info -->
        <div class="flex flex-col">
            <h1 class="font-serif text-3xl md:text-4xl lg:text-5xl font-bold text-slate-900 mb-4 leading-tight">@Model.Baslik</h1>
            
            <div class="flex items-center gap-4 mb-6">
                <div class="flex text-amber-400 text-sm">
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= tamYildiz) { <i class="fas fa-star"></i> }
                        else if (i == tamYildiz + 1 && yarimYildiz) { <i class="fas fa-star-half-alt"></i> }
                        else { <i class="far fa-star text-slate-300"></i> }
                    }
                </div>
                <span class="text-xs text-slate-500 font-medium">(@yorumSayisi değerlendirme)</span>
            </div>

            <div class="flex items-baseline gap-4 mb-6">
                <span id="priceDisplay" class="font-sans text-3xl sm:text-4xl font-extrabold tracking-tight text-[#E30613]">@gosterilecekFiyat.ToString("N2") @currencySymbol</span>
                @if (gosterilecekEskiFiyat.HasValue)
                {
                    <span id="oldPriceDisplay" class="text-lg text-slate-400 line-through mb-1 font-sans">@gosterilecekEskiFiyat.Value.ToString("N2") @currencySymbol</span>
                }
                else
                {
                    <span id="oldPriceDisplay" class="text-lg text-slate-400 line-through mb-1 hidden"></span>
                }
                @if (gosterilecekIndirimYuzdesi.HasValue)
                {
                    <span id="discountBadge" class="bg-[#E30613] text-white text-xs font-bold px-2.5 py-1 rounded-full mb-1">%@gosterilecekIndirimYuzdesi.Value İndirim</span>
                }
                else
                {
                    <span id="discountBadge" class="bg-[#E30613] text-white text-xs font-bold px-2.5 py-1 rounded-full mb-1 hidden"></span>
                }
            </div>

            <div class="flex flex-wrap items-center gap-y-2 gap-x-6 text-xs text-slate-600 mb-6 border-y border-slate-200 py-4">
                <span id="stockStatusText" class="flex items-center gap-2"><i class="@stokIkonClass"></i> @stokDurumuMetni</span>
                <span class="flex items-center gap-2"><i class="fas fa-truck text-[#00A4D3]"></i> @gosterilecekKargoSuresi iş günü içinde kargo</span>
                @if (gosterilecekUretimSuresi > 0)
                {
                    <span id="productionTimeText" class="flex items-center gap-2"><i class="fas fa-hammer text-[#00A4D3]"></i> @gosterilecekUretimSuresi iş günü üretim</span>
                }
            </div>

            <div id="variantSummaryText" class="text-sm text-slate-700 mb-6 font-medium @(string.IsNullOrWhiteSpace(seciliVaryantMetni) ? "hidden" : "")">
                <i class="fas fa-layer-group text-[#00A4D3] mr-1.5"></i>@seciliVaryantMetni
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.KisaAciklama))
            {
                <p class="text-sm text-slate-600 mb-8 leading-relaxed">@Model.KisaAciklama</p>
            }

            @if (secenekler.Any())
            {
                <div class="mb-8">
                    @if (ayrikLedSecimi)
                    {
                        <fieldset>
                            <legend class="block text-xs uppercase tracking-wider text-slate-900 font-bold mb-3">Ebat Seçiniz</legend>
                            <div class="flex flex-wrap gap-2.5">
                                @foreach (var olcu in olcuSecenekleri)
                                {
                                    var olcuSatinAlinabilir = secenekler.Any(x => x.Olcu == olcu.Olcu && x.SatinAlinabilirMi);
                                    <label class="relative rounded-xl border border-slate-200 px-4 py-2.5 text-slate-700 font-semibold transition-all hover:border-[#00A4D3] has-[:checked]:border-[#00A4D3] has-[:checked]:bg-[#00A4D3] has-[:checked]:text-white shadow-2xs @(!olcuSatinAlinabilir ? "cursor-not-allowed opacity-50" : "cursor-pointer")">
                                        <input type="radio" name="structuredVariantSize" value="@olcu.Olcu" class="variant-size-radio absolute h-0 w-0 opacity-0" checked="@(olcu.Olcu == varsayilanSecenek?.Olcu ? "checked" : null)" disabled="@(!olcuSatinAlinabilir ? "disabled" : null)" />
                                        <span class="text-sm">@olcu.Olcu</span>
                                    </label>
                                }
                            </div>
                        </fieldset>

                        <fieldset class="mt-6">
                            <legend class="block text-xs uppercase tracking-wider text-slate-900 font-bold mb-3">Aydınlatma Seçeneği</legend>
                            <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
                                @foreach (var aydinlatma in aydinlatmaSecenekleri)
                                {
                                    <label class="relative cursor-pointer rounded-xl border border-slate-200 bg-white px-4 py-3 text-slate-700 transition-all hover:border-[#00A4D3] has-[:checked]:border-[#00A4D3] has-[:checked]:bg-sky-50 has-[:checked]:text-[#00A4D3] has-[:disabled]:cursor-not-allowed has-[:disabled]:opacity-50 shadow-2xs">
                                        <input type="radio" name="structuredVariantLighting" value="@aydinlatma.Anahtar" class="variant-lighting-radio absolute h-0 w-0 opacity-0" checked="@(aydinlatma.Anahtar == varsayilanAydinlatma ? "checked" : null)" />
                                        <span class="flex items-center gap-2 text-sm font-semibold">
                                            <span class="h-3 w-3 flex-none rounded-full shadow-sm @aydinlatma.NoktaClass"></span>
                                            <span>@aydinlatma.Baslik</span>
                                        </span>
                                        <span class="mt-1 block text-xs text-slate-500">@aydinlatma.Aciklama</span>
                                        <span class="lighting-price-difference mt-1 block text-xs font-semibold text-[#00A4D3]" data-lighting-price="@aydinlatma.Anahtar"></span>
                                    </label>
                                }
                            </div>
                        </fieldset>

                        <div class="hidden" aria-hidden="true">
                            @foreach (var varyant in secenekler)
                            {
                                var varyantSatinAlinabilir = varyant.SatinAlinabilirMi;
                                var varyantMedyaUrl = !string.IsNullOrWhiteSpace(varyant.GorselUrl) ? varyant.GorselUrl : (varyantMedyaHaritasi.TryGetValue(varyant.Id, out var eslesen) ? eslesen : string.Empty);
                                var varyantUretimSuresi = varyant.UretimSuresiGun > 0 ? varyant.UretimSuresiGun : Model.UretimSuresiGun;
                                var cerceveliFiyat = KanvasProje.Core.Helpers.KanvasFiyatListesi.TryGetFiyat(varyant.Olcu, out var kanvasFiyati) ? kanvasFiyati.CerceveliKargoDahil : 0;
                                var aydinlatmaAnahtari = AydinlatmaAnahtari(varyant);
                                var varyantEtiketi = $"{varyant.Olcu} / {AydinlatmaBasligi(aydinlatmaAnahtari)}";
                                <input type="radio" id="variant-@varyant.Id" name="productVariant" value="@varyant.Id" class="variant-radio" checked="@(varyant.Id == varsayilanSecenek?.Id ? "checked" : null)" disabled="@(!varyantSatinAlinabilir ? "disabled" : null)" data-price="@varyant.SatisFiyati.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-framed-price="@cerceveliFiyat.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-oldprice="" data-stock="@varyant.StokAdedi" data-preorder="@varyant.OnSipariseAcikMi.ToString().ToLowerInvariant()" data-production="@varyantUretimSuresi" data-image="@varyantMedyaUrl" data-label="@varyantEtiketi" data-olcu="@varyant.Olcu" data-size="@varyant.Olcu" data-lighting="@aydinlatmaAnahtari" />
                            }
                        </div>
                    }
                    else
                    {
                        <label class="block text-xs uppercase tracking-wider text-slate-900 font-bold mb-3">Ebat Seçiniz</label>
                        <div class="flex flex-wrap gap-2.5">
                            @foreach (var varyant in secenekler)
                            {
                                var varyantSatinAlinabilir = varyant.SatinAlinabilirMi;
                                var varyantOldPrice = 0m;
                                var varyantMedyaUrl = !string.IsNullOrWhiteSpace(varyant.GorselUrl) ? varyant.GorselUrl : (varyantMedyaHaritasi.TryGetValue(varyant.Id, out var eslesen) ? eslesen : string.Empty);
                                var rawVb = string.IsNullOrWhiteSpace(varyant.VaryantBasligi) ? varyant.Olcu : varyant.VaryantBasligi;
                                var cleanVb = string.Join(" / ", rawVb.Split(new[] { " / " }, StringSplitOptions.RemoveEmptyEntries).Where(x => !x.Contains("Standart", StringComparison.OrdinalIgnoreCase) && !x.Contains("Bask", StringComparison.OrdinalIgnoreCase)));
                                if (string.IsNullOrWhiteSpace(cleanVb)) cleanVb = rawVb.Split('/')[0].Trim();
                                var varyantUretimSuresi = varyant.UretimSuresiGun > 0 ? varyant.UretimSuresiGun : Model.UretimSuresiGun;
                                var cerceveliFiyat = KanvasProje.Core.Helpers.KanvasFiyatListesi.TryGetFiyat(varyant.Olcu, out var kanvasFiyati) ? kanvasFiyati.CerceveliKargoDahil : 0;
                                var checkedAttr = varyant.Id == varsayilanSecenek?.Id ? "checked" : null;
                                var disabledAttr = !varyantSatinAlinabilir ? "disabled" : null;

                                <label class="relative border border-slate-200 rounded-xl px-4 py-2.5 cursor-pointer font-semibold transition-all hover:border-[#00A4D3] has-[:checked]:border-[#00A4D3] has-[:checked]:bg-[#00A4D3] has-[:checked]:text-white shadow-2xs @(!varyantSatinAlinabilir ? "opacity-50 cursor-not-allowed" : "text-slate-700")">
                                    <input type="radio" id="variant-@varyant.Id" name="productVariant" value="@varyant.Id" class="variant-radio absolute opacity-0 w-0 h-0" checked="@checkedAttr" disabled="@disabledAttr" data-price="@varyant.SatisFiyati.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-framed-price="@cerceveliFiyat.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-oldprice="@(varyantOldPrice > 0 ? varyantOldPrice.ToString(System.Globalization.CultureInfo.InvariantCulture) : string.Empty)" data-stock="@varyant.StokAdedi" data-preorder="@varyant.OnSipariseAcikMi.ToString().ToLowerInvariant()" data-production="@varyantUretimSuresi" data-image="@varyantMedyaUrl" data-label="@cleanVb" data-olcu="@cleanVb">
                                    <span class="text-sm">@cleanVb</span>
                                </label>
                            }
                        </div>
                    }
                </div>
            }

            @if (cerceveSecimiGerekli)
            {
                <div id="frameSelectionBlock" class="mb-8">
                    <label class="mb-3 block text-xs font-bold uppercase tracking-wider text-slate-900">Çerçeve Rengi Seçiniz</label>
                    <div class="grid grid-cols-4 gap-3 sm:grid-cols-7">
                        @{
                            var cerceveMap = new Dictionary<string, (string image, string label)>
                            {
                                { "Çerçevesiz", ("/cercevesiz.png", "Çerçevesiz") },
                                { "Siyah", ("/siyah çerçeve .png", "Siyah") },
                                { "Beyaz", ("/beyaz çerçeve .png", "Beyaz") },
                                { "Gold", ("/altın çerçeve.png", "Altın") },
                                { "Gümüş", ("/gümüş çerçeve.png", "Gümüş") },
                                { "Meşe", ("/naturel çerçeve.png", "Naturel") },
                                { "Ceviz", ("/kahve çerçeve.png", "Ceviz") }
                            }!;
                        }
                        @foreach (var cerceve in cerceveModelleri)
                        {
                            var map = cerceveMap.GetValueOrDefault(cerceve, (image: string.Empty, label: cerceve));
                            <label class="group relative cursor-pointer rounded-xl border-2 border-slate-200 bg-white p-2 text-center transition-all hover:border-[#00A4D3] has-[:checked]:border-[#00A4D3] has-[:checked]:bg-sky-50 has-[:checked]:shadow-sm"
                                   title="@map.label"
                                   onclick="selectFrameOption(this, '@cerceve'); updatePriceWithFrame();">
                                <input type="radio" name="CerceveModeli" value="@cerceve" class="frame-radio absolute h-0 w-0 opacity-0" />
                                <div class="mb-1.5 flex h-16 items-center justify-center">
                                    <img src="@map.image" alt="@map.label" class="max-h-full max-w-full object-contain" loading="lazy" onerror="this.style.display='none'" />
                                </div>
                                <span class="text-[11px] font-semibold text-slate-700 group-has-[:checked]:text-[#00A4D3]">@map.label</span>
                                <div class="absolute -top-1.5 -right-1.5 hidden h-4 w-4 items-center justify-center rounded-full bg-[#00A4D3] group-has-[:checked]:flex">
                                    <svg class="h-2.5 w-2.5 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                                </div>
                            </label>
                        }
                    </div>
                    <p id="frameSelectionError" class="mt-2 hidden text-xs font-semibold text-red-600">Çerçeve rengi seçilmelidir.</p>
                </div>
            }

            @if (stoktaVar)
            {
                <div class="flex items-end gap-3 sm:gap-4 mb-8">
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-slate-900 font-bold mb-3">Adet</label>
                        <div class="flex items-center border border-slate-200 rounded-xl bg-white shadow-2xs">
                            <button type="button" class="w-10 h-12 flex items-center justify-center text-slate-700 hover:bg-slate-50 transition-colors rounded-l-xl font-bold" onclick="decreaseQuantity()">-</button>
                            <input type="number" id="productQuantity" class="w-12 h-12 text-center text-sm border-none bg-transparent p-0 focus:ring-0 text-slate-900 font-bold" value="@minSiparisAdedi" min="@minSiparisAdedi" max="@maxSiparisAdedi" readonly>
                            <button type="button" class="w-10 h-12 flex items-center justify-center text-slate-700 hover:bg-slate-50 transition-colors rounded-r-xl font-bold" onclick="increaseQuantity()">+</button>
                        </div>
                    </div>
                    
                    <form id="addToCartForm" method="post" action="/Sepet/Ekle" class="flex-1">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="UrunId" value="@Model.Id" />
                        <input type="hidden" id="selectedVariantId" name="SecenekId" value="@varsayilanSecenek?.Id" />
                        <input type="hidden" id="selectedQuantity" name="Adet" value="@minSiparisAdedi" />
                        <input type="hidden" id="selectedFrameModel" name="CerceveModeli" value="@(cerceveSecimiGerekli ? "" : "Çerçevesiz")" />
                        <input type="hidden" id="selectedFrameFarki" name="CerceveFarki" value="0" />

                        <div class="flex min-w-0 gap-2">
                            <button type="button" id="ajaxSepetBtn" class="min-w-0 flex-1 h-12 px-4 bg-[#E30613] hover:bg-[#DC2626] text-white text-xs sm:text-sm font-bold uppercase tracking-wider rounded-xl shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2 whitespace-nowrap active:scale-[0.98]">
                                <i class="fas fa-shopping-bag add-to-cart-icon flex-shrink-0 text-sm"></i> <span class="add-to-cart-text truncate">Sepete Ekle</span>
                            </button>
                            <a href="/Sepet" class="flex-none w-12 sm:w-36 h-12 bg-[#00A4D3] hover:bg-[#0284C7] text-white text-xs font-bold uppercase tracking-wider rounded-xl shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2 whitespace-nowrap" aria-label="Sepete Git">
                                <i class="fas fa-shopping-cart flex-shrink-0"></i> <span class="hidden sm:inline">Sepete Git</span>
                            </a>
                        </div>
                    </form>
                    <button type="button" onclick="window.toggleFavori(this, @Model.Id)" class="group/btn h-12 w-12 flex-shrink-0 flex items-center justify-center border border-slate-200 rounded-xl hover:border-[#E30613] hover:text-[#E30613] transition-colors bg-white shadow-2xs" title="Favorilere Ekle">
                        <i class="far fa-heart text-slate-500 group-hover/btn:text-[#E30613] transition-colors text-lg"></i>
                    </button>
                </div>

                <div id="selectionSummary" class="hidden mb-4 bg-sky-50 border-2 border-[#00A4D3] rounded-xl px-4 py-3 sm:px-5 sm:py-3.5">
                    <div class="flex items-center justify-center gap-1.5 overflow-hidden text-center sm:gap-2">
                        <div class="flex shrink-0 items-center gap-1 sm:gap-2">
                            <i class="fas fa-ruler-combined hidden sm:inline text-[#00A4D3] text-sm sm:text-base"></i>
                            <span id="summaryOlcu" class="whitespace-nowrap text-sm sm:text-base font-bold text-slate-900">-</span>
                        </div>
                        @if (cerceveSecimiGerekli)
                        {
                            <span class="shrink-0 text-sky-300 text-sm sm:text-base font-light">|</span>
                            <div class="min-w-0 max-w-[42%] sm:max-w-none">
                                <span id="summaryCerceve" class="block truncate text-sm sm:text-base font-bold text-slate-900">Çerçeve seçiniz</span>
                            </div>
                        }
                        <span class="shrink-0 text-sky-300 text-sm sm:text-base font-light">|</span>
                        <div class="flex shrink-0 items-center">
                            <span id="summaryFiyat" class="whitespace-nowrap text-base sm:text-xl font-black text-[#E30613]">0 @currencySymbol</span>
                            <span id="summaryBirimFiyat" class="hidden sm:inline text-xs text-slate-500 font-normal ml-1"></span>
                        </div>
                    </div>
                </div>

                <div class="mb-8 flex flex-wrap items-center gap-3 border-y border-slate-200 py-4">
                    <span class="mr-1 text-xs uppercase tracking-wider text-slate-500 font-semibold">Paylaş</span>
                    <a href="https://www.facebook.com/sharer/sharer.php?u=@encodedProductUrl" target="_blank" rel="noopener noreferrer" aria-label="Facebook'ta paylaş" class="flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-700 transition-colors hover:border-[#00A4D3] hover:text-[#00A4D3]">
                        <i class="fab fa-facebook-f text-sm"></i>
                    </a>
                    <a href="@(string.IsNullOrWhiteSpace(siteSettings.InstagramUrl) ? "https://www.instagram.com/" : siteSettings.InstagramUrl)" target="_blank" rel="noopener noreferrer" aria-label="Instagram'da aç" class="flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-700 transition-colors hover:border-[#00A4D3] hover:text-[#00A4D3]">
                        <i class="fab fa-instagram text-sm"></i>
                    </a>
                    <a href="https://wa.me/?text=@encodedProductTitle%20@encodedProductUrl" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp ile paylaş" class="flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-700 transition-colors hover:border-[#00A4D3] hover:text-[#00A4D3]">
                        <i class="fab fa-whatsapp text-sm"></i>
                    </a>
                    <button type="button" onclick="copyProductLink(this)" data-url="@productUrl" class="flex h-9 items-center gap-2 rounded-full border border-slate-200 bg-white px-4 text-xs uppercase tracking-wider text-slate-700 font-semibold transition-colors hover:border-[#00A4D3] hover:text-[#00A4D3]">
                        <i class="fas fa-link text-xs"></i>
                        Linki Kopyala
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.MalzemeBilgisi) || !string.IsNullOrWhiteSpace(Model.PaketlemeBilgisi))
                {
                    <div class="mb-8 border-l-4 border-[#00A4D3] bg-[#F8FAFC] px-5 py-4 rounded-r-xl">
                        @if (!string.IsNullOrWhiteSpace(Model.MalzemeBilgisi))
                        {
                            <p class="mb-2 text-sm text-slate-900"><span class="font-bold">Malzeme:</span> @Model.MalzemeBilgisi</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.PaketlemeBilgisi))
                        {
                            <p class="text-sm text-slate-600"><span class="font-bold text-slate-900">Paketleme:</span> @Model.PaketlemeBilgisi</p>
                        }
                    </div>
                }

                <div class="mb-8 grid grid-cols-1 gap-3 sm:grid-cols-3">
                    <div class="border border-slate-200 bg-white px-4 py-3 rounded-xl shadow-2xs">
                        <p class="mb-1 flex items-center gap-2 text-[10px] uppercase tracking-wider text-slate-900 font-bold"><i class="fas fa-industry text-[#00A4D3]"></i> Üretim</p>
                        <p id="productionCardText" class="text-sm text-slate-600">@(gosterilecekUretimSuresi > 0 ? $"{gosterilecekUretimSuresi} iş günü" : "Siparişe özel hazırlanır")</p>
                    </div>
                    <div class="border border-slate-200 bg-white px-4 py-3 rounded-xl shadow-2xs">
                        <p class="mb-1 flex items-center gap-2 text-[10px] uppercase tracking-wider text-slate-900 font-bold"><i class="fas fa-box-open text-[#00A4D3]"></i> Paketleme</p>
                        <p class="text-sm text-slate-600">Özenli ve korunaklı teslimat</p>
                    </div>
                    <div class="border border-slate-200 bg-white px-4 py-3 rounded-xl shadow-2xs">
                        <p class="mb-1 flex items-center gap-2 text-[10px] uppercase tracking-wider text-slate-900 font-bold"><i class="fas fa-route text-[#00A4D3]"></i> Teslimat</p>
                        <p class="text-sm text-slate-600">Tahmini @gosterilecekTeslimSuresi iş günü</p>
                    </div>
                </div>
            }
            else
            {
                <div class="bg-amber-50 border border-amber-200 text-amber-800 p-4 rounded-xl text-sm mb-8">
                    Bu ürün şu anda satın almaya uygun değil. Stok bilgisi güncellendiğinde tekrar deneyin.
                </div>
            }

            <div class="grid grid-cols-3 gap-2 py-4 border-y border-slate-200">
                <div class="text-center">
                    <i class="fas fa-shield-alt text-[#00A4D3] mb-2 text-xl"></i>
                    <p class="text-xs text-slate-900 font-bold mb-1">Güvenli Ödeme</p>
                    <p class="text-[10px] text-slate-500">256-bit SSL</p>
                </div>
                <div class="text-center">
                    <i class="fas fa-truck text-[#00A4D3] mb-2 text-xl"></i>
                    <p class="text-xs text-slate-900 font-bold mb-1">Hızlı Teslimat</p>
                    <p class="text-[10px] text-slate-500">@gosterilecekKargoSuresi iş günü kargo</p>
                </div>
                <div class="text-center">
                    <i class="fas fa-undo-alt text-[#00A4D3] mb-2 text-xl"></i>
                    <p class="text-xs text-slate-900 font-bold mb-1">İade Garantisi</p>
                    <p class="text-[10px] text-slate-500">@iadeSuresi gün içinde</p>
                </div>
            </div>
            
        </div>
    </div>

    <!-- Tabs Section -->
    <div class="mt-20 border-t border-slate-200 pt-12">
        <div class="flex flex-col lg:flex-row gap-12">
            
            <!-- Left: Description and Specs -->
            <div class="lg:w-2/3 space-y-12">
                <div>
                    <h2 class="font-serif text-2xl font-bold text-slate-900 mb-6 flex items-center gap-3">
                        <i class="fas fa-file-alt text-[#00A4D3]"></i> Ürün Açıklaması
                    </h2>
                    <div class="prose prose-sm max-w-none text-slate-600 leading-relaxed">
                        @Html.Raw(Model.Aciklama ?? "Bu ürün için açıklama girilmemiştir.")
                    </div>
                </div>

                @if (teknikTabloSatirlari.Any())
                {
                    <div>
                        <h2 class="font-serif text-2xl font-bold text-slate-900 mb-6 flex items-center gap-3">
                            <i class="fas fa-cogs text-[#00A4D3]"></i> Teknik Özellikler
                        </h2>
                        <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-2xs">
                            <table class="w-full text-sm text-left">
                                <tbody class="divide-y divide-slate-200">
                                    @foreach (var satir in teknikTabloSatirlari)
                                    {
                                        <tr class="hover:bg-slate-50 transition-colors">
                                            <th class="px-6 py-4 font-bold text-slate-900 w-1/3 bg-[#F8FAFC]">@satir.Baslik</th>
                                            <td class="px-6 py-4 text-slate-600">@satir.Deger</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                
                @if (medyaVitriniVar)
                {
                    <div>
                        <h2 class="font-serif text-2xl font-bold text-slate-900 mb-6 flex items-center gap-3">
                            <i class="fas fa-photo-video text-[#00A4D3]"></i> Medya & Galeriler
                        </h2>
                        
                        @if (videoMedyalari.Any())
                        {
                            <div class="mb-8">
                                <h3 class="text-lg font-bold text-slate-900 mb-4">Video Anlatımı</h3>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                    @foreach (var medya in videoMedyalari)
                                    {
                                        <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-2xs">
                                            <div class="aspect-video bg-black relative">
                                                @if (!string.IsNullOrWhiteSpace(ProductMediaEmbedHelper.GetEmbedUrl(medya.EtkinKaynak)))
                                                {
                                                    <iframe src="@ProductMediaEmbedHelper.GetEmbedUrl(medya.EtkinKaynak)" class="w-full h-full" title="@medya.Baslik" allowfullscreen></iframe>
                                                }
                                                else
                                                {
                                                    <video controls class="w-full h-full object-cover" poster="@medya.EtkinPosterYolu">
                                                        <source src="@(string.IsNullOrWhiteSpace(medya.VideoUrl) ? medya.ResimYolu : medya.VideoUrl)" type="video/mp4" />
                                                    </video>
                                                }
                                            </div>
                                            <div class="p-4">
                                                <h5 class="text-sm font-bold text-slate-900 mb-1">@medya.Baslik</h5>
                                                <p class="text-xs text-slate-500">@UrunMedyaCatalog.GetAreaLabel(medya.MedyaAlani)</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                    </div>
                }
            </div>

            <!-- Right: Reviews -->
            <div class="lg:w-1/3">
                <h2 class="font-serif text-2xl font-bold text-slate-900 mb-6 flex items-center gap-3">
                    <i class="fas fa-comments text-[#00A4D3]"></i> Değerlendirmeler
                </h2>
                
                @if (yorumlar != null && yorumlar.Count > 0)
                {
                    <div class="bg-white border border-slate-200 rounded-xl p-6 text-center mb-8 shadow-2xs">
                        <h3 class="font-serif text-5xl font-bold text-slate-900 mb-2">@ortalamaPuan.ToString("0.0")</h3>
                        <div class="text-amber-400 mb-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= tamYildiz) { <i class="fas fa-star"></i> }
                                else if (i == tamYildiz + 1 && yarimYildiz) { <i class="fas fa-star-half-alt"></i> }
                                else { <i class="far fa-star text-slate-300"></i> }
                            }
                        </div>
                        <p class="text-sm text-slate-500 mb-4">Toplam @yorumSayisi değerlendirme</p>
                        <button class="w-full border border-[#00A4D3] text-[#00A4D3] text-xs font-bold tracking-wider uppercase py-2.5 rounded-xl hover:bg-[#00A4D3] hover:text-white transition-colors" id="openCommentModalBtn">
                            Yorum Yap
                        </button>
                    </div>

                    <div class="space-y-4">
                        @foreach (var yorum in yorumlar.Take(3))
                        {
                            <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-2xs">
                                <div class="flex items-start justify-between mb-2">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-full bg-sky-50 text-[#00A4D3] flex items-center justify-center font-bold text-sm">
                                            @{
                                                var names = yorum.AdSoyad.Split(' ');
                                                string initials = "";
                                                if (names.Length > 0) { initials += names[0][0]; }
                                                if (names.Length > 1) { initials += names[names.Length - 1][0]; }
                                                else if (names[0].Length > 1) { initials += names[0][1]; }
                                            }
                                            @initials
                                        </div>
                                        <div>
                                            <h5 class="text-sm font-bold text-slate-900">@yorum.AdSoyad</h5>
                                            <div class="text-amber-400 text-[10px]">
                                                @for (int i = 0; i < yorum.Puan; i++) { <i class="fas fa-star"></i> }
                                            </div>
                                        </div>
                                    </div>
                                    <span class="text-[10px] text-slate-400">@yorum.OlusturulmaTarihi.ToTurkeyString("dd MMM yyyy")</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(yorum.YorumMetni))
                                {
                                    <p class="text-sm text-slate-600 mt-2">@yorum.YorumMetni</p>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-12 bg-white border border-slate-200 rounded-xl shadow-2xs">
                        <i class="far fa-comments fa-3x text-slate-300 mb-4"></i>
                        <h5 class="text-slate-900 font-bold mb-2">Henüz yorum yapılmamış</h5>
                        <p class="text-sm text-slate-500 mb-6">Bu ürün için ilk yorumu siz yapın!</p>
                        <button class="bg-[#00A4D3] hover:bg-[#0284C7] text-white text-xs font-bold tracking-wider uppercase px-6 py-2.5 rounded-xl shadow-md transition-colors" id="openCommentModalBtnEmpty">
                            İlk Yorumu Yap
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@{
    var benzerUrunler = ViewBag.BenzerUrunler as List<KanvasProje.Core.DTOs.BenzerUrunDto>;
}
@if (benzerUrunler != null && benzerUrunler.Count > 0)
{
    <section class="py-16 bg-[#F8FAFC] border-t border-slate-200">
        <div class="container mx-auto px-4">
            <div class="flex items-center justify-center mb-10">
                <hr class="w-1/4 border-slate-200 hidden md:block"/>
                <h2 class="font-serif text-3xl font-bold mx-8 text-center text-slate-900">Benzer Ürünler</h2>
                <hr class="w-1/4 border-slate-200 hidden md:block"/>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4 md:gap-6">
                @foreach (var item in benzerUrunler)
                {
                    decimal itemFiyat = item.IndirimliFiyat ?? item.Fiyat;
                    decimal? bEskiFiyat = (item.IndirimliFiyat != null && item.IndirimliFiyat < item.Fiyat) ? item.Fiyat : null;
                    string bProductUrl = !string.IsNullOrEmpty(item.Slug) ? $"/Urun/Detay/{item.Slug}-{item.Id}" : $"/Urun/Detay/{KanvasProje.Core.Helpers.SlugHelper.GenerateSlug(item.Baslik)}-{item.Id}";
                    string gorsel = !string.IsNullOrEmpty(item.AnaGorselUrl) ? item.AnaGorselUrl : "/img/products/placeholder.webp";
                    <a href="@bProductUrl" class="group block bg-white p-3 rounded-xl border border-slate-200 hover:border-[#00A4D3] shadow-2xs hover:shadow-md transition-all">
                        <div class="relative overflow-hidden mb-3 aspect-square bg-[#F8FAFC] rounded-lg">
                            <img alt="@item.Baslik" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="@gorsel" loading="lazy" decoding="async" />
                        </div>
                        <h3 class="text-xs font-bold text-slate-800 tracking-wide line-clamp-2 mb-1 group-hover:text-[#00A4D3] transition-colors">@item.Baslik</h3>
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-extrabold text-[#E30613]">@itemFiyat.ToString("N2") TL</span>
                            @if (bEskiFiyat != null)
                            {
                                <span class="text-xs text-slate-400 line-through">@bEskiFiyat?.ToString("N2") TL</span>
                            }
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>
}



<script>
const PRODUCT_CURRENCY = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currencySymbol));

// Modal event listeners
document.addEventListener('DOMContentLoaded', function() {
    const desktopModal = document.getElementById('desktopLightboxModal');
    const mobileModal = document.getElementById('mobileLightbox');
    const closeBtn = document.getElementById('closeDesktopModalBtn');

    [desktopModal, mobileModal].forEach(modal => {
        if (modal && modal.parentElement !== document.body) {
            document.body.appendChild(modal);
        }
    });

    if (closeBtn && desktopModal) {
        closeBtn.addEventListener('click', closeDesktopLightbox);
    }

    [desktopModal, mobileModal].forEach(modal => {
        if (modal) {
            modal.addEventListener('click', event => {
                if (event.target === modal) {
                    closeProductLightbox();
                }
            });
        }
    });

    window.addEventListener('keydown', event => {
        if (event.key === 'Escape' || event.code === 'Escape') {
            closeProductLightbox();
        }
    }, true);

    const commentModal = document.getElementById('commentModal');
    if (commentModal) {
        const openBtns = [document.getElementById('openCommentModalBtn'), document.getElementById('openCommentModalBtnEmpty')];
        openBtns.forEach(btn => btn && btn.addEventListener('click', () => {
            commentModal.classList.remove('hidden');
            commentModal.classList.add('flex');
        }));

        const closeCommentBtn = document.getElementById('closeCommentModalBtn');
        if (closeCommentBtn) {
            closeCommentBtn.addEventListener('click', () => {
                commentModal.classList.add('hidden');
                commentModal.classList.remove('flex');
            });
        }

        const starRatingGroup = document.getElementById('starRatingGroup');
        if (starRatingGroup) {
            const starBtns = starRatingGroup.querySelectorAll('.star-btn');
            const hiddenInput = document.getElementById('selectedPuan');
            const labelSpan = document.getElementById('starRatingLabel');
            const starLabels = {
                1: '1 Yıldız - Çok Kötü',
                2: '2 Yıldız - Kötü',
                3: '3 Yıldız - Orta',
                4: '4 Yıldız - İyi',
                5: '5 Yıldız - Mükemmel'
            };

            function updateStarDisplay(rating) {
                starBtns.forEach(btn => {
                    const val = parseInt(btn.getAttribute('data-value'), 10);
                    if (val <= rating) {
                        btn.classList.remove('text-gray-300');
                        btn.classList.add('text-amber-400');
                    } else {
                        btn.classList.remove('text-amber-400');
                        btn.classList.add('text-gray-300');
                    }
                });
                if (labelSpan && starLabels[rating]) {
                    labelSpan.textContent = starLabels[rating];
                }
            }

            starBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    const val = parseInt(btn.getAttribute('data-value'), 10);
                    if (hiddenInput) hiddenInput.value = val;
                    updateStarDisplay(val);
                });
                btn.addEventListener('mouseenter', () => {
                    const val = parseInt(btn.getAttribute('data-value'), 10);
                    updateStarDisplay(val);
                });
            });

            starRatingGroup.addEventListener('mouseleave', () => {
                const currentVal = parseInt(hiddenInput?.value, 10) || 5;
                updateStarDisplay(currentVal);
            });

            updateStarDisplay(parseInt(hiddenInput?.value, 10) || 5);
        }
    }

    setTimeout(updateSelectionSummary, 100);
});

let currentZoom = 1;
let currentRotation = 0;
let previousBodyOverflow = '';

function syncLightboxImage() {
    const mainImage = document.getElementById('mainProductImage');
    if (!mainImage) return;

    const imageSrc = mainImage.currentSrc || mainImage.src;
    const imageAlt = mainImage.alt || mainImage.getAttribute('data-product-name') || '';

    const desktopImage = document.getElementById('desktopLightboxImage');
    if (desktopImage && imageSrc) {
        desktopImage.src = imageSrc;
        desktopImage.alt = imageAlt;
    }

    const mobileImage = document.getElementById('mobileLightboxImage');
    if (mobileImage && imageSrc) {
        mobileImage.src = imageSrc;
        mobileImage.alt = imageAlt;
    }
}

function lockLightboxScroll() {
    previousBodyOverflow = document.body.style.overflow;
    document.body.style.overflow = 'hidden';
}

function unlockLightboxScroll() {
    document.body.style.overflow = previousBodyOverflow;
}

function openProductLightbox() {
    syncLightboxImage();
    lockLightboxScroll();

    if (window.innerWidth >= 1024) {
        const dm = document.getElementById('desktopLightboxModal');
        if (dm) {
            dm.classList.remove('hidden');
            dm.classList.add('flex');
            resetDesktopZoom();
        }
    } else {
        const mm = document.getElementById('mobileLightbox');
        if (mm) {
            mm.classList.remove('hidden');
            mm.classList.add('flex');
            resetMobileZoom();
        }
    }
}

function closeProductLightbox() {
    closeDesktopLightbox();
    closeMobileLightbox();
}

function closeDesktopLightbox() {
    const dm = document.getElementById('desktopLightboxModal');
    if (dm) {
        dm.classList.add('hidden');
        dm.classList.remove('flex');
        resetDesktopZoom();
    }
    unlockLightboxScroll();
}

function closeMobileLightbox() {
    const mm = document.getElementById('mobileLightbox');
    if (mm) {
        mm.classList.add('hidden');
        mm.classList.remove('flex');
        resetMobileZoom();
    }
    unlockLightboxScroll();
}

function resetMobileZoom() {
    currentZoom = 1;
    currentRotation = 0;
    updateMobileTransform();
}

function zoomInMobile() {
    if (currentZoom < 3) { currentZoom += 0.5; updateMobileTransform(); }
}

function zoomOutMobile() {
    if (currentZoom > 1) { currentZoom -= 0.5; updateMobileTransform(); }
}

function rotateMobileImage() {
    currentRotation = (currentRotation + 90) % 360;
    updateMobileTransform();
}

function updateMobileTransform() {
    const img = document.getElementById('mobileLightboxImage');
    if (img) img.style.transform = `scale(${currentZoom}) rotate(${currentRotation}deg)`;
    const zl = document.getElementById('zoomLevel');
    if (zl) zl.innerText = `${Math.round(currentZoom * 100)}%`;
}

function resetDesktopZoom() {
    currentZoom = 1;
    currentRotation = 0;
    updateDesktopTransform();
}

function zoomInDesktop() {
    if (currentZoom < 3) { currentZoom += 0.5; updateDesktopTransform(); }
}

function zoomOutDesktop() {
    if (currentZoom > 1) { currentZoom -= 0.5; updateDesktopTransform(); }
}

function rotateDesktopImage() {
    currentRotation = (currentRotation + 90) % 360;
    updateDesktopTransform();
}

function updateDesktopTransform() {
    const img = document.getElementById('desktopLightboxImage');
    if (img) {
        img.style.transform = `scale(${currentZoom}) rotate(${currentRotation}deg)`;
    }
}

function changeProductImage(imageUrl, thumbnailElement, altText) {
    const mainImage = document.getElementById('mainProductImage');
    if (mainImage) {
        mainImage.src = imageUrl;
        if (altText) mainImage.alt = altText;
    }
    
    const deskImg = document.getElementById('desktopLightboxImage');
    if (deskImg) deskImg.src = imageUrl;
    
    const mobImg = document.getElementById('mobileLightboxImage');
    if (mobImg) mobImg.src = imageUrl;
    
    const thumbnails = document.querySelectorAll('.thumbnail-item');
    thumbnails.forEach(item => {
        if (item) {
            item.classList.remove('border-[#00A4D3]', 'ring-2', 'ring-[#00A4D3]/30');
            item.classList.add('border-slate-200');
        }
    });
    if (thumbnailElement) {
        thumbnailElement.classList.remove('border-slate-200');
        thumbnailElement.classList.add('border-[#00A4D3]', 'ring-2', 'ring-[#00A4D3]/30');
        thumbnailElement.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    }

}

function resolveFramePrice(selectedVariant, cerceve) {
    var basePrice = parseFloat(selectedVariant?.getAttribute('data-price')) || 0;
    if (!cerceve || cerceve === 'Çerçevesiz') return basePrice;

    return parseFloat(selectedVariant?.getAttribute('data-framed-price')) || basePrice;
}

function updateSelectionSummary() {
    var selectedVariant = document.querySelector('.variant-radio:checked');
    var selectedFrame = document.querySelector('.frame-radio:checked');
    var summary = document.getElementById('selectionSummary');
    if (!summary) return;

    if (!selectedVariant && !selectedFrame) {
        summary.classList.add('hidden');
        return;
    }

    var olcu = selectedVariant ? selectedVariant.getAttribute('data-olcu') || selectedVariant.getAttribute('data-label') || '-' : '-';
    var cerceve = selectedFrame ? selectedFrame.value : null;
    var adet = parseInt(document.getElementById('productQuantity')?.value) || 1;
    var toplamBirim = resolveFramePrice(selectedVariant, cerceve || 'Çerçevesiz');
    var toplam = toplamBirim * adet;

    var summaryOlcuEl = document.getElementById('summaryOlcu');
    if (summaryOlcuEl) summaryOlcuEl.textContent = olcu;

    var summaryCerceveEl = document.getElementById('summaryCerceve');
    if (summaryCerceveEl) {
        summaryCerceveEl.textContent = cerceve || 'Çerçeve seçiniz';
    }

    var summaryFiyatEl = document.getElementById('summaryFiyat');
    if (summaryFiyatEl) {
        summaryFiyatEl.textContent = toplam.toLocaleString('tr-TR', { minimumFractionDigits: 0, maximumFractionDigits: 2 }) + ' @currencySymbol';
    }

    var summaryBirimFiyatEl = document.getElementById('summaryBirimFiyat');
    if (summaryBirimFiyatEl) {
        summaryBirimFiyatEl.textContent = adet > 1 ? `(birim: ${toplamBirim.toLocaleString('tr-TR', { minimumFractionDigits: 0, maximumFractionDigits: 2 })} @currencySymbol)` : '';
    }

    summary.classList.remove('hidden');
}

function updatePriceWithFrame() {
    var selectedVariant = document.querySelector('.variant-radio:checked');
    var selectedFrame = document.querySelector('.frame-radio:checked');
    if (!selectedVariant) return;

    var cerceve = selectedFrame ? selectedFrame.value : null;
    var basePrice = parseFloat(selectedVariant.getAttribute('data-price')) || 0;
    var newPrice = resolveFramePrice(selectedVariant, cerceve || 'Çerçevesiz');
    var cerceveFarki = newPrice - basePrice;

    var priceDisplay = document.getElementById('priceDisplay');
    if (priceDisplay) {
        priceDisplay.innerHTML = `${newPrice.toLocaleString('tr-TR', { minimumFractionDigits: 0, maximumFractionDigits: 2 })} @currencySymbol`;
    }

    var frameFarkiInput = document.getElementById('selectedFrameFarki');
    if (frameFarkiInput) {
        frameFarkiInput.value = cerceveFarki.toFixed(2);
    }

    updateSelectionSummary();
}

document.querySelectorAll('.variant-radio').forEach(radio => {
    radio.addEventListener('change', function() {
        if (this.checked) {
            const price = parseFloat(this.getAttribute('data-price')) || 0;
            const oldPrice = parseFloat(this.getAttribute('data-oldprice')) || 0;
            const imageUrl = this.getAttribute('data-image');
            const label = this.getAttribute('data-label');
            const isPreorder = this.getAttribute('data-preorder') === 'true';
            const stock = parseInt(this.getAttribute('data-stock')) || 0;
            const productionDays = parseInt(this.getAttribute('data-production')) || 0;

            const selectedVariantId = document.getElementById('selectedVariantId');
            if (selectedVariantId) selectedVariantId.value = this.value;

            updatePriceWithFrame();
            
            const oldPriceDisplay = document.getElementById('oldPriceDisplay');
            const discountBadge = document.getElementById('discountBadge');
            
            if (oldPrice > price) {
                if (oldPriceDisplay) {
                    oldPriceDisplay.innerHTML = `${oldPrice.toLocaleString('tr-TR', {minimumFractionDigits: 2})} ${PRODUCT_CURRENCY}`;
                    oldPriceDisplay.classList.remove('hidden');
                }
                if (discountBadge) {
                    const discount = Math.round((1 - (price / oldPrice)) * 100);
                    discountBadge.innerHTML = `%${discount} İndirim`;
                    discountBadge.classList.remove('hidden');
                }
            } else {
                if (oldPriceDisplay) oldPriceDisplay.classList.add('hidden');
                if (discountBadge) discountBadge.classList.add('hidden');
            }
            
            if (imageUrl) {
                changeProductImage(imageUrl, null, label);
            }
            
            const variantSummary = document.getElementById('variantSummaryText');
            if (variantSummary) {
                variantSummary.innerHTML = `<i class="fas fa-layer-group mr-1.5"></i> ${label}`;
                variantSummary.classList.remove('hidden');
            }
            
            const stockStatusText = document.getElementById('stockStatusText');
            if (stockStatusText) {
                if (stock > 0) {
                    stockStatusText.innerHTML = `<i class="fas fa-check-circle text-green-600"></i> Siparişe özel hazırlanır`;
                } else if (isPreorder) {
                    stockStatusText.innerHTML = `<i class="fas fa-clock text-blue-600"></i> Ön Siparişe Açık`;
                } else {
                    stockStatusText.innerHTML = `<i class="fas fa-times-circle text-red-600"></i> Satışa kapalı`;
                }
            }

            const productionTimeText = document.getElementById('productionTimeText');
            if (productionTimeText && productionDays > 0) {
                productionTimeText.innerHTML = `<i class="fas fa-hammer text-[#a09e99]"></i> ${productionDays} iş günü üretim`;
            }

            const productionCardText = document.getElementById('productionCardText');
            if (productionCardText && productionDays > 0) {
                productionCardText.innerText = `${productionDays} iş günü`;
            }
            
            const quantityInput = document.getElementById('productQuantity');
            if (quantityInput) {
                quantityInput.max = stock > 0 ? stock : (isPreorder ? 99 : 1);
                const minQuantity = parseInt(quantityInput.getAttribute('min')) || 1;
                quantityInput.value = minQuantity;
                const selectedQuantity = document.getElementById('selectedQuantity');
                if (selectedQuantity) selectedQuantity.value = minQuantity;
            }
        }
    });
});

document.querySelectorAll('.frame-radio').forEach(radio => {
    radio.addEventListener('change', function () {
        const selectedFrameModel = document.getElementById('selectedFrameModel');
        if (selectedFrameModel) selectedFrameModel.value = this.value;
        const frameSelectionError = document.getElementById('frameSelectionError');
        const frameSelectionBlock = document.getElementById('frameSelectionBlock');
        if (frameSelectionError) frameSelectionError.classList.add('hidden');
        if (frameSelectionBlock) frameSelectionBlock.classList.remove('ring-2', 'ring-red-400', 'ring-offset-2');

        updatePriceWithFrame();
    });
});

document.querySelectorAll('.variant-radio').forEach(radio => {
    radio.addEventListener('change', function () {
        updatePriceWithFrame();
    });
});

function syncStructuredVariantSelection() {
    const selectedSize = document.querySelector('.variant-size-radio:checked')?.value;
    const lightingControls = Array.from(document.querySelectorAll('.variant-lighting-radio'));
    const variants = Array.from(document.querySelectorAll('.variant-radio[data-size][data-lighting]'));
    if (!selectedSize || lightingControls.length === 0 || variants.length === 0) return;

    const variantsForSize = variants.filter(variant => variant.dataset.size === selectedSize);
    lightingControls.forEach(control => {
        control.disabled = !variantsForSize.some(variant =>
            variant.dataset.lighting === control.value && !variant.disabled);
    });

    let selectedLighting = lightingControls.find(control => control.checked && !control.disabled);
    if (!selectedLighting) {
        selectedLighting = lightingControls.find(control => control.value === 'ledsiz' && !control.disabled)
            || lightingControls.find(control => !control.disabled);
        if (selectedLighting) selectedLighting.checked = true;
    }

    const ledsizVariant = variantsForSize.find(variant =>
        variant.dataset.lighting === 'ledsiz' && !variant.disabled);
    const ledsizFiyat = parseFloat(ledsizVariant?.dataset.price || '0');
    document.querySelectorAll('.lighting-price-difference').forEach(element => {
        const lightingVariant = variantsForSize.find(variant =>
            variant.dataset.lighting === element.dataset.lightingPrice && !variant.disabled);
        const lightingPrice = parseFloat(lightingVariant?.dataset.price || '0');
        const fark = lightingPrice - ledsizFiyat;
        element.textContent = element.dataset.lightingPrice !== 'ledsiz' && fark > 0
            ? `+${fark.toLocaleString('tr-TR', { maximumFractionDigits: 2 })} ${PRODUCT_CURRENCY}`
            : '';
    });

    const targetVariant = variantsForSize.find(variant =>
        variant.dataset.lighting === selectedLighting?.value && !variant.disabled);
    if (!targetVariant) return;

    if (!targetVariant.checked) {
        targetVariant.checked = true;
        targetVariant.dispatchEvent(new Event('change', { bubbles: true }));
    }
}

document.querySelectorAll('.variant-size-radio, .variant-lighting-radio').forEach(radio => {
    radio.addEventListener('change', syncStructuredVariantSelection);
});
syncStructuredVariantSelection();

function increaseQuantity() {
    const input = document.getElementById('productQuantity');
    const selectedInput = document.getElementById('selectedQuantity');
    if (!input) return;
    
    let max = parseInt(input.getAttribute('max')) || 99;
    let val = parseInt(input.value) || 1;
    if (val < max) {
        input.value = val + 1;
        if (selectedInput) selectedInput.value = val + 1;
        updateSelectionSummary();
    }
}

function decreaseQuantity() {
    const input = document.getElementById('productQuantity');
    const selectedInput = document.getElementById('selectedQuantity');
    if (!input) return;
    
    let min = parseInt(input.getAttribute('min')) || 1;
    let val = parseInt(input.value) || 1;
    if (val > min) {
        input.value = val - 1;
        if (selectedInput) selectedInput.value = val - 1;
        updateSelectionSummary();
    }
}

const ajaxSepetBtn = document.getElementById('ajaxSepetBtn');
if (ajaxSepetBtn) {
    ajaxSepetBtn.addEventListener('click', async function (e) {
        e.preventDefault();
        const form = document.getElementById('addToCartForm');
        const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        const frameSelectionBlock = document.getElementById('frameSelectionBlock');
        const selectedFrame = document.querySelector('input[name="CerceveModeli"]:checked');

        if (frameSelectionBlock && !selectedFrame) {
            const frameSelectionError = document.getElementById('frameSelectionError');
            if (frameSelectionError) frameSelectionError.classList.remove('hidden');
            frameSelectionBlock.classList.add('ring-2', 'ring-red-400', 'ring-offset-2');
            frameSelectionBlock.scrollIntoView({ behavior: 'smooth', block: 'center' });

            if (window.showToast) {
                window.showToast('Çerçeve rengi seçilmelidir.', 'error');
            } else {
                alert('Çerçeve rengi seçilmelidir.');
            }

            return;
        }
        
        const url = '/Sepet/Ekle';
        const urunId = form.querySelector('input[name="UrunId"]')?.value;
        const adet = form.querySelector('input[name="Adet"]')?.value;
        const secenekId = document.getElementById('selectedVariantId')?.value;
        const cerceveModeli = selectedFrame?.value;
        const cerceveFarki = document.getElementById('selectedFrameFarki')?.value;
        
        const params = new URLSearchParams();
        params.append('UrunId', urunId);
        params.append('Adet', adet || '1');
        if (secenekId) params.append('SecenekId', secenekId);
        if (cerceveModeli) params.append('CerceveModeli', cerceveModeli);
        if (cerceveFarki && cerceveFarki !== '0') params.append('CerceveFarki', cerceveFarki);
        
        const originalHtml = this.innerHTML;
        this.innerHTML = '<i class="fas fa-check"></i> Eklendi!';
        this.disabled = true;

        fetch(url + '?' + params.toString(), {
            method: 'POST',
            headers: {
                'RequestVerificationToken': token
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                const btn = this;
                const icon = btn.querySelector('.add-to-cart-icon');
                const text = btn.querySelector('.add-to-cart-text');
                
                if (icon) {
                    icon.classList.remove('fa-shopping-bag');
                    icon.classList.add('fa-check');
                }
                if (text) {
                    text.textContent = 'Eklendi!';
                }
                btn.classList.add('bg-green-600');

                // Update cart counter with bounce
                const cartCounter = document.getElementById('cartItemCount');
                const cartCounterMobile = document.getElementById('cartItemCountMobile');
                const cartCounters = [cartCounter, cartCounterMobile].filter(el => el);
                
                cartCounters.forEach(counter => {
                    let current = parseInt(counter.innerText) || 0;
                    let added = parseInt(adet) || 1;
                    counter.innerText = current + added;
                    counter.classList.add('scale-150', 'bounce-animation');
                    setTimeout(() => {
                        counter.classList.remove('scale-150', 'bounce-animation');
                        counter.classList.add('scale-125');
                        setTimeout(() => counter.classList.remove('scale-125'), 150);
                    }, 300);
                });

                if (window.showToast) {
                    window.showToast('Ürün başarıyla sepetinize eklendi.', 'success');
                }
                
                // 1 saniye sonra butonu sıfırla (tekrar tıklanabilir olsun)
                setTimeout(() => {
                    if (icon) {
                        icon.classList.remove('fa-check');
                        icon.classList.add('fa-shopping-bag');
                    }
                    if (text) text.textContent = 'Sepete Ekle';
                    btn.classList.remove('bg-green-600');
                    btn.disabled = false;
                }, 1000);
                
                // (Otomatik yönlendirme kaldırıldı - kullanıcı talebi)
            } else {
                if (window.showToast) {
                    window.showToast(data.message || 'Hata oluştu', 'error');
                } else {
                    alert(data.message || 'Hata oluştu');
                }
                this.innerHTML = originalHtml;
                this.disabled = false;
            }
        })
        .catch(error => {
            console.error(error);
            if (window.showToast) {
                window.showToast('Bağlantı hatası oluştu.', 'error');
            } else {
                alert('Bağlantı hatası');
            }
            this.innerHTML = originalHtml;
            this.disabled = false;
        });
    });
}

function navigateGallery(direction, event) {
    if (event) event.stopPropagation();
    
    const thumbnails = Array.from(document.querySelectorAll('.thumbnail-item'));
    if (thumbnails.length <= 1) return;
    
    const mainImage = document.getElementById('mainProductImage');
    const currentSrc = mainImage.getAttribute('src');
    
    let currentIndex = thumbnails.findIndex(item => item.getAttribute('data-image') === currentSrc);
    if (currentIndex === -1) currentIndex = 0;
    
    let nextIndex;
    if (direction === 'next') {
        nextIndex = (currentIndex + 1) % thumbnails.length;
    } else {
        nextIndex = (currentIndex - 1 + thumbnails.length) % thumbnails.length;
    }
    
    const nextThumb = thumbnails[nextIndex];
    if (nextThumb) {
        nextThumb.click();
    }
}

function copyProductLink(button) {
    const url = button?.getAttribute('data-url') || window.location.href;
    const originalHtml = button.innerHTML;

    const markCopied = () => {
        button.innerHTML = '<i class="fas fa-check text-xs"></i> Kopyalandı';
        setTimeout(() => {
            button.innerHTML = originalHtml;
        }, 1800);
    };

    if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(url).then(markCopied).catch(() => {
            window.prompt('Ürün bağlantısı', url);
        });
        return;
    }

    window.prompt('Ürün bağlantısı', url);
}

function selectFrameOption(label, value) {
    const radios = document.querySelectorAll('input[name="CerceveModeli"]');
    radios.forEach(r => r.checked = false);
    const radio = label.querySelector('input[name="CerceveModeli"]');
    if (radio) {
        radio.checked = true;
        radio.dispatchEvent(new Event('change', { bubbles: true }));
    }
}

// Masaüstü fare koordinatlarına göre pürüzsüz zoom (transform-origin)
document.addEventListener("DOMContentLoaded", function () {
    const container = document.getElementById('mainProductImageContainer');
    const img = document.getElementById('mainProductImage');
    
    if (container && img) {
        container.addEventListener('mousemove', function (e) {
            const rect = container.getBoundingClientRect();
            const x = ((e.clientX - rect.left) / rect.width) * 100;
            const y = ((e.clientY - rect.top) / rect.height) * 100;
            img.style.transformOrigin = x + '% ' + y + '%';
        });
        container.addEventListener('mouseleave', function () {
            img.style.transformOrigin = 'center center';
        });
    }
});
</script>
