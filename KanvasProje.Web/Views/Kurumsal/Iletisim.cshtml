@{
    ViewData["Title"] = "İletişim";
}

<!-- Breadcrumb -->
<div class="bg-slate-50 border-b border-slate-200 py-3">
    <div class="container mx-auto px-4 flex items-center gap-2 text-xs text-slate-500">
        <a href="/" class="hover:text-[#00A4D3] transition-colors">Ana Sayfa</a>
        <span>/</span>
        <span class="text-slate-800 font-semibold">İletişim</span>
    </div>
</div>

<div class="container mx-auto px-4 py-16 max-w-5xl">
    <div class="text-center mb-12">
        <h1 class="font-heading text-3xl md:text-5xl font-extrabold text-slate-900 mb-3">İletişim</h1>
        <p class="text-sm text-slate-600 max-w-md mx-auto">Sorularınız, talepleriniz ve özel projeleriniz için bize ulaşın. En kısa sürede yanıt vereceğiz.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-10">
        <!-- İletişim Bilgileri -->
        <div class="lg:col-span-2 space-y-6">
            <div class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-slate-200/80 shadow-sm">
                <div class="w-11 h-11 rounded-xl bg-sky-50 text-[#00A4D3] flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-phone text-base"></i>
                </div>
                <div>
                    <h4 class="font-semibold text-slate-900 text-sm mb-1">Telefon</h4>
                    <p class="text-sm text-slate-600">@ViewBag.Telefon</p>
                </div>
            </div>
            <div class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-slate-200/80 shadow-sm">
                <div class="w-11 h-11 rounded-xl bg-sky-50 text-[#00A4D3] flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-envelope text-base"></i>
                </div>
                <div>
                    <h4 class="font-semibold text-slate-900 text-sm mb-1">E-posta</h4>
                    <p class="text-sm text-slate-600">@ViewBag.Eposta</p>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(ViewBag.Adres))
            {
                <div class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-slate-200/80 shadow-sm">
                    <div class="w-11 h-11 rounded-xl bg-sky-50 text-[#00A4D3] flex items-center justify-center flex-shrink-0">
                        <i class="fas fa-location-dot text-base"></i>
                    </div>
                    <div>
                        <h4 class="font-semibold text-slate-900 text-sm mb-1">Adres</h4>
                        <p class="text-sm text-slate-600">@ViewBag.Adres</p>
                    </div>
                </div>
            }
            <div class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-slate-200/80 shadow-sm">
                <div class="w-11 h-11 rounded-xl bg-sky-50 text-[#00A4D3] flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-clock text-base"></i>
                </div>
                <div>
                    <h4 class="font-semibold text-slate-900 text-sm mb-1">Çalışma Saatleri</h4>
                    <p class="text-sm text-slate-600">@ViewBag.CalismaSaatleri</p>
                </div>
            </div>
        </div>

        <!-- İletişim Formu -->
        <div class="lg:col-span-3 bg-white border border-slate-200/80 rounded-2xl p-6 sm:p-8 shadow-sm">
            @if (TempData["Basari"] != null)
            {
                <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm px-4 py-3 rounded-xl mb-6 flex items-center gap-2">
                    <i class="fas fa-check-circle"></i>
                    @TempData["Basari"]
                </div>
            }
            @if (TempData["Hata"] != null)
            {
                <div class="bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded-xl mb-6 flex items-center gap-2">
                    <i class="fas fa-circle-exclamation"></i>
                    @TempData["Hata"]
                </div>
            }

            <form id="contactForm" asp-action="IletisimGonder" asp-controller="Kurumsal" method="post" class="space-y-5">
                @Html.AntiForgeryToken()
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 tracking-wider mb-2 uppercase">Ad Soyad</label>
                        <input name="AdSoyad" type="text" required placeholder="Adınız Soyadınız"
                               class="w-full border border-slate-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-[#00A4D3] focus:border-[#00A4D3] outline-none bg-white transition-all text-slate-800" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 tracking-wider mb-2 uppercase">E-posta</label>
                        <input name="Email" type="email" required placeholder="ornek@mail.com"
                               class="w-full border border-slate-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-[#00A4D3] focus:border-[#00A4D3] outline-none bg-white transition-all text-slate-800" />
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 tracking-wider mb-2 uppercase">Konu</label>
                    <input name="Konu" type="text" required placeholder="Mesajınızın konusu"
                           class="w-full border border-slate-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-[#00A4D3] focus:border-[#00A4D3] outline-none bg-white transition-all text-slate-800" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 tracking-wider mb-2 uppercase">Mesaj</label>
                    <textarea name="Mesaj" rows="5" required placeholder="Mesajınızı yazın..."
                              class="w-full border border-slate-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-[#00A4D3] focus:border-[#00A4D3] outline-none resize-none bg-white transition-all text-slate-800"></textarea>
                </div>
                <button type="submit" id="contactSubmitBtn"
                        class="w-full bg-[#00A4D3] text-white py-3.5 text-xs font-bold tracking-wider uppercase rounded-xl hover:bg-[#0284C7] transition-all shadow-md shadow-sky-500/20 flex items-center justify-center gap-2">
                    <i class="fas fa-paper-plane"></i> Mesajı Gönder
                </button>
            </form>

            <script>
                document.addEventListener('DOMContentLoaded', function() {
                    const form = document.getElementById('contactForm');
                    if (form) {
                        form.addEventListener('submit', function(e) {
                            e.preventDefault();
                            
                            const btn = document.getElementById('contactSubmitBtn');
                            const originalContent = btn.innerHTML;
                            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Gönderiliyor...';
                            btn.disabled = true;

                            const formData = new FormData(form);
                            
                            fetch(form.action, {
                                method: 'POST',
                                body: formData
                            })
                            .then(response => response.json())
                            .then(data => {
                                if (data.success) {
                                    if (window.showToast) {
                                        window.showToast(data.message || 'Mesajınız başarıyla iletildi.', 'success');
                                    }
                                    form.reset();
                                } else {
                                    if (window.showToast) {
                                        window.showToast(data.message || 'Bir hata oluştu.', 'error');
                                    }
                                }
                            })
                            .catch(error => {
                                console.error('Error:', error);
                                if (window.showToast) {
                                    window.showToast('Bağlantı hatası oluştu. Lütfen tekrar deneyin.', 'error');
                                }
                            })
                            .finally(() => {
                                btn.innerHTML = originalContent;
                                btn.disabled = false;
                            });
                        });
                    }
                });
            </script>
        </div>
    </div>
</div>
