@model KanvasProje.Core.Varliklar.KurumsalSayfa
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mx-auto px-4 py-12 max-w-4xl">
    <h1 class="font-heading text-3xl md:text-4xl font-extrabold text-slate-900 mb-6 text-center border-b border-slate-200 pb-4">@Model.Baslik</h1>
    <div class="bg-white border border-slate-200/80 rounded-2xl p-6 sm:p-10 shadow-sm prose prose-slate max-w-none leading-relaxed">
        @Html.Raw(KanvasProje.Core.Helpers.HtmlSanitizerHelper.Sanitize(Model.Icerik))
    </div>
</div>