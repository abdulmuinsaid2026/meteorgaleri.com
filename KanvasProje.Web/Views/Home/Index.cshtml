@* Dynamic Homepage Sections *@
@if (Model.Sections != null && Model.Sections.Any())
{
    foreach (var homeSection in Model.Sections)
    {
        // -------------------------------------------------------------
        // 1. MANUEL ÜRÜN BLOĞU
        // -------------------------------------------------------------
        if (homeSection.SectionType == HomePageSectionType.ProductBlock)
        {
            var sectionProducts = (homeSection.SectionProducts?
                .OrderBy(sp => sp.SortOrder)
                .Select(sp => sp.Urun)
                .Where(u => u != null && u.AktifMi && !u.SilindiMi)
                .ToList()) ?? new List<Urun>();

            if (sectionProducts.Any())
            {
                <section class="bg-[#F8FAFC] py-14 md:py-16" data-motion-section>
                    <div class="container mx-auto px-4">
                        <div class="mb-10 flex flex-col gap-3 md:flex-row md:items-end md:justify-between pb-4 border-b border-slate-200">
                            <div>
                                <h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-900 tracking-tight leading-tight">
                                    @(string.IsNullOrWhiteSpace(homeSection.Title) ? "Öne Çıkan Ürünler" : homeSection.Title)
                                </h2>
                                @if (!string.IsNullOrWhiteSpace(homeSection.Subtitle))
                                {
                                    <p class="mt-2 max-w-2xl text-xs sm:text-sm text-slate-500 font-normal leading-relaxed">@(homeSection.Subtitle)</p>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(homeSection.ViewAllUrl))
                            {
                                <a href="@(homeSection.ViewAllUrl)" class="inline-flex items-center gap-2 self-start md:self-auto px-5 py-2.5 rounded-full border border-slate-200 bg-white hover:bg-[#00A4D3] hover:text-white hover:border-[#00A4D3] text-xs font-bold tracking-wider uppercase text-slate-800 transition-all shadow-2xs group">
                                    <span>@(string.IsNullOrWhiteSpace(homeSection.ViewAllText) ? "Tümünü Gör" : homeSection.ViewAllText)</span>
                                    <i class="fas fa-arrow-right text-[10px] group-hover:translate-x-1 transition-transform"></i>
                                </a>
                            }
                        </div>
                        <div class="grid grid-cols-2 gap-4 sm:gap-6 md:grid-cols-4 lg:grid-cols-5" data-motion-stagger>
                            @foreach (var urun in sectionProducts.Take(15))
                            {
                                <partial name="_UrunKarti" model="urun" />
                            }
                        </div>
                    </div>
                </section>
            }
        }
        // -------------------------------------------------------------
        // 2. ÖZEL BANNER
        // -------------------------------------------------------------
        else if (homeSection.SectionType == HomePageSectionType.CustomBanner && !string.IsNullOrWhiteSpace(homeSection.ImageUrl))
        {
            <section class="py-8" data-motion-section>
                <div class="container mx-auto px-4">
                    <a href="@(string.IsNullOrWhiteSpace(homeSection.ButtonUrl) ? "#" : homeSection.ButtonUrl)" class="block relative group overflow-hidden rounded-2xl">
                        <img src="@(homeSection.ImageUrl)" alt="@(homeSection.Title)" class="w-full h-auto transition-transform duration-700 group-hover:scale-105" loading="lazy" decoding="async" />
                        @if (!string.IsNullOrWhiteSpace(homeSection.Title) || !string.IsNullOrWhiteSpace(homeSection.Subtitle))
                        {
                            <div class="absolute inset-0 bg-black/35 flex flex-col justify-center items-center text-center p-4">
                                <h3 class="text-white font-serif text-3xl md:text-5xl font-bold mb-2 drop-shadow-md">@homeSection.Title</h3>
                                <p class="text-white/90 text-sm md:base drop-shadow-md">@homeSection.Subtitle</p>
                            </div>
                        }
                    </a>
                </div>
            </section>
        }
        // -------------------------------------------------------------
        // 3. AUTO: 5 PARÇALI KOLEKSİYON
        // -------------------------------------------------------------
        else if (homeSection.SectionType == HomePageSectionType.AutoBesParcali && Model.BesParcaliKoleksiyon != null && Model.BesParcaliKoleksiyon.Any())
        {
            <section class="bg-[#F8FAFC] py-14 md:py-16">
                <div class="container mx-auto px-4">
                    <div class="mb-10 flex flex-col gap-3 md:flex-row md:items-end md:justify-between pb-4 border-b border-slate-200">
                        <div>
                            <div class="inline-flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.24em] text-[#00A4D3] mb-2">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#00A4D3]"></span>
                                ✦ BÜYÜK BOY DUVAR TABLOLARI
                            </div>
                            <h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-900 tracking-tight leading-tight">
                                @(string.IsNullOrWhiteSpace(homeSection.Title) ? "5 Parçalı Duvar Tabloları (Büyük Boy)" : homeSection.Title)
                            </h2>
                            <p class="mt-2 max-w-2xl text-xs sm:text-sm text-slate-500 font-normal leading-relaxed">
                                @(string.IsNullOrWhiteSpace(homeSection.Subtitle) ? "Geniş duvarlara derinlik ve şıklık katan 5 parçalı kanvas tablolar." : homeSection.Subtitle)
                            </p>
                        </div>
                        <a href="@(string.IsNullOrWhiteSpace(homeSection.ViewAllUrl) ? "/Urun?s=5%20Par%C3%A7a" : homeSection.ViewAllUrl)" class="inline-flex items-center gap-2 self-start md:self-auto px-5 py-2.5 rounded-full border border-slate-200 bg-white hover:bg-[#00A4D3] hover:text-white hover:border-[#00A4D3] text-xs font-bold tracking-wider uppercase text-slate-800 transition-all shadow-2xs group">
                            <span>@(string.IsNullOrWhiteSpace(homeSection.ViewAllText) ? "Tümünü İncele" : homeSection.ViewAllText)</span>
                            <i class="fas fa-arrow-right text-[10px] group-hover:translate-x-1 transition-transform"></i>
                        </a>
                    </div>
                    <div class="grid grid-cols-2 gap-4 sm:gap-6 md:grid-cols-4 lg:grid-cols-5">
                        @foreach (var urun in Model.BesParcaliKoleksiyon.Take(15))
                        {
                            <partial name="_UrunKarti" model="urun" />
                        }
                    </div>
                </div>
            </section>
        }
        // -------------------------------------------------------------
        // 4. AUTO: VİTRİN / SİZİN İÇİN SEÇTİKLERİMİZ
        // -------------------------------------------------------------
        else if (homeSection.SectionType == HomePageSectionType.AutoVitrin && Model.VitrinUrunleri != null && Model.VitrinUrunleri.Any())
        {
            <section class="py-16 bg-white border-y border-slate-200">
                <div class="container mx-auto px-4">
                    <div class="text-center max-w-3xl mx-auto mb-12">
                        <div class="inline-flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.26em] text-[#00A4D3] mb-3">
                            <span class="w-1.5 h-1.5 rounded-full bg-[#00A4D3]"></span>
                            SİZİN İÇİN SEÇTİKLERİMİZ
                            <span class="w-1.5 h-1.5 rounded-full bg-[#00A4D3]"></span>
                        </div>
                        <h2 class="font-serif text-3xl sm:text-4xl text-slate-900 tracking-tight font-bold leading-tight mb-3">
                            @(string.IsNullOrWhiteSpace(homeSection.Title) ? "Sizin İçin Seçtiklerimiz" : homeSection.Title)
                        </h2>
                        <div class="w-16 h-0.5 bg-gradient-to-r from-transparent via-[#00A4D3] to-transparent mx-auto mb-3"></div>
                        <p class="text-xs sm:text-sm text-slate-500 font-normal max-w-xl mx-auto leading-relaxed">
                            @(string.IsNullOrWhiteSpace(homeSection.Subtitle) ? "Mekanınıza şıklık katacak en çok beğenilen ve öne çıkan tablolar." : homeSection.Subtitle)
                        </p>
                    </div>
                    <div class="grid grid-cols-2 gap-4 sm:gap-6 md:grid-cols-4 lg:grid-cols-5">
                        @foreach (var urun in Model.VitrinUrunleri.Take(10))
                        {
                            <partial name="_UrunKarti" model="urun" />
                        }
                    </div>
                    <div class="text-center mt-12">
                        <a href="@(string.IsNullOrWhiteSpace(homeSection.ViewAllUrl) ? "/Urun" : homeSection.ViewAllUrl)" class="inline-flex items-center gap-2 border border-[#00A4D3] text-[#00A4D3] px-8 py-3 text-xs tracking-widest hover:bg-[#00A4D3] hover:text-white transition-all uppercase rounded-full font-bold shadow-xs">
                            <span>@(string.IsNullOrWhiteSpace(homeSection.ViewAllText) ? "Tümünü Keşfet" : homeSection.ViewAllText)</span>
                            <i class="fas fa-arrow-right text-[10px]"></i>
                        </a>
                    </div>
                </div>
            </section>
        }
        // -------------------------------------------------------------
        // 5. AUTO: ÇOK SATANLAR
        // -------------------------------------------------------------
        else if (homeSection.SectionType == HomePageSectionType.AutoCokSatanlar && Model.CokSatanlar != null && Model.CokSatanlar.Any())
        {
            <section class="container mx-auto px-4 py-14 md:py-16">
                <div class="mb-10 flex flex-col gap-3 md:flex-row md:items-end md:justify-between pb-4 border-b border-slate-200">
                    <div>
                        <div class="inline-flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.24em] text-[#00A4D3] mb-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-[#00A4D3]"></span>
                            ✦ EN ÇOK TERCİH EDİLENLER
                        </div>
                        <h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-900 tracking-tight leading-tight">
                            @(string.IsNullOrWhiteSpace(homeSection.Title) ? "En Çok Satan Tablolar" : homeSection.Title)
                        </h2>
                        <p class="mt-2 max-w-2xl text-xs sm:text-sm text-slate-500 font-normal leading-relaxed">
                            @(string.IsNullOrWhiteSpace(homeSection.Subtitle) ? "Müşterilerimizin en çok beğendiği ve en yüksek puanlı tablolar." : homeSection.Subtitle)
                        </p>
                    </div>
                    <a href="@(string.IsNullOrWhiteSpace(homeSection.ViewAllUrl) ? "/Urun?sort=popularity" : homeSection.ViewAllUrl)" class="inline-flex items-center gap-2 self-start md:self-auto px-5 py-2.5 rounded-full border border-slate-200 bg-white hover:bg-[#00A4D3] hover:text-white hover:border-[#00A4D3] text-xs font-bold tracking-wider uppercase text-slate-800 transition-all shadow-2xs group">
                        <span>@(string.IsNullOrWhiteSpace(homeSection.ViewAllText) ? "Tümünü İncele" : homeSection.ViewAllText)</span>
                        <i class="fas fa-arrow-right text-[10px] group-hover:translate-x-1 transition-transform"></i>
                    </a>
                </div>
                <div class="grid grid-cols-2 gap-4 sm:gap-6 md:grid-cols-4 lg:grid-cols-4">
                    @foreach (var urun in Model.CokSatanlar.Take(8))
                    {
                        <partial name="_UrunKarti" model="urun" />
                    }
                </div>
            </section>
        }
        // -------------------------------------------------------------
        // 6. AUTO: FIRSAT ÜRÜNLERİ
        // -------------------------------------------------------------
        else if (homeSection.SectionType == HomePageSectionType.AutoFirsatUrunleri && Model.FirsatUrunleri != null && Model.FirsatUrunleri.Any())
        {
            <section class="bg-[#F8FAFC] py-14 md:py-16 border-y border-slate-200">
                <div class="container mx-auto px-4">
                    <div class="mb-10 flex flex-col gap-3 md:flex-row md:items-end md:justify-between pb-4 border-b border-slate-200">
                        <div>
                            <div class="inline-flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.24em] text-[#E30613] mb-2">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#E30613]"></span>
                                ✦ HAFTANIN İNDİRİMLERİ
                            </div>
                            <h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-900 tracking-tight leading-tight">
                                @(string.IsNullOrWhiteSpace(homeSection.Title) ? "İndirimli Fırsat Tabloları" : homeSection.Title)
                            </h2>
                            <p class="mt-2 max-w-2xl text-xs sm:text-sm text-slate-500 font-normal leading-relaxed">
                                @(string.IsNullOrWhiteSpace(homeSection.Subtitle) ? "Sınırlı süreye özel avantajlı fiyatlara sahip seçili ürünler." : homeSection.Subtitle)
                            </p>
                        </div>
                        <a href="@(string.IsNullOrWhiteSpace(homeSection.ViewAllUrl) ? "/Urun?sort=price_asc" : homeSection.ViewAllUrl)" class="inline-flex items-center gap-2 self-start md:self-auto px-5 py-2.5 rounded-full border border-slate-200 bg-white hover:bg-[#E30613] hover:text-white hover:border-[#E30613] text-xs font-bold tracking-wider uppercase text-slate-800 transition-all shadow-2xs group">
                            <span>@(string.IsNullOrWhiteSpace(homeSection.ViewAllText) ? "Tüm Fırsatları Gör" : homeSection.ViewAllText)</span>
                            <i class="fas fa-arrow-right text-[10px] group-hover:translate-x-1 transition-transform"></i>
                        </a>
                    </div>
                    <div class="grid grid-cols-2 gap-4 sm:gap-6 md:grid-cols-4 lg:grid-cols-4">
                        @foreach (var urun in Model.FirsatUrunleri.Take(8))
                        {
                            <partial name="_UrunKarti" model="urun" />
                        }
                    </div>
                </div>
            </section>
        }
    }
}

