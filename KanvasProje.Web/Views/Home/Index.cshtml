<section class="bg-white py-20">
    <div class="container mx-auto px-4">
        <div class="mb-12 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
            <div class="max-w-2xl">
                <p class="mb-3 text-xs uppercase tracking-[0.25em] text-[#00A4D3] font-bold">ÜRETİMDEN TESLİMATA</p>
                <h2 class="font-serif text-3xl text-slate-900 md:text-4xl font-bold">Siparişiniz Özenle Hazırlanır</h2>
            </div>
            <p class="max-w-md text-sm leading-relaxed text-slate-500">
                @brandName, dekorasyon ürünlerini siparişinize özel yüksek kalite standartlarıyla üretir; baskı, çerçeveleme ve paketleme titizlikle denetlenir.
            </p>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-5">
            @{
                var productionSteps = new[]
                {
                    ("01", "Tasarım hazırlanır", "Görsel ve ürün bilgisi yüksek çözünürlükte baskıya hazırlanır."),
                    ("02", "Canlı baskı alınır", "Solmayan pigment mürekkepler ile orijinal renkler korunur."),
                    ("03", "Ürün üretilir", "Seçtiğiniz ölçü ve çerçeveye göre atölyemizde ustalıkla üretilir."),
                    ("04", "Özenle paketlenir", "Kargoda hasar görmemesi için darbe emici özel kutular kullanılır."),
                    ("05", "Kargoya verilir", "Takip numarasıyla birlikte güvenle adresinize sevk edilir.")
                };
            }
            @foreach (var step in productionSteps)
            {
                <div class="border-t-2 border-[#00A4D3] pt-5">
                    <span class="mb-5 inline-flex h-9 w-9 items-center justify-center rounded-full bg-[#00A4D3] text-xs font-bold text-white shadow-sm">@step.Item1</span>
                    <h3 class="mb-2 font-serif text-lg font-bold text-slate-900">@step.Item2</h3>
                    <p class="text-sm leading-relaxed text-slate-500">@step.Item3</p>
                </div>
            }
        </div>
    </div>
</section>

<section class="bg-[#F8FAFC] py-20 border-t border-slate-200">
    <div class="container mx-auto grid grid-cols-1 items-center gap-12 px-4 lg:grid-cols-2">
