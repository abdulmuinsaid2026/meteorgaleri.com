                </div>
                <div class="p-4 bg-white rounded-xl border border-slate-200 shadow-xs">
                    <i class="fas fa-ruler-combined mb-3 text-2xl text-[#00A4D3]"></i>
                    <p class="text-xs font-bold uppercase tracking-wider text-slate-900">Zengin Ölçüler</p>
                </div>
                <div class="p-4 bg-white rounded-xl border border-slate-200 shadow-xs">
                    <i class="fas fa-box-open mb-3 text-2xl text-[#00A4D3]"></i>
                    <p class="text-xs font-bold uppercase tracking-wider text-slate-900">Sağlam Paket</p>
